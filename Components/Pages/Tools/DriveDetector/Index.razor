@page "/tools/drivedetector"
@using Hypen.Web.Models
@using Hypen.Web.Services

<PageTitle>GDrive Storage Sync - Hypen Tools</PageTitle>

<div>
    <!-- ALERT STATUS -->
    @if (!string.IsNullOrEmpty(statusMsg))
    {
        <div>
            <p>@statusMsg</p>
        </div>
    }

    <!-- HEADER -->
    <div>
        <div>
            <div>System Maintenance</div>
            <h1>Google Drive Track Sync Engine</h1>
        </div>
        <div>
            @gdriveTracks.Count FILES TERDATA
        </div>
    </div>

    <!-- TOOLBAR -->
    <div>
        <div>
            <button @onclick="LoadDriveTracks" disabled="@isProcessing">
                @(isProcessing ? "SYNCING STORAGE..." : "REFRESH GDRIVE INDEX")
            </button>

            @if (UnlinkedCount > 0)
            {
                <button @onclick="AutoLinkTracks" disabled="@isProcessing">
                    🔗 AUTO-LINK TO MASTER SONGS (@UnlinkedCount)
                </button>
            }
        </div>

        <div>
            <span>LINKED: @LinkedCount</span>
            <span>UNLINKED: @UnlinkedCount</span>
        </div>
    </div>

    <!-- CONTENT DISPLAY -->
    @if (isProcessing && gdriveTracks.Count == 0)
    {
        <div>
            <div>Storage Indexing</div>
            <h3>Memuat Indeks Google Drive Tracks...</h3>
            <p>Membaca rekaman file audio dari tabel gdrive_tracks.</p>
        </div>
    }
    else if (!isProcessing && gdriveTracks.Count == 0)
    {
        <div>
            <div>Indeks Kosong</div>
            <h3>Belum Ada File MP3 Terindeks di Google Drive</h3>
            <p>
                Klik <strong>REFRESH GDRIVE INDEX</strong> untuk memperbarui data indeks dari tabel storage.
            </p>
        </div>
    }
    else
    {
        <div>
            <div>
                <span>DATABASE GDRIVE TRACKS (@gdriveTracks.Count:N0)</span>
                <span>@UnlinkedCount FILE BELUM TERHUBUNG</span>
            </div>

            <div>
                <div>
                    @foreach (var track in gdriveTracks)
                    {
                        <div>
                            <div>
                                <span>
                                    @(track.IsLinkedToSong ? "LINKED TO SONG" : "UNLINKED")
                                </span>
                                <span>ID: #@track.Id</span>
                            </div>

                            <div>
                                <div>@(string.IsNullOrEmpty(track.Title) ? track.FileName : track.Title)</div>
                                <div>
                                    Artis: @(track.Artist ?? "Unknown Artist") • ID Drive: @track.FileId
                                </div>
                            </div>

                            <div>
                                <span>⏱️ @(TimeSpan.FromSeconds(track.DurationSeconds).ToString(@"mm\:ss"))</span>
                                <span>💾 @((track.FileSizeBytes / (1024.0 * 1024.0)).ToString("0.0")) MB</span>
                                @if (track.SongId.HasValue)
                                {
                                    <span>🎵 Song Ref: #@track.SongId</span>
                                }
                                else
                                {
                                    <span>⚠️ Ref: None</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>
