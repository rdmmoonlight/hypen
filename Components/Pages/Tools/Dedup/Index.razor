@page "/tools/dedup"
@using Hypen.Web.Models
@using Hypen.Web.Services

<PageTitle>Raw Songs Comparison - Hypen Tools</PageTitle>

<div class="matte-container">

    <!-- ALERT STATUS -->
    @if (!string.IsNullOrEmpty(statusMsg))
    {
        <div class="status-alert @(isError ? "alert-error" : "alert-info")">
            <p class="status-text">@statusMsg</p>
        </div>
    }

    <!-- HEADER -->
    <div class="matte-header">
        <div>
            <div class="matte-subtitle">System Maintenance // Dual-Table Access</div>
            <h1 class="matte-title">Raw Songs vs Database Checker</h1>
        </div>
        <div class="matte-counter">
            @rawSongComparisons.Count RAW SONGS
        </div>
    </div>

    <!-- TOOLBAR -->
    <div class="matte-toolbar">
        <div class="matte-action-group">
            <button class="btn-matte btn-primary" @onclick="ScanRawSongsAgainstDatabase" disabled="@isProcessing">
                <i class="ti ti-scan"></i> @(isProcessing ? "MEMINDAI DATA..." : "BANDINGKAN RAW SONGS DENGAN DATABASE")
            </button>

            @if (UnmatchedRawCount > 0)
            {
                <button class="btn-matte btn-success" @onclick="ImportUnmatchedToDatabase" disabled="@isProcessing">
                    <i class="ti ti-file-import"></i> IMPOR BARU KE DATABASE (@UnmatchedRawCount)
                </button>
            }
        </div>

        <div class="matte-search-group">
            <span class="status-badge">
                <i class="ti ti-database-check"></i> UNMATCHED: @UnmatchedRawCount | MATCHED: @MatchedRawCount
            </span>
        </div>
    </div>

    <!-- CONTENT DISPLAY -->
    @if (!hasScanned && !isProcessing)
    {
        <div class="matte-card text-center py-4">
            <div class="matte-tag">Dual-Table Engine</div>
            <h3 class="card-title">Mulai Pemindaian Raw Songs</h3>
            <p class="status-text text-muted">
                Klik tombol <strong>BANDINGKAN RAW SONGS DENGAN DATABASE</strong> di atas untuk mengecek keberadaan data awal terhadap tabel rujukan (Songs).
            </p>
        </div>
    }
    else if (isProcessing)
    {
        <div class="matte-card text-center py-4">
            <div class="matte-tag">Analyzing Tables</div>
            <h3 class="card-title">Membandingkan RawSongs &amp; Songs Database...</h3>
            <p class="status-text text-muted">
                Mencocokkan metadata lagu awal dengan data rujukan utama.
            </p>
        </div>
    }
    else if (hasScanned && rawSongComparisons.Count == 0)
    {
        <div class="matte-card text-center py-4 border-clean">
            <div class="matte-tag tag-clean">Raw Table Status // Empty</div>
            <h3 class="card-title text-clean">Tabel Raw Songs Kosong!</h3>
            <p class="status-text text-muted">
                Tidak ada data di tabel awal untuk dibandingkan.
            </p>
        </div>
    }
    else if (rawSongComparisons.Count > 0)
    {
        <div class="preview-container">
            <div class="preview-header">
                <span>TOTAL RAW SONGS (@rawSongComparisons.Count:N0)</span>
                <span class="dup-summary-tag">
                    @UnmatchedRawCount HASIL BELUM ADA DI DATABASE
                </span>
            </div>

            <div class="song-compact-grid">
                @foreach (var item in rawSongComparisons)
                {
                    <div class="song-compact-card @(!item.IsInDatabase ? "card-purge" : "card-keep")">

                        <div class="compact-card-header">
                            @if (!item.IsInDatabase)
                            {
                                <span class="badge-action badge-purge-btn">
                                    <i class="ti ti-alert-circle"></i> BELUM ADA DI DATABASE
                                </span>
                            }
                            else
                            {
                                <span class="badge-action badge-keep-btn">
                                    <i class="ti ti-circle-check"></i> SUDAH ADA DI DATABASE
                                </span>
                            }
                            <span class="song-id-tag">RAW #@item.RawSongId</span>
                        </div>

                        <div class="compact-card-body">
                            <div class="compact-song-title">@item.Title</div>
                            <div class="compact-song-artist">
                                @(item.Artist ?? "Unknown Artist") • @(item.Album ?? "Single")
                            </div>
                        </div>

                        <div class="compact-card-footer">
                            <span>
                                <i class="ti ti-database"></i> 
                                DB Ref ID: @(item.MatchedSongId.HasValue ? $"#{item.MatchedSongId.Value}" : "N/A")
                            </span>
                        </div>

                    </div>
                }
            </div>
        </div>
    }

</div>
