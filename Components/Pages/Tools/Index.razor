@page "/tools"

<PageTitle>Database Tools Center - Hypen Music</PageTitle>

<div class="matte-container">
    <!-- HEADER -->
    <div class="matte-header">
        <div>
            <div class="matte-subtitle">System Maintenance</div>
            <h1 class="matte-title">Database Tools Center</h1>
        </div>
    </div>

    <!-- GRID 3 KARTU NAVIGASI TOOLS -->
    <div class="tools-grid">
        <!-- CARD 1: DUPLICATE DETECTOR -->
        <a href="/tools/dedup" class="matte-card tool-card">
            <div class="tool-icon">
                <i class="ti ti-search"></i>
            </div>
            <div class="tool-info">
                <div class="matte-tag">Database Maintenance</div>
                <h3 class="card-title">Duplicate Detector</h3>
                <p class="status-text text-muted">
                    Memindai dan membersihkan lagu duplikat di database master secara otomatis.
                </p>
            </div>
        </a>

        <!-- CARD 2: LOCAL SYNC -->
        <a href="/tools/synclocal" class="matte-card tool-card">
            <div class="tool-icon">
                <i class="ti ti-folder-sync"></i>
            </div>
            <div class="tool-info">
                <div class="matte-tag">Local Storage</div>
                <h3 class="card-title">Local Sync Engine</h3>
                <p class="status-text text-muted">
                    Sinkronisasi indeks direktori lokal dan pemindaian file audio fisik.
                </p>
            </div>
        </a>

        <!-- CARD 3: GDRIVE MANAGEMENT -->
        <a href="/tools/driveDetector" class="matte-card tool-card">
            <div class="tool-icon">
                <i class="ti ti-brand-google-drive"></i>
            </div>
            <div class="tool-info">
                <div class="matte-tag">Cloud Integration</div>
                <h3 class="card-title">GDrive Management</h3>
                <p class="status-text text-muted">
                    Pengelolaan dan auto-link file audio terindeks dari Google Drive.
                </p>
            </div>
        </a>
    </div>
</div>
