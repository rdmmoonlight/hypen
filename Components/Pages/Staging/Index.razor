@page "/staging"
@namespace Hypen.Web.Components.Pages.Staging
@using Hypen.Web.Models
@using Hypen.Web.Data
@using Hypen.Web.Services
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbContextFactory

<PageTitle>Staging Buffer - Hypen Music Vault</PageTitle>

<div class="staging-container" style="color: #ffffff;">
    
    <!-- HEADER -->
    <div class="staging-header">
        <div>
            <div class="pipeline-tag">System Pipeline</div>
            <h1 class="staging-title" style="color: #ffffff;">Staging Buffer Review</h1>
        </div>
        <div class="nav-actions">
            <a href="/extraction" class="btn-nav">← EXTRACTION</a>
            <a href="/library" class="btn-nav">LIBRARY (@completedSongsCount)</a>
        </div>
    </div>

    <!-- STATUS ALERT -->
    @if (!string.IsNullOrEmpty(statusMsg))
    {
        <div class="status-alert @(isError ? "error" : "info")">
            <p>@statusMsg</p>
        </div>
    }

    <!-- STAGING REVIEW TOOLBAR -->
    <div class="staging-toolbar">
        <div>
            <div class="toolbar-info" style="color: #ffffff;">
                Buffer Pipeline (@pendingRawCount PENDING / INCOMPLETE) 
                @if (selectedRawIds.Count > 0)
                {
                    <span class="selected-badge">[ @selectedRawIds.Count TERPILIH ]</span>
                }
            </div>
            <div class="toolbar-subtext" style="color: #e0e0e0;">Review metadata & sinkronisasi data staging ke production library.</div>
        </div>

        <!-- SEARCH INPUT -->
        <div class="toolbar-search">
            <input type="text" 
                   class="search-input" 
                   placeholder="Cari Judul / Artis..." 
                   value="@SearchTerm" 
                   @oninput="@(e => SearchTerm = e.Value?.ToString() ?? "")"
                   style="color: #ffffff; background-color: #1e1e1e; border: 1px solid #444; padding: 6px 12px; border-radius: 4px;" />
        </div>

        <div class="toolbar-actions">
            @if (selectedRawIds.Count > 0)
            {
                <button class="btn-action commit-selected" @onclick="UploadSelectedToComplete" disabled="@isProcessing">
                    🚀 COMMIT SELECTED (@selectedRawIds.Count)
                </button>
                <button class="btn-action delete-selected" @onclick="DeleteSelectedRawItems" disabled="@isProcessing">
                    ✕ DELETE SELECTED (@selectedRawIds.Count)
                </button>
            }

            <button class="btn-action commit-all" @onclick="UploadAllToComplete" disabled="@(isProcessing || !StagingList.Any())">
                COMMIT ALL
            </button>
        </div>
    </div>

    @if (!FilteredStagingList.Any())
    {
        <div class="empty-state" style="color: #ffffff;">
            @(string.IsNullOrWhiteSpace(SearchTerm) ? "TIDAK ADA DATA PENDING / INCOMPLETE DI STAGING BUFFER." : "TIDAK ADA DATA YANG COCOK DENGAN PENCARIAN.")
        </div>
    }
    else
    {
        <div class="table-wrapper">
            <table class="staging-table" style="color: #ffffff;">
                <thead>
                    <tr>
                        <th class="col-checkbox">
                            <input type="checkbox" checked="@IsAllSelected" @onchange="ToggleSelectAll" class="custom-chk" />
                        </th>
                        <th class="col-title" style="color: #ffffff;">Judul</th>
                        <th class="col-artist" style="color: #ffffff;">Artis</th>
                        <th class="col-album" style="color: #ffffff;">Album</th>
                        <th class="col-year" style="color: #ffffff;">Tahun</th>
                        <th class="col-reg" style="color: #ffffff;">Reg</th>
                        <th class="col-duration" style="color: #ffffff;">Durasi</th>
                        <th class="col-cover" style="color: #ffffff;">Cover URL</th>
                        <th class="col-actions" style="color: #ffffff;">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in PagedStagingList)
                    {
                        var isSelected = selectedRawIds.Contains(row.Id);

                        <tr class="@(isSelected ? "selected-row" : "")" style="color: #ffffff;">
                            <td class="col-checkbox">
                                <input type="checkbox" checked="@isSelected" @onchange="@(e => ToggleSelect(row.Id, e))" class="custom-chk" />
                            </td>
                            <td>
                                <div class="cell-with-badge">
                                    <span class="text-cell font-weight-bold">@(string.IsNullOrWhiteSpace(row.Title) ? "-" : row.Title)</span>
                                </div>
                            </td>
                            <td>
                                <span class="text-cell">@(string.IsNullOrWhiteSpace(row.Artist) ? "-" : row.Artist)</span>
                            </td>
                            <td>
                                <span class="text-cell">@(string.IsNullOrWhiteSpace(row.Album) ? "Single" : row.Album)</span>
                            </td>
                            <td>
                                <span class="text-cell mono">@(row.ReleaseYear?.ToString() ?? "-")</span>
                            </td>
                            <td>
                                <span class="text-cell mono highlight-text">@(string.IsNullOrWhiteSpace(row.Country) ? "-" : row.Country)</span>
                            </td>
                            <td>
                                <span class="text-cell mono">@(row.DurationSeconds.HasValue && row.DurationSeconds > 0 ? $"{row.DurationSeconds}s" : "-")</span>
                            </td>
                            <td>
                                <span class="text-cell mono text-muted-url" title="@row.AlbumCoverUrl">
                                    @(string.IsNullOrWhiteSpace(row.AlbumCoverUrl) ? "-" : row.AlbumCoverUrl)
                                </span>
                            </td>
                            <td class="col-actions">
                                <button class="btn-icon commit" title="Commit to Library" @onclick="() => UploadSingleRawToComplete(row)" disabled="@isProcessing">🚀</button>
                                <button class="btn-icon delete" title="Hapus" @onclick="() => DeleteRawItem(row.Id)" disabled="@isProcessing">✕</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- PAGINATION BAR -->
        <div class="pagination-bar" style="color: #ffffff;">
            <div class="pagination-info">
                Menampilkan @StartItem - @EndItem dari @FilteredStagingList.Count() data
            </div>

            <div class="pagination-controls">
                <button class="btn-page" @onclick="GoToFirstPage" disabled="@(currentPage == 1)">«</button>
                <button class="btn-page" @onclick="GoToPreviousPage" disabled="@(currentPage == 1)">‹</button>

                @for (int i = StartPage; i <= EndPage; i++)
                {
                    var pageNum = i;
                    <button class="btn-page @(currentPage == pageNum ? "active" : "")" @onclick="() => GoToPage(pageNum)">
                        @pageNum
                    </button>
                }

                <button class="btn-page" @onclick="GoToNextPage" disabled="@(currentPage == TotalPages)">›</button>
                <button class="btn-page" @onclick="GoToLastPage" disabled="@(currentPage == TotalPages)">»</button>
            </div>

            <div class="pagination-size">
                <label style="color: #ffffff;">Per halaman:</label>
                <select value="@pageSize" @onchange="OnPageSizeChanged" class="select-page-size" style="color: #ffffff; background-color: #222;">
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </div>
        </div>
    }

</div>
