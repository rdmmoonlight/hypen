@page "/extraction"
@using Hypen.Web.Models
@using Hypen.Web.Services
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>Extraction Engine - Hypen Music Vault</PageTitle>

<div class="sync-container">
    <!-- HEADER -->
    <div class="sync-header">
        <div>
            <div class="subtitle">System Pipeline</div>
            <h1 class="title">Extraction Engine</h1>
        </div>
        <div class="nav-actions">
            <a href="/staging" class="btn-nav btn-staging">
                STAGING BUFFER (@pendingRawCount) →
            </a>
            <a href="/library" class="btn-nav btn-library">
                ← LIBRARY (@completedSongsCount)
            </a>
        </div>
    </div>

    <!-- STATUS ALERT -->
    @if (!string.IsNullOrEmpty(statusMsg))
    {
        <div class="status-alert @(isError ? "alert-error" : "alert-info")">
            <p class="status-text">@statusMsg</p>
        </div>
    }

    <!-- EKSTRAKSI / INGESTION CONTENT -->
    <div class="ingest-grid">
        <!-- INGESTION VIA YOUTUBE -->
        <div class="card-ingest">
            <div class="source-tag">Source // Remote</div>
            <h3 class="card-title">YouTube Stream Ingest</h3>

            <div class="form-group">
                <label class="form-label">Playlist / Video ID</label>
                <input type="text" @bind="targetPlaylistId" placeholder="URL atau Playlist ID..." class="form-control" />
            </div>

            <button class="btn-action" @onclick="FetchYouTubeToPreview" disabled="@isProcessing">
                @(isProcessing ? "PROCESSING..." : "FETCH TO PREVIEW QUEUE")
            </button>
        </div>

        <!-- INGESTION VIA LOCAL MP3 -->
        <div class="card-ingest">
            <div class="source-tag">Source // Local</div>
            <h3 class="card-title">Local Audio Ingest</h3>

            <div class="form-group">
                <label class="form-label">Select Audio Files (.mp3)</label>
                <InputFile OnChange="HandleFileSelection" multiple accept=".mp3" class="input-file" />
            </div>
        </div>
    </div>

    <!-- PREVIEW TABLE FILE (UNIFIED QUEUE) -->
    @if (extractedList.Count > 0)
    {
        <div class="preview-container">
            <div class="preview-header">
                <span>PARSED QUEUE PREVIEW (@extractedList.Count:N0)</span>
                <div class="header-right">
                    <span class="count-tag">@extractedList.Count(i => i.IsSelected && !i.IsDuplicateInDb):N0 READY TO COMMIT</span>
                    @if (extractedList.Any(i => i.IsDuplicateInDb))
                    {
                        <span class="dup-summary-tag">@extractedList.Count(i => i.IsDuplicateInDb):N0 IN DB</span>
                    }
                    <button class="btn-clear" @onclick="ClearPreview" disabled="@isProcessing">CLEAR QUEUE</button>
                </div>
            </div>

            <table class="preview-table">
                <thead>
                    <tr>
                        <th class="th-check">
                            <input type="checkbox" @onchange="ToggleSelectAll" checked="@isAllSelected" class="checkbox-input" />
                        </th>
                        <th>Status</th>
                        <th>Source / ID</th>
                        <th>Artist</th>
                        <th>Title</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in extractedList)
                    {
                        <tr class="@(item.IsDuplicateInDb ? "row-duplicate" : "")">
                            <td class="td-check">
                                <input type="checkbox" @bind="item.IsSelected" disabled="@item.IsDuplicateInDb" class="checkbox-input" />
                            </td>
                            <td class="td-status">
                                @if (item.IsDuplicateInDb)
                                {
                                    <span class="badge-dup" title="@item.DuplicateReason">EXISTS IN DB</span>
                                }
                                else
                                {
                                    <span class="badge-new">NEW</span>
                                }
                            </td>
                            <td class="file-name">@item.FileName</td>
                            <td>
                                <input type="text" @bind="item.CleanArtist" disabled="@item.IsDuplicateInDb" class="form-control table-input" />
                            </td>
                            <td>
                                <input type="text" @bind="item.CleanTitle" disabled="@item.IsDuplicateInDb" class="form-control table-input" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="preview-footer">
                <button class="btn-action btn-commit" @onclick="SaveSelectedToRaw" disabled="@(isProcessing || !extractedList.Any(i => i.IsSelected && !i.IsDuplicateInDb))">
                    @(isProcessing ? "SAVING..." : $"COMMIT {extractedList.Count(i => i.IsSelected && !i.IsDuplicateInDb):N0} NEW SONGS TO STAGING")
                </button>
            </div>
        </div>
    }
</div>

@code {
    // ==========================================
    // COUNTERS & STATES
    // ==========================================
    private int pendingRawCount = 0;
    private int completedSongsCount = 0;

    private string targetPlaylistId = string.Empty;
    private string statusMsg = string.Empty;
    private bool isError = false;
    private bool isProcessing = false;
    private bool isAllSelected = true;

    // ==========================================
    // QUEUE DATA
    // ==========================================
    private List<ParsedQueueItemModel> extractedList = new();

    // ==========================================
    // ACTION HANDLERS
    // ==========================================
    private async Task FetchYouTubeToPreview()
    {
        if (string.IsNullOrWhiteSpace(targetPlaylistId))
        {
            statusMsg = "Masukkan URL atau ID Playlist YouTube terlebih dahulu.";
            isError = true;
            return;
        }

        isProcessing = true;
        isError = false;
        statusMsg = "Memproses stream ingest YouTube...";

        // TODO: Panggil Service Ingest YouTube Anda di sini
        await Task.Delay(500);

        isProcessing = false;
        statusMsg = "Stream YouTube berhasil ditambahkan ke antrean preview.";
    }

    private async Task HandleFileSelection(InputFileChangeEventArgs e)
    {
        isProcessing = true;
        statusMsg = "Membaca file MP3 lokal...";
        isError = false;

        // TODO: Panggil Service Pemroses MP3 Lokal
        await Task.Delay(500);

        isProcessing = false;
        statusMsg = "File MP3 lokal berhasil dibaca.";
    }

    private void ClearPreview()
    {
        extractedList.Clear();
        statusMsg = "Antrean preview dibersihkan.";
    }

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        isAllSelected = e.Value is bool b && b;
        foreach (var item in extractedList.Where(i => !i.IsDuplicateInDb))
        {
            item.IsSelected = isAllSelected;
        }
    }

    private async Task SaveSelectedToRaw()
    {
        var itemsToCommit = extractedList.Where(i => i.IsSelected && !i.IsDuplicateInDb).ToList();
        if (!itemsToCommit.Any()) return;

        isProcessing = true;
        statusMsg = $"Menyimpan {itemsToCommit.Count} lagu baru ke Staging Buffer...";

        // TODO: Simpan data ke database / staging
        await Task.Delay(500);

        isProcessing = false;
        statusMsg = "Berhasil commit lagu baru ke Staging!";
    }

    // ==========================================
    // MODEL HELPER
    // ==========================================
    public class ParsedQueueItemModel
    {
        public bool IsSelected { get; set; } = true;
        public bool IsDuplicateInDb { get; set; } = false;
        public string? DuplicateReason { get; set; }
        public string FileName { get; set; } = string.Empty;
        public string CleanArtist { get; set; } = string.Empty;
        public string CleanTitle { get; set; } = string.Empty;
    }
}
