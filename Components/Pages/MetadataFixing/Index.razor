@page "/metadatafixing"
@namespace Hypen.Web.Components.Pages.MetadataFixing
@using Hypen.Web.Data
@using Hypen.Web.Models
@using Hypen.Web.Services
@using Microsoft.EntityFrameworkCore

<PageTitle>Advanced Tag Studio - Hypen Music Vault</PageTitle>

<script src="/js/metadata-save.js"></script>

<div class="sync-container">
    <!-- HEADER -->
    <div class="sync-header">
        <div>
            <div class="subtitle">Metadata & Tag Management</div>
            <h1 class="title">Advanced Tag Studio</h1>
        </div>
        <div class="nav-actions">
            <button class="btn-nav" @onclick="LoadDataFromDatabase" disabled="@isBatchProcessing">
                REFRESH DB
            </button>
            <button class="btn-nav btn-staging" @onclick="ProcessSmartMatchSelected" disabled="@(isBatchProcessing || !filteredItems.Any())">
                @if (isBatchProcessing)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                    <span>SEARCHING METADATA...</span>
                }
                else
                {
                    <span>FETCH CANDIDATES (@(SelectedCount > 0 ? SelectedCount : filteredItems.Count))</span>
                }
            </button>
            <button class="btn-nav btn-library" @onclick="ApplyBatchChangesAndSave" disabled="@(isBatchProcessing || !filteredItems.Any())">
                SAVE ALL (@(SelectedCount > 0 ? SelectedCount : filteredItems.Count))
            </button>
        </div>
    </div>

    <!-- STATUS JS -->
    <div id="js-save-status" class="status-alert alert-info" style="display:none;"></div>

    <!-- STATUS BLAZOR -->
    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="status-alert @(isError ? "alert-error" : "alert-info")">
            <p class="status-text m-0">@statusMessage</p>
        </div>
    }

    <!-- MAIN GRID LAYOUT -->
    <div class="ingest-grid two-columns" style="grid-template-columns: 2fr 1fr; align-items: start;">

        <!-- LEFT PANEL: SONG QUEUE TABLE -->
        <div class="card-ingest p-0 overflow-hidden">
            <!-- TOOLBAR -->
            <div class="p-3 border-bottom border-secondary border-opacity-25 d-flex align-items-center justify-content-between gap-2 flex-wrap">
                <div class="flex-grow-1" style="min-width: 220px;">
                    <div class="form-group m-0">
                        <input type="text"
                               class="form-control"
                               placeholder="Cari judul, artis, album, atau file..."
                               @bind="searchQuery"
                               @bind:event="oninput"
                               @bind:after="OnSearchQueryChanged" />
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <span class="subtitle m-0 text-nowrap">TAMPIL</span>
                    <select class="form-control py-1 px-2" style="width: auto;" @bind="pageSize" @bind:after="OnPageSizeChanged">
                        <option value="5">5</option>
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                    <span class="count-tag m-0 text-nowrap">/ @filteredCount</span>
                </div>
            </div>

            <!-- TABLE -->
            <div class="table-responsive">
                <table class="preview-table">
                    <thead>
                        <tr>
                            <th class="th-check">
                                <input type="checkbox" class="checkbox-input" @checked="isAllSelected" @onchange="ToggleSelectAll" />
                            </th>
                            <th style="width: 48px;">Cover</th>
                            <th>Metadata</th>
                            <th style="width: 70px;">Durasi</th>
                            <th style="width: 100px;">Status</th>
                            <th class="text-end" style="width: 110px;">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (pagedItems == null || !pagedItems.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-secondary">
                                    <span class="subtitle d-block mb-1">NO RECORDS FOUND</span>
                                    <small>Tidak ada data lagu ditemukan dalam database.</small>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in pagedItems)
                            {
                                <tr class="@(activeEditItem == item ? "row-duplicate" : "")" style="cursor: pointer;" @onclick="() => SelectForEditing(item)">
                                    <td class="td-check" @onclick:stopPropagation="true">
                                        <input type="checkbox"
                                               class="checkbox-input"
                                               checked="@item.IsSelected"
                                               @onchange="(e) => OnItemSelectionChanged(item, (bool)(e.Value ?? false))" />
                                    </td>
                                    <td>
                                        <img src="@(string.IsNullOrEmpty(item.AlbumCoverUrl) ? "https://placehold.co/40x40/1a1a1a/cccccc?text=🎵" : item.AlbumCoverUrl)"
                                             class="rounded border border-secondary"
                                             width="36" height="36" style="object-fit: cover;" alt="Cover" />
                                    </td>
                                    <td>
                                        <div class="fw-bold text-white text-truncate" style="max-width: 240px;">@item.CleanTitle</div>
                                        <div class="subtitle text-truncate m-0" style="max-width: 240px;">
                                            <span>@item.CleanArtist</span> · <em>@(string.IsNullOrEmpty(item.Album) ? "Single" : item.Album)</em>
                                            @if (!string.IsNullOrEmpty(item.Country))
                                            {
                                                <span class="count-tag ms-1 py-0 px-1" style="font-size: 0.6rem;">@item.Country</span>
                                            }
                                        </div>
                                    </td>
                                    <td class="subtitle text-nowrap">
                                        @FormatDuration(item.DurationSeconds)
                                    </td>
                                    <td class="td-status">
                                        @if (item.IsProcessing)
                                        {
                                            <span class="badge-new d-inline-flex align-items-center gap-1" style="background: rgba(255,193,7,0.2); border-color: #ffc107; color: #ffc107;">
                                                <span class="spinner-border spinner-border-sm" style="width: 0.6rem; height: 0.6rem;" role="status"></span>
                                                SEARCHING
                                            </span>
                                        }
                                        else if (item.IsNeedsReview)
                                        {
                                            <span class="badge-dup" style="border-color: #ffc107; color: #ffc107;" title="Perlu Pemilihan Kandidat">REVIEW</span>
                                        }
                                        else if (item.MatchConfidenceReason == "Manual Selected")
                                        {
                                            <span class="badge-new" style="background: rgba(13, 110, 253, 0.2); border-color: #0d6efd; color: #0d6efd;">MATCHED</span>
                                        }
                                        else
                                        {
                                            <span class="count-tag">IDLE</span>
                                        }
                                    </td>
                                    <td class="text-end text-nowrap" @onclick:stopPropagation="true">
                                        <button class="btn-clear py-1 px-2 me-1"
                                                @onclick="() => OpenCandidateModal(item)"
                                                disabled="@item.IsProcessing"
                                                title="Pilih Kandidat">
                                            @if (item.IsProcessing)
                                            {
                                                <span>SEARCHING...</span>
                                            }
                                            else if (item.Candidates != null && item.Candidates.Any())
                                            {
                                                <span>KANDIDAT (@Math.Min(item.Candidates.Count, 5))</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">KANDIDAT (0)</span>
                                            }
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- PAGINATION -->
            @if (totalPages > 1)
            {
                <div class="preview-footer d-flex justify-content-between align-items-center">
                    <span class="subtitle m-0">PAGE @currentPage / @totalPages</span>
                    <div class="d-flex gap-1">
                        <button class="btn-clear py-1 px-2" disabled="@(currentPage == 1)" @onclick="() => ChangePage(currentPage - 1)">PREV</button>
                        <button class="btn-clear py-1 px-2" disabled="@(currentPage == totalPages)" @onclick="() => ChangePage(currentPage + 1)">NEXT</button>
                    </div>
                </div>
            }
        </div>

        <!-- RIGHT PANEL: TAG INSPECTOR -->
        <div class="card-ingest sticky-top" style="top: 1rem;">
            <div class="source-tag">Inspector // Metadata Control</div>
            <h3 class="card-title mb-3">
                Tag Inspector @(SelectedCount > 1 ? $"({SelectedCount} Selected)" : "")
            </h3>

            @if (SelectedCount > 0 || activeEditItem != null)
            {
                @if (SelectedCount > 1)
                {
                    <div class="status-alert alert-info py-2 px-3 mb-3">
                        <p class="status-text m-0">Perubahan akan diterapkan secara masal ke <strong>@SelectedCount lagu</strong> terpilih.</p>
                    </div>
                }
                else if (activeEditItem != null)
                {
                    <input type="hidden" id="active-item-id" value="@activeEditItem.Id" />
                    <input type="hidden" id="active-item-israw" value="@(activeEditItem.IsFromRawSongs ? "true" : "false")" />
                    <input type="hidden" id="active-item-filepath" value="@activeEditItem.FilePath" />
                    <input type="hidden" id="active-item-filename" value="@activeEditItem.FileName" />

                    <div class="d-flex align-items-center gap-3 mb-3 p-2 border border-secondary border-opacity-25 rounded bg-black bg-opacity-25">
                        <img src="@(string.IsNullOrEmpty(batchModel.AlbumCoverUrl) ? "https://placehold.co/64x64/1a1a1a/cccccc?text=🎵" : batchModel.AlbumCoverUrl)"
                             width="56" height="56" class="rounded border border-secondary flex-shrink-0" style="object-fit: cover;" alt="Cover" />
                        <div class="overflow-hidden">
                            <div class="subtitle m-0">TARGET FILE</div>
                            <div class="text-white text-truncate fw-bold" style="font-size: 0.8rem;" title="@activeEditItem.FileName">@activeEditItem.FileName</div>
                            <div class="subtitle text-truncate m-0">ID: @activeEditItem.Id · @(string.IsNullOrEmpty(activeEditItem.Country) ? "Global" : activeEditItem.Country)</div>
                        </div>
                    </div>
                }

                <!-- FORM INPUTS -->
                <div class="form-group mb-2">
                    <label class="form-label d-flex justify-content-between">
                        <span>Judul Lagu</span>
                        @if (SelectedCount > 1) { <span class="text-warning">(Single Mode Only)</span> }
                    </label>
                    <input type="text" id="title-input" class="form-control" @bind="batchModel.CleanTitle" disabled="@(SelectedCount > 1)" placeholder="Judul lagu..." />
                </div>

                <div class="form-group mb-2">
                    <label class="form-label">Artis</label>
                    <input type="text" id="artist-input" class="form-control" @bind="batchModel.CleanArtist" placeholder="Artis..." />
                </div>

                <div class="form-group mb-2">
                    <label class="form-label">Album</label>
                    <input type="text" id="album-input" class="form-control" @bind="batchModel.Album" placeholder="Album..." />
                </div>

                <div class="form-group mb-2">
                    <label class="form-label">Cover Art URL</label>
                    <input type="text" id="cover-input" class="form-control" @bind="batchModel.AlbumCoverUrl" placeholder="https://..." />
                </div>

                <div class="d-flex gap-2 mb-2">
                    <div class="form-group flex-fill m-0">
                        <label class="form-label">Tahun Rilis</label>
                        <input type="number" id="year-input" class="form-control" @bind="batchModel.ReleaseYear" placeholder="YYYY" />
                    </div>
                    <div class="form-group flex-fill m-0">
                        <label class="form-label">Region/Country</label>
                        <input type="text" id="country-input" class="form-control" @bind="batchModel.Country" placeholder="ID/US/JP" />
                    </div>
                </div>

                <div class="d-flex gap-2 mb-3">
                    <div class="form-group flex-fill m-0">
                        <label class="form-label">Durasi (Detik)</label>
                        <input type="number" id="duration-input" class="form-control" @bind="batchModel.DurationSeconds" placeholder="Detik" />
                    </div>
                    <div class="form-group flex-fill m-0">
                        <label class="form-label">MusicBrainz ID</label>
                        <input type="text" id="mbid-input" class="form-control" @bind="batchModel.MusicBrainzId" placeholder="MBID" />
                    </div>
                </div>

                <!-- ACTIONS -->
                <div class="d-flex gap-2">
                    @if (SelectedCount <= 1 && activeEditItem != null)
                    {
                        <button class="btn-action flex-fill" @onclick="() => ReMatchSingle(activeEditItem)" disabled="@(isBatchProcessing || activeEditItem.IsProcessing)">
                            @if (activeEditItem.IsProcessing)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                <span>SEARCHING...</span>
                            }
                            else
                            {
                                <span>MATCH</span>
                            }
                        </button>
                        <button type="button" id="js-save-btn" class="btn-action btn-commit flex-fill" onclick="hypenSaveMetadata()">
                            SAVE TAGS
                        </button>
                    }
                    else
                    {
                        <button class="btn-action flex-fill" @onclick="ProcessSmartMatchSelected" disabled="@isBatchProcessing">
                            @if (isBatchProcessing)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                <span>SEARCHING...</span>
                            }
                            else
                            {
                                <span>MATCH (@SelectedCount SONGS)</span>
                            }
                        </button>
                        <button class="btn-action btn-commit flex-fill" @onclick="ApplyBatchChangesAndSave" disabled="@isBatchProcessing">
                            SAVE BATCH (@SelectedCount SONGS)
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5 text-secondary border border-dashed border-secondary border-opacity-25 rounded">
                    <span class="subtitle d-block mb-1">INSPECTOR IDLE</span>
                    <small>Pilih baris atau centang beberapa lagu untuk mulai mengedit metadata.</small>
                </div>
            }
        </div>
    </div>
</div>

<!-- MODAL CANDIDATE MATCH -->
@if (selectedItem != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.85); backdrop-filter: blur(4px);">
        <div class="modal-dialog modal-md modal-dialog-centered">
            <div class="card-ingest w-100 p-3 shadow-lg border-primary">
                <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-secondary border-opacity-25">
                    <div>
                        <div class="source-tag">Matching Engine // Candidates</div>
                        <h4 class="card-title m-0">Pilih Kandidat Metadata</h4>
                    </div>
                    <button type="button" class="btn-clear py-1 px-2" @onclick="CloseCandidateModal">✕</button>
                </div>

                <div class="status-alert alert-info py-2 px-3 mb-3">
                    <p class="status-text m-0">Target File: <strong>@selectedItem.FileName</strong></p>
                </div>

                @if (selectedItem.Candidates == null || !selectedItem.Candidates.Any())
                {
                    <div class="text-center py-4 border border-dashed border-secondary border-opacity-25 rounded mb-3">
                        <span class="subtitle text-warning d-block mb-1">KANDIDAT TIDAK DITEMUKAN</span>
                        <small class="text-secondary">Tidak ada metadata yang cocok dari layanan internet untuk file ini. Silakan isi tag secara manual lewat Inspector.</small>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-2 mb-3" style="max-height: 50vh; overflow-y: auto;">
                        @foreach (var candidate in selectedItem.Candidates.Take(5))
                        {
                            <div class="p-2 border rounded d-flex align-items-center justify-content-between gap-2"
                                 style="background: rgba(255,255,255,0.03); border-color: rgba(255,255,255,0.1) !important; cursor: pointer;"
                                 @onclick="() => SelectCandidate(candidate)">
                                <div class="d-flex align-items-center gap-2 overflow-hidden">
                                    <img src="@(string.IsNullOrEmpty(candidate.AlbumCoverUrl) ? "https://placehold.co/40x40/1a1a1a/cccccc?text=🎵" : candidate.AlbumCoverUrl)"
                                         class="rounded border border-secondary flex-shrink-0"
                                         width="40" height="40" style="object-fit: cover;" alt="Cover" />
                                    <div class="overflow-hidden">
                                        <div class="d-flex align-items-center gap-1 mb-1">
                                            <span class="subtitle m-0" style="font-size: 0.65rem;">@candidate.ProviderName</span>
                                        </div>
                                        <div class="fw-bold text-white text-truncate" style="font-size: 0.8rem;">@candidate.Title</div>
                                        <div class="subtitle text-truncate m-0" style="font-size: 0.68rem;">
                                            @candidate.Artist — <em>@candidate.Album</em> (@(candidate.ReleaseYear?.ToString() ?? "-"))
                                        </div>
                                    </div>
                                </div>
                                <button type="button" class="btn-action py-1 px-2 text-nowrap" style="font-size: 0.65rem;">
                                    USE THIS
                                </button>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}
