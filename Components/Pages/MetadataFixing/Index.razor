@page "/metadatafixing"
@namespace Hypen.Web.Components.Pages.MetadataFixing
@using Hypen.Web.Data
@using Hypen.Web.Models
@using Hypen.Web.Services
@using Microsoft.EntityFrameworkCore

<PageTitle>Advanced Tag Studio - Hypen</PageTitle>

<script src="/js/metadata-save.js"></script>

<div class="container-fluid py-2 px-2 px-md-3">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom border-secondary border-opacity-25 flex-wrap gap-2">
        <div class="min-width-0">
            <h5 class="fw-bold m-0 text-white d-flex align-items-center">
                <i class="ti ti-music-code me-2 text-primary"></i>
                Advanced Tag Studio
            </h5>
            <div class="text-secondary mt-1" style="font-size:.72rem;">
                Kelola tag ID3/MP4 · Sinkronisasi DB · Auto-Promotion Raw Songs
            </div>
        </div>

        <div class="d-flex gap-1 flex-wrap">
            <button class="btn btn-outline-light btn-sm py-1 px-2"
                    @onclick="LoadDataFromDatabase"
                    disabled="@isBatchProcessing">
                <i class="ti ti-database me-1"></i>Refresh
            </button>

            <button class="btn btn-primary btn-sm py-1 px-2"
                    @onclick="ProcessSmartMatchSelected"
                    disabled="@(isBatchProcessing || !filteredItems.Any())">
                @if (isBatchProcessing)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    <span>Processing</span>
                }
                else
                {
                    <i class="ti ti-wand me-1"></i>
                    <span>Match (@(SelectedCount > 0 ? SelectedCount : filteredItems.Count))</span>
                }
            </button>

            <button class="btn btn-success btn-sm py-1 px-2"
                    @onclick="ApplyBatchChangesAndSave"
                    disabled="@(isBatchProcessing || !filteredItems.Any())">
                <i class="ti ti-device-floppy me-1"></i>
                Save (@(SelectedCount > 0 ? SelectedCount : filteredItems.Count))
            </button>
        </div>
    </div>

    <!-- STATUS JS -->
    <div id="js-save-status" class="alert py-1 px-2 small mb-2 shadow-sm rounded-2" style="display:none;"></div>

    <!-- STATUS BLAZOR -->
    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert @(isError ? "alert-danger" : "alert-success") py-1 px-2 small mb-2 shadow-sm rounded-2">
            @statusMessage
        </div>
    }

    <!-- MAIN LAYOUT -->
    <div class="row g-2">

        <!-- LEFT — SONG TABLE -->
        <div class="col-lg-8">
            <div class="card bg-dark text-white shadow-sm border border-secondary border-opacity-25 rounded-3">

                <!-- TOOLBAR -->
                <div class="card-body p-2 border-bottom border-secondary border-opacity-25">
                    <div class="d-flex align-items-center gap-2">
                        <div class="flex-grow-1">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-secondary text-white border-secondary py-1">
                                    <i class="ti ti-search"></i>
                                </span>
                                <input type="text"
                                       class="form-control bg-dark text-white border-secondary py-1"
                                       placeholder="Cari judul, artis, album, atau file..."
                                       @bind="searchQuery"
                                       @bind:event="oninput"
                                       @bind:after="OnSearchQueryChanged" />
                                @if (!string.IsNullOrWhiteSpace(searchQuery))
                                {
                                    <button class="btn btn-outline-secondary text-white py-1 px-2"
                                            type="button"
                                            @onclick="ClearSearch">
                                        <i class="ti ti-x"></i>
                                    </button>
                                }
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-1 flex-shrink-0">
                            <span class="text-secondary d-none d-md-inline" style="font-size:.72rem;">
                                Tampil
                            </span>
                            <select class="form-select form-select-sm bg-dark text-white border-secondary py-1"
                                    style="width:68px;"
                                    @bind="pageSize"
                                    @bind:after="OnPageSizeChanged">
                                <option value="5">5</option>
                                <option value="10">10</option>
                                <option value="25">25</option>
                                <option value="50">50</option>
                                <option value="100">100</option>
                            </select>
                            <span class="text-secondary text-nowrap" style="font-size:.72rem;">
                                / @filteredCount
                            </span>
                        </div>
                    </div>
                </div>

                <!-- TABLE -->
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-dark table-hover table-sm align-middle mb-0" style="font-size:.78rem;">
                            <thead class="table-secondary text-dark">
                                <tr>
                                    <th style="width:34px;" class="text-center py-2">
                                        <input type="checkbox"
                                               class="form-check-input"
                                               @checked="isAllSelected"
                                               @onchange="ToggleSelectAll" />
                                    </th>
                                    <th style="width:42px;" class="py-2">Cover</th>
                                    <th class="py-2">Metadata</th>
                                    <th style="width:58px;" class="py-2">Time</th>
                                    <th style="width:68px;" class="py-2">Status</th>
                                    <th class="text-end py-2" style="width:82px;">Aksi</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (pagedItems == null || !pagedItems.Any())
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-4 text-secondary">
                                            <i class="ti ti-music-off fs-3 d-block mb-1"></i>
                                            <span style="font-size:.78rem;">Tidak ada data lagu ditemukan.</span>
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var item in pagedItems)
                                    {
                                        <tr class="@(activeEditItem == item ? "table-active bg-primary bg-opacity-10" : "")"
                                            style="cursor:pointer;"
                                            @onclick="() => SelectForEditing(item)">

                                            <!-- CHECKBOX -->
                                            <td class="text-center py-1" @onclick:stopPropagation="true">
                                                <input type="checkbox"
                                                       class="form-check-input"
                                                       checked="@item.IsSelected"
                                                       @onchange="(e) => OnItemSelectionChanged(item, (bool)(e.Value ?? false))" />
                                            </td>

                                            <!-- COVER -->
                                            <td class="py-1">
                                                <img src="@(string.IsNullOrEmpty(item.AlbumCoverUrl)
                                                    ? "https://placehold.co/32x32/1a1a1a/cccccc?text=🎵"
                                                    : item.AlbumCoverUrl)"
                                                     class="rounded shadow-sm"
                                                     width="32" height="32" style="object-fit:cover;" alt="Cover" />
                                            </td>

                                            <!-- METADATA -->
                                            <td class="py-1">
                                                <div class="fw-semibold text-white text-truncate" style="max-width:260px;">
                                                    @item.CleanTitle
                                                </div>
                                                <div class="text-secondary text-truncate" style="max-width:260px;font-size:.68rem;">
                                                    <span>@item.CleanArtist</span>
                                                    <span class="mx-1">•</span>
                                                    <em>@(string.IsNullOrEmpty(item.Album) ? "Single" : item.Album)</em>
                                                    @if (!string.IsNullOrEmpty(item.Country))
                                                    {
                                                        <span class="badge bg-secondary py-0 px-1 ms-1" style="font-size:.55rem;">
                                                            @item.Country
                                                        </span>
                                                    }
                                                </div>
                                            </td>

                                            <!-- DURATION -->
                                            <td class="text-secondary text-nowrap py-1">
                                                @FormatDuration(item.DurationSeconds)
                                            </td>

                                            <!-- STATUS -->
                                            <td class="py-1">
                                                @if (item.IsProcessing)
                                                {
                                                    <span class="badge bg-info text-dark px-1 py-1" style="font-size:.58rem;">Match</span>
                                                }
                                                else if (item.IsNeedsReview)
                                                {
                                                    <span class="badge bg-warning text-dark px-1 py-1" style="font-size:.58rem;" title="@item.MatchConfidenceReason">Review</span>
                                                }
                                                else if (item.MatchConfidenceReason.StartsWith("Exact Match"))
                                                {
                                                    <span class="badge bg-success px-1 py-1" style="font-size:.58rem;">Exact (≥98%)</span>
                                                }
                                                else if (item.MatchConfidenceReason == "Manual Selected")
                                                {
                                                    <span class="badge bg-primary px-1 py-1" style="font-size:.58rem;">Manual</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary px-1 py-1" style="font-size:.58rem;">Idle</span>
                                                }
                                            </td>

                                            <!-- ACTIONS -->
                                            <td class="text-end text-nowrap py-1" @onclick:stopPropagation="true">
                                                <button class="btn btn-outline-light btn-sm py-0 px-1 me-1"
                                                        @onclick="() => OpenCandidateModal(item)"
                                                        disabled="@(!item.Candidates.Any())"
                                                        title="Pilih Kandidat">
                                                    <i class="ti ti-list-details"></i>
                                                    @if (item.Candidates.Any())
                                                    {
                                                        <span style="font-size:.65rem;">@Math.Min(item.Candidates.Count, 5)</span>
                                                    }
                                                </button>
                                                <button class="btn btn-outline-primary btn-sm py-0 px-1"
                                                        @onclick="() => SelectForEditing(item)"
                                                        title="Edit Detail">
                                                    <i class="ti ti-edit"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- PAGINATION -->
                @if (totalPages > 1)
                {
                    <div class="d-flex justify-content-between align-items-center px-2 py-2 border-top border-secondary border-opacity-25">
                        <span class="text-secondary" style="font-size:.68rem;">
                            Page @currentPage / @totalPages
                        </span>
                        <div class="btn-group btn-group-sm">
                            <button class="btn btn-outline-secondary py-0 px-2"
                                    disabled="@(currentPage == 1)"
                                    @onclick="() => ChangePage(currentPage - 1)">
                                <i class="ti ti-chevron-left"></i>
                            </button>
                            @for (int i = 1; i <= totalPages; i++)
                            {
                                var pageIndex = i;
                                <button class="btn @(currentPage == pageIndex ? "btn-primary" : "btn-outline-secondary") py-0 px-2"
                                        @onclick="() => ChangePage(pageIndex)">
                                    @pageIndex
                                </button>
                            }
                            <button class="btn btn-outline-secondary py-0 px-2"
                                    disabled="@(currentPage == totalPages)"
                                    @onclick="() => ChangePage(currentPage + 1)">
                                <i class="ti ti-chevron-right"></i>
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- RIGHT — TAG INSPECTOR (FULLY DYNAMIC) -->
        <div class="col-lg-4">
            <div class="card bg-dark text-white shadow-sm border border-secondary border-opacity-25 rounded-3 sticky-top" style="top:.5rem;">

                <div class="card-header bg-secondary bg-opacity-10 border-bottom border-secondary border-opacity-25 py-2 px-2 d-flex justify-content-between align-items-center">
                    <h6 class="text-white m-0 fw-semibold" style="font-size:.78rem;">
                        <i class="ti ti-adjustments me-1 text-primary"></i>
                        Tag Inspector @(SelectedCount > 1 ? $"({SelectedCount} Terpilih)" : "")
                    </h6>
                    @if (SelectedCount == 1 && activeEditItem != null)
                    {
                        <span class="badge bg-secondary text-light" style="font-size:.55rem;">
                            ID: @activeEditItem.Id
                        </span>
                    }
                    else if (SelectedCount > 1)
                    {
                        <span class="badge bg-warning text-dark fw-bold" style="font-size:.58rem;">
                            BATCH EDIT
                        </span>
                    }
                </div>

                <div class="card-body p-2" style="max-height: 82vh; overflow-y: auto;">
                    @if (SelectedCount > 0 || activeEditItem != null)
                    {
                        @if (SelectedCount > 1)
                        {
                            <div class="alert alert-info py-1 px-2 mb-2" style="font-size:.68rem;">
                                <i class="ti ti-info-circle me-1"></i>
                                Perubahan diterapkan ke <strong>@SelectedCount lagu</strong> yang dicentang.
                            </div>
                        }
                        else if (activeEditItem != null)
                        {
                            <!-- Hidden elements untuk dibaca oleh JS pendukung -->
                            <input type="hidden" id="active-item-id" value="@activeEditItem.Id" />
                            <input type="hidden" id="active-item-israw" value="@(activeEditItem.IsFromRawSongs ? "true" : "false")" />
                            <input type="hidden" id="active-item-filepath" value="@activeEditItem.FilePath" />
                            <input type="hidden" id="active-item-filename" value="@activeEditItem.FileName" />

                            <div class="d-flex align-items-center gap-2 mb-2">
                                <img src="@(string.IsNullOrEmpty(batchModel.AlbumCoverUrl)
                                    ? "https://placehold.co/72x72/1a1a1a/cccccc?text=🎵"
                                    : batchModel.AlbumCoverUrl)"
                                     width="64" height="64" class="rounded shadow-sm border border-secondary" style="object-fit:cover;" alt="Cover" />
                                <div class="min-width-0 flex-grow-1">
                                    <div class="text-secondary mb-1" style="font-size:.62rem;">FILE</div>
                                    <div class="text-white text-truncate" style="font-size:.72rem;" title="@activeEditItem.FileName">
                                        @activeEditItem.FileName
                                    </div>
                                    <div class="text-secondary mt-1" style="font-size:.62rem;">
                                        ID @activeEditItem.Id · @(string.IsNullOrEmpty(activeEditItem.Country) ? "-" : activeEditItem.Country)
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- INPUT FORM INSPECTOR (DINAMIS SEPENUHNYA) -->
                        <div class="mb-2">
                            <label class="form-label text-secondary mb-1 d-flex justify-content-between" style="font-size:.65rem;">
                                <span>Judul Lagu</span>
                                @if (SelectedCount > 1)
                                {
                                    <span class="text-warning">(Satu lagu saja)</span>
                                }
                            </label>
                            <input type="text" id="title-input"
                                   class="form-control form-control-sm bg-dark text-white border-secondary py-1"
                                   @bind="batchModel.CleanTitle"
                                   disabled="@(SelectedCount > 1)"
                                   placeholder="Judul lagu..." />
                        </div>

                        <div class="mb-2">
                            <label class="form-label text-secondary mb-1" style="font-size:.65rem;">Artis</label>
                            <input type="text" id="artist-input"
                                   class="form-control form-control-sm bg-dark text-white border-secondary py-1"
                                   @bind="batchModel.CleanArtist"
                                   placeholder="Artis..." />
                        </div>

                        <div class="mb-2">
                            <label class="form-label text-secondary mb-1" style="font-size:.65rem;">Album</label>
                            <input type="text" id="album-input"
                                   class="form-control form-control-sm bg-dark text-white border-secondary py-1"
                                   @bind="batchModel.Album"
                                   placeholder="Album..." />
                        </div>

                        <div class="mb-2">
                            <label class="form-label text-secondary mb-1" style="font-size:.65rem;">URL Cover Album</label>
                            <input type="text" id="cover-input"
                                   class="form-control form-control-sm bg-dark text-white border-secondary py-1"
                                   @bind="batchModel.AlbumCoverUrl"
                                   placeholder="https://..." />
                        </div>

                        <div class="row g-2 mb-2">
                            <div class="col-6">
                                <label class="form-label text-secondary mb-1" style="font-size:.65rem;">Tahun Rilis</label>
                                <input type="number" id="year-input"
                                       class="form-control form-control-sm bg-dark text-white border-secondary py-1"
                                       @bind="batchModel.ReleaseYear"
                                       placeholder="Tahun..." />
                            </div>
                            <div class="col-6">
                                <label class="form-label text-secondary mb-1" style="font-size:.65rem;">Negara / Region</label>
                                <input type="text" id="country-input"
                                       class="form-control form-control-sm bg-dark text-white border-secondary py-1"
                                       @bind="batchModel.Country"
                                       placeholder="Kode Negara..." />
                            </div>
                        </div>

                        <div class="row g-2 mb-2">
                            <div class="col-6">
                                <label class="form-label text-secondary mb-1" style="font-size:.65rem;">Durasi (Detik)</label>
                                <input type="number" id="duration-input"
                                       class="form-control form-control-sm bg-dark text-white border-secondary py-1"
                                       @bind="batchModel.DurationSeconds"
                                       placeholder="Detik..." />
                            </div>
                            <div class="col-6">
                                <label class="form-label text-secondary mb-1" style="font-size:.65rem;">MusicBrainz ID</label>
                                <input type="text" id="mbid-input"
                                       class="form-control form-control-sm bg-dark text-white border-secondary py-1"
                                       @bind="batchModel.MusicBrainzId"
                                       placeholder="MBID..." />
                            </div>
                        </div>

                        <div class="row g-2 mt-2">
                            @if (SelectedCount <= 1 && activeEditItem != null)
                            {
                                <div class="col-6">
                                    <button class="btn btn-outline-info btn-sm text-white w-100 py-1"
                                            @onclick="() => ReMatchSingle(activeEditItem)"
                                            disabled="@isBatchProcessing">
                                        <i class="ti ti-wand me-1"></i> Match
                                    </button>
                                </div>
                            }
                            <div class="@(SelectedCount > 1 ? "col-12" : "col-6")">
                                @if (SelectedCount <= 1)
                                {
                                    <button type="button" id="js-save-btn" class="btn btn-success btn-sm w-100 py-1 fw-bold"
                                            onclick="hypenSaveMetadata()">
                                        <i class="ti ti-device-floppy me-1"></i>
                                        Simpan
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-success btn-sm w-100 py-1 fw-bold"
                                            @onclick="ApplyBatchChangesAndSave"
                                            disabled="@isBatchProcessing">
                                        <i class="ti ti-device-floppy me-1"></i>
                                        Simpan (@SelectedCount Lagu)
                                    </button>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-secondary">
                            <i class="ti ti-click fs-3 d-block mb-1"></i>
                            <p class="small m-0">Pilih atau centang lagu untuk mengedit metadata.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL KANDIDAT METADATA -->
@if (selectedItem != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.75);">
        <div class="modal-dialog modal-md modal-dialog-centered">
            <div class="modal-content bg-dark text-white border border-secondary shadow-lg">
                <div class="modal-header border-bottom border-secondary py-2 px-3">
                    <h6 class="modal-title m-0 d-flex align-items-center" style="font-size:.82rem;">
                        <i class="ti ti-list-check me-2 text-primary"></i>
                        Pilih Kandidat Metadata (Maks 5 Tampilan)
                    </h6>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseCandidateModal"></button>
                </div>
                <div class="modal-body p-2" style="max-height: 70vh; overflow-y: auto;">
                    <div class="alert alert-dark border border-secondary py-1 px-2 mb-2" style="font-size:.68rem;">
                        <div>Target File: <strong class="text-info">@selectedItem.FileName</strong></div>
                        @if (selectedItem.IsNeedsReview)
                        {
                            <div class="text-warning mt-1">
                                <i class="ti ti-alert-triangle me-1"></i><strong>Status Review:</strong> @selectedItem.MatchConfidenceReason
                            </div>
                        }
                    </div>

                    <div class="d-flex flex-column gap-2">
                        @foreach (var candidate in selectedItem.Candidates.Take(5))
                        {
                            var scorePercent = Math.Round(candidate.SimilarityScore * 100, 1);
                            var badgeColor = scorePercent >= 98.0 ? "bg-success" : (scorePercent >= 80.0 ? "bg-warning text-dark" : "bg-danger");

                            <div class="bg-dark text-white border border-secondary rounded-2 p-2 d-flex align-items-center justify-content-between"
                                 style="cursor:pointer;"
                                 @onclick="() => SelectCandidate(candidate)">
                                <div class="d-flex align-items-center min-width-0">
                                    <img src="@(string.IsNullOrEmpty(candidate.AlbumCoverUrl) ? "https://placehold.co/40x40/1a1a1a/cccccc?text=🎵" : candidate.AlbumCoverUrl)"
                                         class="rounded me-2 shadow-sm flex-shrink-0"
                                         width="40" height="40" style="object-fit:cover;" alt="Cover" />
                                    <div class="min-width-0">
                                        <div class="d-flex align-items-center gap-1 mb-1">
                                            <span class="badge @badgeColor fw-bold" style="font-size:.6rem;">
                                                Match @scorePercent%
                                            </span>
                                            @if (scorePercent < 98.0)
                                            {
                                                <span class="badge bg-outline-warning text-warning border border-warning" style="font-size:.52rem;">
                                                    &lt; 98% (Manual)
                                                </span>
                                            }
                                            @if (!string.IsNullOrEmpty(candidate.Country))
                                            {
                                                <span class="badge bg-secondary" style="font-size:.55rem;">@candidate.Country</span>
                                            }
                                            <span class="text-secondary" style="font-size:.6rem;">@candidate.ProviderName</span>
                                        </div>
                                        <div class="fw-semibold text-truncate" style="font-size:.78rem;">
                                            @candidate.Title
                                        </div>
                                        <div class="text-secondary text-truncate" style="font-size:.68rem;">
                                            @candidate.Artist — <em>@candidate.Album</em> (@(candidate.ReleaseYear?.ToString() ?? "-")) · @TimeSpan.FromSeconds(candidate.DurationSeconds).ToString(@"mm\:ss")
                                        </div>
                                    </div>
                                </div>
                                <button type="button" class="btn btn-outline-primary btn-sm py-1 px-2 ms-2 flex-shrink-0" style="font-size:.65rem;">
                                    Gunakan
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}
