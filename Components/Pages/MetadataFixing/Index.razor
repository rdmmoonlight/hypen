@page "/metadatafixing"
@using Hypen.Web.Data
@using Hypen.Web.Models
@using Hypen.Web.Services
@using Microsoft.EntityFrameworkCore
@inject MusicSmartMatchService SmartMatchService
@inject TagEditorCliService TagEditorService
@inject IDbContextFactory<AppDbContext> DbContextFactory

<PageTitle>Metadata Fixing & Tag Editor - Hypen</PageTitle>

<div class="metadata-fixing-container py-3 px-2 px-md-3">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h4 class="fw-bold m-0 text-white"><i class="ti ti-tags me-2 text-accent"></i>Metadata Smart Fixing &amp; Tag Editor</h4>
            <p class="text-secondary small m-0">Sinkronisasi database Songs/Raw Songs &amp; Tulis Tag Fisik via Martchus TagEditor</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <button class="btn btn-nebula-outline text-white btn-sm" @onclick="LoadDataFromDatabase" disabled="@isBatchProcessing">
                <i class="ti ti-database me-1"></i> Refresh
            </button>
            <button class="btn btn-nebula-primary btn-sm" @onclick="ProcessSmartMatchSelected" disabled="@isBatchProcessing || !Items.Any(x => x.IsSelected)">
                @if (isBatchProcessing)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    <span>Processing...</span>
                }
                else
                {
                    <i class="ti ti-wand me-1"></i><span>Auto Match (@Items.Count(x => x.IsSelected))</span>
                }
            </button>
            <button class="btn btn-success btn-sm" @onclick="SaveSelectedToDatabaseAndFiles" disabled="@isBatchProcessing || !Items.Any(x => x.IsSelected)">
                <i class="ti ti-device-floppy me-1"></i> Save Tag &amp; DB (@Items.Count(x => x.IsSelected))
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert @(isError ? "alert-danger" : "alert-success") py-1 px-2 small mb-2 shadow-sm">
            @statusMessage
        </div>
    }

    <!-- Controls Bar: Page Size & Info -->
    <div class="card card-nebula shadow-sm border-0 mb-2">
        <div class="card-body py-2 px-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2">
                <span class="text-secondary small">Baris per halaman:</span>
                <select class="form-select form-select-sm bg-dark text-white border-secondary py-0 px-2" style="width: 75px; height: 28px;" @bind="pageSize" @bind:after="OnPageSizeChanged">
                    <option value="5">5</option>
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </div>
            <div class="text-secondary small">
                Total Data: <strong class="text-white">@totalCount</strong> | Halaman <strong class="text-white">@currentPage</strong> / <strong class="text-white">@(totalPages == 0 ? 1 : totalPages)</strong>
            </div>
        </div>
    </div>

    <!-- Main Content Table Card (Kompak, Lebar Efisien) -->
    <div class="card card-nebula shadow-sm border-0 mb-2">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-nebula table-sm align-middle mb-0" style="font-size: 0.82rem;">
                    <thead>
                        <tr>
                            <th style="width: 35px;" class="text-center">
                                <input type="checkbox" class="form-check-input bg-dark border-secondary" @checked="isAllSelected" @onchange="ToggleSelectAll" />
                            </th>
                            <th style="width: 50px;">Cover</th>
                            <th>Metadata Lagu &amp; Lokasi File</th>
                            <th style="width: 70px;">Durasi</th>
                            <th style="width: 90px;">Status Match</th>
                            <th class="text-end" style="width: 150px;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (pagedItems == null || !pagedItems.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-secondary">
                                    <i class="ti ti-music-off fs-2 d-block mb-1"></i>
                                    Tidak ada data lagu ditemukan.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in pagedItems)
                            {
                                <tr>
                                    <td class="text-center">
                                        <input type="checkbox" class="form-check-input bg-dark border-secondary" @bind="item.IsSelected" />
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.AlbumCoverUrl))
                                        {
                                            <img src="@item.AlbumCoverUrl" class="rounded shadow-sm" width="36" height="36" style="object-fit: cover;" alt="Cover" />
                                        }
                                        else
                                        {
                                            <div class="cover-placeholder rounded d-flex align-items-center justify-content-center bg-dark" style="width: 36px; height: 36px;">
                                                <i class="ti ti-music fs-6 text-secondary"></i>
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <div class="fw-bold text-white text-truncate" style="max-width: 320px;" title="@item.CleanTitle">@item.CleanTitle</div>
                                        <div class="text-secondary text-truncate" style="max-width: 320px; font-size: 0.73rem;">
                                            <span class="text-white-50">@item.CleanArtist</span> • <em class="text-white-50">@(string.IsNullOrEmpty(item.Album) ? "Single" : item.Album)</em>
                                            @if (item.ReleaseYear.HasValue)
                                            {
                                                <span> (@item.ReleaseYear)</span>
                                            }
                                            <span class="badge @(item.Country == "Songs" ? "bg-success" : "bg-warning text-dark") py-0 px-1 ms-1" style="font-size: 0.65rem;">@item.Country</span>
                                        </div>
                                    </td>
                                    <td class="text-white-50 text-nowrap">
                                        @FormatDuration(item.DurationSeconds)
                                    </td>
                                    <td>
                                        @if (item.IsProcessing)
                                        {
                                            <span class="badge bg-info text-dark py-1" style="font-size: 0.68rem;"><span class="spinner-border spinner-border-sm me-1" style="width: 10px; height: 10px;"></span>Match</span>
                                        }
                                        else if (item.IsNeedsReview)
                                        {
                                            <span class="badge bg-warning text-dark py-1" style="font-size: 0.68rem;" title="@item.MatchConfidenceReason">Review</span>
                                        }
                                        else if (item.MatchConfidenceReason == "Exact Match")
                                        {
                                            <span class="badge bg-success py-1" style="font-size: 0.68rem;">Exact</span>
                                        }
                                        else if (item.MatchConfidenceReason == "Manual Selected")
                                        {
                                            <span class="badge bg-primary py-1" style="font-size: 0.68rem;">Manual</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary py-1" style="font-size: 0.68rem;">Idle</span>
                                        }
                                    </td>
                                    <td class="text-end text-nowrap">
                                        <button class="btn btn-dark btn-sm p-1 px-2 me-1 border-secondary text-white" @onclick="() => ReMatchSingle(item)" title="Cari ulang di Internet">
                                            <i class="ti ti-refresh"></i>
                                        </button>
                                        <button class="btn btn-outline-secondary btn-sm p-1 px-2 me-1 text-white" @onclick="() => OpenCandidateModal(item)" disabled="@(!item.Candidates.Any())" title="Pilih Kandidat iTunes">
                                            <i class="ti ti-list-details"></i> (@item.Candidates.Count)
                                        </button>
                                        <button class="btn btn-success btn-sm p-1 px-2" @onclick="() => SaveItemToDatabaseAndFile(item)" title="Simpan Tag Fisik &amp; Database">
                                            <i class="ti ti-device-floppy"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Pagination Footer -->
    @if (totalPages > 1)
    {
        <nav class="d-flex justify-content-center mt-2">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <button class="page-link bg-dark text-white border-secondary py-1 px-2" @onclick="() => ChangePage(currentPage - 1)">Prev</button>
                </li>
                @for (int i = 1; i <= totalPages; i++)
                {
                    var pageIndex = i;
                    <li class="page-item @(currentPage == pageIndex ? "active" : "")">
                        <button class="page-link @(currentPage == pageIndex ? "bg-primary border-primary text-white" : "bg-dark text-white border-secondary") py-1 px-2" @onclick="() => ChangePage(pageIndex)">@pageIndex</button>
                    </li>
                }
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <button class="page-link bg-dark text-white border-secondary py-1 px-2" @onclick="() => ChangePage(currentPage + 1)">Next</button>
                </li>
            </ul>
        </nav>
    }
</div>

<!-- Modal Selector Kandidat Metadata -->
@if (selectedItem != null)
{
    <div class="modal fade show d-block nebula-modal-backdrop" tabindex="-1">
        <div class="modal-dialog modal-md modal-dialog-centered">
            <div class="modal-content modal-nebula">
                <div class="modal-header border-bottom-nebula py-2">
                    <h6 class="modal-title text-white m-0">Pilih Kandidat Metadata (iTunes)</h6>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseCandidateModal"></button>
                </div>
                <div class="modal-body p-3">
                    <p class="text-secondary small mb-2">Target File: <strong class="text-white">@selectedItem.FileName</strong></p>
                    <div class="list-group gap-2">
                        @foreach (var candidate in selectedItem.Candidates)
                        {
                            <div class="candidate-card d-flex align-items-center justify-content-between p-2 rounded bg-dark border border-secondary" style="cursor: pointer;" @onclick="() => SelectCandidate(candidate)">
                                <div class="d-flex align-items-center">
                                    <img src="@candidate.AlbumCoverUrl" class="rounded me-2 shadow-sm" width="40" height="40" style="object-fit: cover;" alt="Cover" />
                                    <div>
                                        <h6 class="mb-0 fw-bold text-white small">@candidate.Title</h6>
                                        <div class="text-secondary" style="font-size: 0.72rem;">@candidate.Artist — <em class="text-white-50">@candidate.Album</em> (@candidate.ReleaseYear)</div>
                                    </div>
                                </div>
                                <button type="button" class="btn btn-primary btn-sm py-0 px-2" style="font-size: 0.72rem;">Gunakan</button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<LocalTrackModel> Items = new();
    private List<LocalTrackModel> pagedItems = new();
    private LocalTrackModel? selectedItem;
    private bool isBatchProcessing = false;
    private bool isAllSelected = false;
    private string statusMessage = "";
    private bool isError = false;

    // Pagination State
    private int pageSize = 10;
    private int currentPage = 1;
    private int totalCount = 0;
    private int totalPages = 1;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataFromDatabase();
    }

    private string FormatDuration(int seconds)
    {
        if (seconds <= 0) return "-";
        var timeSpan = TimeSpan.FromSeconds(seconds);
        return timeSpan.Hours > 0 
            ? timeSpan.ToString(@"hh\:mm\:ss") 
            : timeSpan.ToString(@"mm\:ss");
    }

    private async Task LoadDataFromDatabase()
    {
        try
        {
            using var context = await DbContextFactory.CreateDbContextAsync();
            
            // 1. Ambil dari tabel Songs (Production Library)
            var songs = await context.Songs.ToListAsync();
            var songTracks = songs.Select(s => new LocalTrackModel
            {
                Id = (int)s.Id,
                FileName = s.YoutubeVideoId ?? $"song_{s.Id}",
                Title = s.Title,
                Artist = s.Artist,
                Album = s.Album,
                ReleaseYear = s.ReleaseYear,
                Country = "Songs",
                AlbumCoverUrl = s.AlbumCoverUrl,
                DurationSeconds = s.DurationSeconds ?? 0,
                MusicBrainzId = s.MusicBrainzId,
                FilePath = s.AudioUrl != null && s.AudioUrl.StartsWith("/downloads/") 
                    ? Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", s.AudioUrl.TrimStart('/')) 
                    : string.Empty,
                IsSelected = false
            });

            // 2. Ambil dari tabel RawSongs (Staging)
            var rawSongs = await context.RawSongs.Where(r => r.Status == "PENDING").ToListAsync();
            var rawTracks = rawSongs.Select(r => new LocalTrackModel
            {
                Id = (int)r.Id,
                FileName = r.YoutubeVideoId ?? $"raw_{r.Id}",
                Title = r.Title,
                Artist = r.Artist,
                Album = r.Album,
                ReleaseYear = r.ReleaseYear,
                Country = "RawSongs",
                AlbumCoverUrl = r.AlbumCoverUrl,
                DurationSeconds = r.DurationSeconds ?? 0,
                MusicBrainzId = r.MusicBrainzId,
                FilePath = r.AudioUrl != null && r.AudioUrl.StartsWith("/downloads/") 
                    ? Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", r.AudioUrl.TrimStart('/')) 
                    : string.Empty,
                IsSelected = false
            });

            Items = songTracks.Concat(rawTracks).ToList();
            totalCount = Items.Count;
            UpdatePagination();

            statusMessage = $"Berhasil memuat {totalCount} lagu dari database.";
            isError = false;
        }
        catch (Exception ex)
        {
            statusMessage = $"Gagal memuat data dari database: {ex.Message}";
            isError = true;
        }
    }

    private void UpdatePagination()
    {
        totalPages = (int)Math.Ceiling(totalCount / (double)pageSize);
        if (currentPage > totalPages && totalPages > 0) currentPage = totalPages;
        if (currentPage < 1) currentPage = 1;

        pagedItems = Items
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList();
    }

    private void ChangePage(int newPage)
    {
        if (newPage >= 1 && newPage <= totalPages)
        {
            currentPage = newPage;
            UpdatePagination();
        }
    }

    private void OnPageSizeChanged()
    {
        currentPage = 1;
        UpdatePagination();
    }

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        isAllSelected = e.Value is bool val && val;
        foreach (var item in pagedItems)
        {
            item.IsSelected = isAllSelected;
        }
    }

    private async Task ProcessSmartMatchSelected()
    {
        var targets = Items.Where(x => x.IsSelected).ToList();
        if (!targets.Any()) return;

        isBatchProcessing = true;
        statusMessage = $"Menjalankan smart match untuk {targets.Count} lagu terpilih...";
        isError = false;
        StateHasChanged();

        foreach (var item in targets)
        {
            await SmartMatchService.SmartMatchFromInternetAsync(item);
        }

        isBatchProcessing = false;
        statusMessage = "Smart match selesai untuk item terpilih.";
        StateHasChanged();
    }

    private async Task ReMatchSingle(LocalTrackModel item)
    {
        item.IsProcessing = true;
        StateHasChanged();

        await SmartMatchService.SmartMatchFromInternetAsync(item);

        item.IsProcessing = false;
        StateHasChanged();
    }

    private void OpenCandidateModal(LocalTrackModel item)
    {
        selectedItem = item;
    }

    private void CloseCandidateModal()
    {
        selectedItem = null;
    }

    private void SelectCandidate(iTunesCandidateModel candidate)
    {
        if (selectedItem != null)
        {
            SmartMatchService.ApplyCandidateToItem(selectedItem, candidate);
            selectedItem.IsNeedsReview = false;
            selectedItem.MatchConfidenceReason = "Manual Selected";
            CloseCandidateModal();
        }
    }

    private async Task SaveSelectedToDatabaseAndFiles()
    {
        var targets = Items.Where(x => x.IsSelected).ToList();
        if (!targets.Any()) return;

        isBatchProcessing = true;
        int successCount = 0;

        foreach (var item in targets)
        {
            try
            {
                await SaveItemInternalAsync(item);
                successCount++;
            }
            catch { }
        }

        isBatchProcessing = false;
        statusMessage = $"Berhasil memperbarui tag file fisik & database untuk {successCount} lagu terpilih.";
        isError = false;
        await LoadDataFromDatabase();
    }

    private async Task SaveItemToDatabaseAndFile(LocalTrackModel item)
    {
        try
        {
            await SaveItemInternalAsync(item);
            statusMessage = $"Tag file fisik & database untuk '{item.CleanTitle}' berhasil diperbarui / dipromosikan ke Songs.";
            isError = false;
            await LoadDataFromDatabase();
        }
        catch (Exception ex)
        {
            statusMessage = $"Gagal menyimpan tag/database: {ex.Message}";
            isError = true;
        }
        StateHasChanged();
    }

    private async Task SaveItemInternalAsync(LocalTrackModel item)
    {
        // 1. Tulis tag ke file fisik server menggunakan tageditor CLI (Martchus)
        if (!string.IsNullOrEmpty(item.FilePath))
        {
            await TagEditorService.ApplyTagsToFileAsync(
                item.FilePath,
                item.CleanArtist,
                item.CleanTitle,
                item.Album,
                item.ReleaseYear,
                item.AlbumCoverUrl
            );
        }

        using var context = await DbContextFactory.CreateDbContextAsync();

        if (item.Country == "Songs")
        {
            var song = await context.Songs.FindAsync((long)item.Id);
            if (song != null)
            {
                song.Title = item.CleanTitle;
                song.Artist = item.CleanArtist;
                song.Album = item.Album;
                song.ReleaseYear = item.ReleaseYear;
                song.AlbumCoverUrl = item.AlbumCoverUrl ?? "";
                song.DurationSeconds = item.DurationSeconds;
                song.MusicBrainzId = item.MusicBrainzId;

                await context.SaveChangesAsync();
            }
        }
        else if (item.Country == "RawSongs")
        {
            // ATURAN KHUSUS: Simpan/Edit dari Raw Songs -> Complete Upload ke Songs & Hapus dari Raw Songs
            var raw = await context.RawSongs.FindAsync((long)item.Id);
            if (raw != null)
            {
                string ytId = raw.YoutubeVideoId ?? $"LOCAL-{Guid.NewGuid():N}";
                var existingSong = await context.Songs.FirstOrDefaultAsync(s => s.YoutubeVideoId == ytId);

                if (existingSong != null)
                {
                    existingSong.Title = item.CleanTitle;
                    existingSong.Artist = item.CleanArtist;
                    existingSong.Album = string.IsNullOrWhiteSpace(item.Album) ? "Single" : item.Album;
                    existingSong.ReleaseYear = item.ReleaseYear;
                    existingSong.Country = string.IsNullOrWhiteSpace(raw.Country) ? "Unknown" : raw.Country;
                    existingSong.AlbumCoverUrl = item.AlbumCoverUrl ?? "";
                    existingSong.DurationSeconds = item.DurationSeconds;
                    existingSong.MusicBrainzId = item.MusicBrainzId;
                }
                else
                {
                    var newSong = new SongsModel
                    {
                        RawId = raw.Id,
                        YoutubeVideoId = ytId,
                        MusicBrainzId = item.MusicBrainzId,
                        Title = item.CleanTitle,
                        Artist = item.CleanArtist,
                        Album = string.IsNullOrWhiteSpace(item.Album) ? "Single" : item.Album,
                        ReleaseYear = item.ReleaseYear,
                        Country = string.IsNullOrWhiteSpace(raw.Country) ? "Unknown" : raw.Country,
                        AlbumCoverUrl = item.AlbumCoverUrl ?? "",
                        AudioUrl = raw.AudioUrl ?? $"/downloads/{item.FileName}",
                        DurationSeconds = item.DurationSeconds,
                        IsDownloaded = true
                    };
                    await context.Songs.AddAsync(newSong);
                }

                context.RawSongs.Remove(raw);
                await context.SaveChangesAsync();
            }
        }
    }
}
