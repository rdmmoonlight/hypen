@page "/metadatafixing"
@using Hypen.Web.Data
@using Hypen.Web.Models
@using Hypen.Web.Services
@using Microsoft.EntityFrameworkCore
@inject MusicSmartMatchService SmartMatchService
@inject TagLibService TagEditorService
@inject IDbContextFactory<AppDbContext> DbContextFactory

<PageTitle>Advanced Tag Studio - Hypen</PageTitle>

<div class="container-fluid py-3 px-2 px-md-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-3 pb-2 border-bottom border-secondary border-opacity-25">
        <div>
            <h4 class="fw-bold m-0 text-white d-flex align-items-center">
                <i class="ti ti-music-code me-2 text-primary"></i>Advanced Tag Studio
            </h4>
            <p class="text-secondary small m-0 mt-1">Kelola tag ID3/MP4 fisik via TagLib#, Sinkronisasi DB, &amp; Auto-Promotion Raw Songs</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <button class="btn btn-outline-light btn-sm px-3" @onclick="LoadDataFromDatabase" disabled="@isBatchProcessing">
                <i class="ti ti-database me-1"></i> Refresh
            </button>
            
            <!-- Tombol Match: Diperbaiki agar tidak ter-disabled saat ada data / item dipilih -->
            <button class="btn btn-primary btn-sm px-3" @onclick="ProcessSmartMatchSelected" disabled="@(isBatchProcessing || !filteredItems.Any())">
                @if (isBatchProcessing)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    <span>Processing...</span>
                }
                else
                {
                    <i class="ti ti-wand me-1"></i><span>Match (@(SelectedCount > 0 ? SelectedCount : filteredItems.Count))</span>
                }
            </button>
            
            <!-- Tombol Save Changes -->
            <button class="btn btn-success btn-sm px-3" @onclick="SaveSelectedToDatabaseAndFiles" disabled="@(isBatchProcessing || !filteredItems.Any())">
                <i class="ti ti-device-floppy me-1"></i> Save Changes (@(SelectedCount > 0 ? SelectedCount : filteredItems.Count))
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert @(isError ? "alert-danger" : "alert-success") py-2 px-3 small mb-3 shadow-sm rounded-2">
            @statusMessage
        </div>
    }

    <!-- Main Layout: Split View (Table Left, Inspector Right) -->
    <div class="row g-3">
        <!-- Kolom Kiri: Tabel Daftar Lagu & Search Filter -->
        <div class="col-lg-8">
            <div class="card bg-dark text-white shadow-sm border border-secondary border-opacity-25 rounded-3 mb-3">
                <div class="card-body p-3">
                    <div class="row g-2 align-items-center">
                        <!-- Input Filter Manual -->
                        <div class="col-md-7">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-secondary text-white border-secondary">
                                    <i class="ti ti-search"></i>
                                </span>
                                <input type="text" class="form-control bg-dark text-white border-secondary" placeholder="Cari berdasarkan judul, artis, atau album..." @bind="searchQuery" @bind:event="oninput" @bind:after="OnSearchQueryChanged" />
                                @if (!string.IsNullOrWhiteSpace(searchQuery))
                                {
                                    <button class="btn btn-outline-secondary text-white" type="button" @onclick="ClearSearch">
                                        <i class="ti ti-x"></i>
                                    </button>
                                }
                            </div>
                        </div>
                        <!-- Baris per halaman -->
                        <div class="col-md-5 d-flex justify-content-md-end align-items-center gap-2">
                            <span class="text-secondary small">Tampil:</span>
                            <select class="form-select form-select-sm bg-dark text-white border-secondary py-1" style="width: 80px;" @bind="pageSize" @bind:after="OnPageSizeChanged">
                                <option value="5">5</option>
                                <option value="10">10</option>
                                <option value="25">25</option>
                                <option value="50">50</option>
                                <option value="100">100</option>
                            </select>
                            <span class="text-secondary small ms-1">(@filteredCount item)</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tabel Data -->
            <div class="card bg-dark text-white shadow-sm border border-secondary border-opacity-25 rounded-3">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-dark table-hover table-sm align-middle mb-0" style="font-size: 0.85rem;">
                            <thead class="table-secondary text-dark">
                                <tr>
                                    <th style="width: 40px;" class="text-center">
                                        <input type="checkbox" class="form-check-input" @checked="isAllSelected" @onchange="ToggleSelectAll" />
                                    </th>
                                    <th style="width: 50px;">Cover</th>
                                    <th>Metadata Lagu &amp; File</th>
                                    <th style="width: 70px;">Durasi</th>
                                    <th style="width: 80px;">Status</th>
                                    <th class="text-end" style="width: 100px;">Aksi</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (pagedItems == null || !pagedItems.Any())
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-5 text-secondary">
                                            <i class="ti ti-music-off fs-1 d-block mb-2"></i>
                                            Tidak ada data lagu ditemukan.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var item in pagedItems)
                                    {
                                        <tr class="@(activeEditItem == item ? "table-active bg-primary bg-opacity-10" : "")" style="cursor: pointer;" @onclick="() => SelectForEditing(item)">
                                            <td class="text-center" @onclick:stopPropagation="true">
                                                <input type="checkbox" class="form-check-input" @bind="item.IsSelected" @bind:after="StateHasChanged" />
                                            </td>
                                            <td>
                                                <img src="@(string.IsNullOrEmpty(item.AlbumCoverUrl) ? "https://placehold.co/36x36/1a1a1a/cccccc?text=🎵" : item.AlbumCoverUrl)" class="rounded shadow-sm" width="36" height="36" style="object-fit: cover;" alt="Cover" />
                                            </td>
                                            <td>
                                                <div class="fw-bold text-white text-truncate" style="max-width: 220px;" title="@item.CleanTitle">@item.CleanTitle</div>
                                                <div class="text-secondary text-truncate" style="max-width: 220px; font-size: 0.75rem;">
                                                    <span>@item.CleanArtist</span> • <em>@(string.IsNullOrEmpty(item.Album) ? "Single" : item.Album)</em>
                                                    <span class="badge @(item.Country == "Songs" ? "bg-success" : "bg-warning text-dark") py-0 px-1 ms-1" style="font-size: 0.6rem;">@item.Country</span>
                                                </div>
                                            </td>
                                            <td class="text-secondary text-nowrap">
                                                @FormatDuration(item.DurationSeconds)
                                            </td>
                                            <td>
                                                @if (item.IsProcessing)
                                                {
                                                    <span class="badge bg-info text-dark py-1 px-2" style="font-size: 0.65rem;">Match</span>
                                                }
                                                else if (item.IsNeedsReview)
                                                {
                                                    <span class="badge bg-warning text-dark py-1 px-2" style="font-size: 0.65rem;">Review</span>
                                                }
                                                else if (item.MatchConfidenceReason == "Exact Match")
                                                {
                                                    <span class="badge bg-success py-1 px-2" style="font-size: 0.65rem;">Exact</span>
                                                }
                                                else if (item.MatchConfidenceReason == "Manual Selected")
                                                {
                                                    <span class="badge bg-primary py-1 px-2" style="font-size: 0.65rem;">Manual</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary py-1 px-2" style="font-size: 0.65rem;">Idle</span>
                                                }
                                            </td>
                                            <td class="text-end text-nowrap" @onclick:stopPropagation="true">
                                                <button class="btn btn-outline-light btn-sm py-0 px-1 me-1" @onclick="() => OpenCandidateModal(item)" disabled="@(!item.Candidates.Any())" title="Pilih Kandidat">
                                                    <i class="ti ti-list-details"></i> (@item.Candidates.Count)
                                                </button>
                                                <button class="btn btn-outline-primary btn-sm py-0 px-1" @onclick="() => SelectForEditing(item)" title="Edit Detail">
                                                    <i class="ti ti-edit"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Pagination Footer -->
            @if (totalPages > 1)
            {
                <nav class="d-flex justify-content-center mt-3">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <button class="page-link bg-dark text-white border-secondary" @onclick="() => ChangePage(currentPage - 1)">Prev</button>
                        </li>
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            var pageIndex = i;
                            <li class="page-item @(currentPage == pageIndex ? "active" : "")">
                                <button class="page-link @(currentPage == pageIndex ? "bg-primary border-primary text-white" : "bg-dark text-white border-secondary")" @onclick="() => ChangePage(pageIndex)">@pageIndex</button>
                            </li>
                        }
                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <button class="page-link bg-dark text-white border-secondary" @onclick="() => ChangePage(currentPage + 1)">Next</button>
                        </li>
                    </ul>
                </nav>
            }
        </div>

        <!-- Kolom Kanan: Advanced Tag & Metadata Inspector Panel -->
        <div class="col-lg-4">
            <div class="card bg-dark text-white shadow-sm border border-secondary border-opacity-25 rounded-3 sticky-top" style="top: 1rem;">
                <div class="card-header bg-secondary bg-opacity-10 border-bottom border-secondary border-opacity-25 py-2 px-3 d-flex justify-content-between align-items-center">
                    <h6 class="text-white m-0 small fw-bold d-flex align-items-center">
                        <i class="ti ti-adjustments me-1 text-primary"></i> Tag Inspector &amp; Editor
                    </h6>
                    @if (activeEditItem != null)
                    {
                        <span class="badge bg-secondary text-light" style="font-size: 0.65rem;">ID: @activeEditItem.Id</span>
                    }
                </div>
                <div class="card-body p-3">
                    @if (activeEditItem != null)
                    {
                        <div class="text-center mb-3">
                            <img src="@(string.IsNullOrEmpty(activeEditItem.AlbumCoverUrl) ? "https://placehold.co/90x90/1a1a1a/cccccc?text=🎵" : activeEditItem.AlbumCoverUrl)" width="90" height="90" class="rounded shadow-sm object-fit-cover mb-2 border border-secondary" alt="Cover" />
                            <div class="text-secondary text-truncate" style="font-size: 0.72rem;" title="@activeEditItem.FileName">File: @activeEditItem.FileName</div>
                        </div>

                        <div class="mb-2">
                            <label class="form-label text-secondary small mb-1">Judul Lagu (Title)</label>
                            <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary" @bind="activeEditItem.CleanTitle" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label text-secondary small mb-1">Artis (Artist)</label>
                            <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary" @bind="activeEditItem.CleanArtist" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label text-secondary small mb-1">Album</label>
                            <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary" @bind="activeEditItem.Album" />
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label text-secondary small mb-1">Tahun Rilis</label>
                                <input type="number" class="form-control form-control-sm bg-dark text-white border-secondary" @bind="activeEditItem.ReleaseYear" />
                            </div>
                            <div class="col-6">
                                <label class="form-label text-secondary small mb-1">Durasi (detik)</label>
                                <input type="number" class="form-control form-control-sm bg-dark text-white border-secondary" @bind="activeEditItem.DurationSeconds" />
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button class="btn btn-outline-info btn-sm text-white py-2" @onclick="() => ReMatchSingle(activeEditItem)" disabled="@isBatchProcessing">
                                <i class="ti ti-wand me-1"></i> Match via Internet
                            </button>
                            <button class="btn btn-success btn-sm py-2" @onclick="() => SaveItemToDatabaseAndFile(activeEditItem)" disabled="@isBatchProcessing">
                                <i class="ti ti-device-floppy me-1"></i> Simpan ke File &amp; Database
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 text-secondary">
                            <i class="ti ti-click fs-2 d-block mb-2"></i>
                            <p class="small m-0">Pilih salah satu baris lagu di tabel untuk mengedit detail metadatanya di sini.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Selector Kandidat Metadata -->
@if (selectedItem != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.7);">
        <div class="modal-dialog modal-md modal-dialog-centered">
            <div class="modal-content bg-dark text-white border border-secondary">
                <div class="modal-header border-bottom border-secondary py-2 px-3">
                    <h6 class="modal-title m-0">Pilih Kandidat Metadata (iTunes)</h6>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseCandidateModal"></button>
                </div>
                <div class="modal-body p-3">
                    <p class="text-secondary small mb-2">Target File: <strong class="text-white">@selectedItem.FileName</strong></p>
                    <div class="list-group gap-2">
                        @foreach (var candidate in selectedItem.Candidates)
                        {
                            <div class="list-group-item list-group-item-action bg-dark text-white border border-secondary rounded p-2 d-flex align-items-center justify-content-between" style="cursor: pointer;" @onclick="() => SelectCandidate(candidate)">
                                <div class="d-flex align-items-center">
                                    <img src="@candidate.AlbumCoverUrl" class="rounded me-2 shadow-sm" width="40" height="40" style="object-fit: cover;" alt="Cover" />
                                    <div>
                                        <h6 class="mb-0 fw-bold small">@candidate.Title</h6>
                                        <div class="text-secondary" style="font-size: 0.72rem;">@candidate.Artist — <em>@candidate.Album</em> (@candidate.ReleaseYear)</div>
                                    </div>
                                </div>
                                <button type="button" class="btn btn-primary btn-sm py-0 px-2" style="font-size: 0.7rem;">Gunakan</button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<LocalTrackModel> Items = new();
    private List<LocalTrackModel> filteredItems = new();
    private List<LocalTrackModel> pagedItems = new();
    private LocalTrackModel? selectedItem;
    private LocalTrackModel? activeEditItem;
    private bool isBatchProcessing = false;
    private bool isAllSelected = false;
    private string statusMessage = "";
    private bool isError = false;
    private string searchQuery = "";

    // Properti hitung item ter-centang
    private int SelectedCount => filteredItems.Count(x => x.IsSelected);

    // Pagination State
    private int pageSize = 10;
    private int currentPage = 1;
    private int totalCount = 0;
    private int filteredCount = 0;
    private int totalPages = 1;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataFromDatabase();
    }

    private string FormatDuration(int seconds)
    {
        if (seconds <= 0) return "-";
        var timeSpan = TimeSpan.FromSeconds(seconds);
        return timeSpan.Hours > 0 
            ? timeSpan.ToString(@"hh\:mm\:ss") 
            : timeSpan.ToString(@"mm\:ss");
    }

    private async Task LoadDataFromDatabase()
    {
        try
        {
            using var context = await DbContextFactory.CreateDbContextAsync();
            
            var songs = await context.Songs.ToListAsync();
            var songTracks = songs.Select(s => new LocalTrackModel
            {
                Id = (int)s.Id,
                FileName = s.YoutubeVideoId ?? $"song_{s.Id}",
                Title = s.Title,
                Artist = s.Artist,
                Album = s.Album,
                ReleaseYear = s.ReleaseYear,
                Country = "Songs",
                AlbumCoverUrl = s.AlbumCoverUrl,
                DurationSeconds = s.DurationSeconds ?? 0,
                MusicBrainzId = s.MusicBrainzId,
                FilePath = s.AudioUrl != null && s.AudioUrl.StartsWith("/downloads/") 
                    ? Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", s.AudioUrl.TrimStart('/')) 
                    : string.Empty,
                IsSelected = false
            });

            var rawSongs = await context.RawSongs.Where(r => r.Status == "PENDING").ToListAsync();
            var rawTracks = rawSongs.Select(r => new LocalTrackModel
            {
                Id = (int)r.Id,
                FileName = r.YoutubeVideoId ?? $"raw_{r.Id}",
                Title = r.Title,
                Artist = r.Artist,
                Album = r.Album,
                ReleaseYear = r.ReleaseYear,
                Country = "RawSongs",
                AlbumCoverUrl = r.AlbumCoverUrl,
                DurationSeconds = r.DurationSeconds ?? 0,
                MusicBrainzId = r.MusicBrainzId,
                FilePath = r.AudioUrl != null && r.AudioUrl.StartsWith("/downloads/") 
                    ? Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", r.AudioUrl.TrimStart('/')) 
                    : string.Empty,
                IsSelected = false
            });

            Items = songTracks.Concat(rawTracks).ToList();
            totalCount = Items.Count;
            ApplyFilter();

            if (filteredItems.Any() && activeEditItem == null)
            {
                activeEditItem = filteredItems.First();
            }

            statusMessage = $"Berhasil memuat {totalCount} lagu dari database.";
            isError = false;
        }
        catch (Exception ex)
        {
            statusMessage = $"Gagal memuat data dari database: {ex.Message}";
            isError = true;
        }
    }

    private void ApplyFilter()
    {
        if (string.IsNullOrWhiteSpace(searchQuery))
        {
            filteredItems = Items;
        }
        else
        {
            var query = searchQuery.Trim().ToLower();
            filteredItems = Items.Where(x => 
                (!string.IsNullOrEmpty(x.CleanTitle) && x.CleanTitle.ToLower().Contains(query)) ||
                (!string.IsNullOrEmpty(x.CleanArtist) && x.CleanArtist.ToLower().Contains(query)) ||
                (!string.IsNullOrEmpty(x.Album) && x.Album.ToLower().Contains(query)) ||
                (!string.IsNullOrEmpty(x.FileName) && x.FileName.ToLower().Contains(query))
            ).ToList();
        }

        filteredCount = filteredItems.Count;
        UpdatePagination();
    }

    private void OnSearchQueryChanged()
    {
        currentPage = 1;
        ApplyFilter();
    }

    private void ClearSearch()
    {
        searchQuery = "";
        currentPage = 1;
        ApplyFilter();
    }

    private void UpdatePagination()
    {
        totalPages = (int)Math.Ceiling(filteredCount / (double)pageSize);
        if (currentPage > totalPages && totalPages > 0) currentPage = totalPages;
        if (currentPage < 1) currentPage = 1;

        pagedItems = filteredItems
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList();
    }

    private void ChangePage(int newPage)
    {
        if (newPage >= 1 && newPage <= totalPages)
        {
            currentPage = newPage;
            UpdatePagination();
        }
    }

    private void OnPageSizeChanged()
    {
        currentPage = 1;
        UpdatePagination();
    }

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        isAllSelected = e.Value is bool val && val;
        foreach (var item in pagedItems)
        {
            item.IsSelected = isAllSelected;
        }
    }

    private void SelectForEditing(LocalTrackModel item)
    {
        activeEditItem = item;
    }

    private async Task ProcessSmartMatchSelected()
    {
        var targets = filteredItems.Where(x => x.IsSelected).ToList();
        if (!targets.Any()) targets = filteredItems; 

        isBatchProcessing = true;
        statusMessage = $"Menjalankan match untuk {targets.Count} lagu...";
        isError = false;
        StateHasChanged();

        foreach (var item in targets)
        {
            await SmartMatchService.SmartMatchFromInternetAsync(item);
        }

        isBatchProcessing = false;
        statusMessage = "Match selesai.";
        StateHasChanged();
    }

    private async Task ReMatchSingle(LocalTrackModel item)
    {
        item.IsProcessing = true;
        StateHasChanged();

        await SmartMatchService.SmartMatchFromInternetAsync(item);

        item.IsProcessing = false;
        StateHasChanged();
    }

    private void OpenCandidateModal(LocalTrackModel item)
    {
        selectedItem = item;
    }

    private void CloseCandidateModal()
    {
        selectedItem = null;
    }

    private void SelectCandidate(iTunesCandidateModel candidate)
    {
        if (selectedItem != null)
        {
            SmartMatchService.ApplyCandidateToItem(selectedItem, candidate);
            selectedItem.IsNeedsReview = false;
            selectedItem.MatchConfidenceReason = "Manual Selected";
            CloseCandidateModal();
        }
    }

    private async Task SaveSelectedToDatabaseAndFiles()
    {
        var targets = filteredItems.Where(x => x.IsSelected).ToList();
        if (!targets.Any()) targets = filteredItems; 

        isBatchProcessing = true;
        int successCount = 0;

        foreach (var item in targets)
        {
            try
            {
                await SaveItemInternalAsync(item);
                successCount++;
            }
            catch { }
        }

        isBatchProcessing = false;
        statusMessage = $"Berhasil memperbarui tag file fisik & database untuk {successCount} lagu.";
        isError = false;
        await LoadDataFromDatabase();
    }

    private async Task SaveItemToDatabaseAndFile(LocalTrackModel item)
    {
        try
        {
            await SaveItemInternalAsync(item);
            statusMessage = $"Tag file fisik & database untuk '{item.CleanTitle}' berhasil diperbarui.";
            isError = false;
            await LoadDataFromDatabase();
        }
        catch (Exception ex)
        {
            statusMessage = $"Gagal menyimpan tag/database: {ex.Message}";
            isError = true;
        }
        StateHasChanged();
    }

    private async Task SaveItemInternalAsync(LocalTrackModel item)
    {
        if (!string.IsNullOrEmpty(item.FilePath))
        {
            await TagEditorService.ApplyTagsToFileAsync(
                item.FilePath,
                item.CleanArtist,
                item.CleanTitle,
                item.Album ?? string.Empty,
                item.ReleaseYear,
                item.AlbumCoverUrl
            );
        }

        using var context = await DbContextFactory.CreateDbContextAsync();

        if (item.Country == "Songs")
        {
            var song = await context.Songs.FindAsync((long)item.Id);
            if (song != null)
            {
                song.Title = item.CleanTitle;
                song.Artist = item.CleanArtist;
                song.Album = item.Album;
                song.ReleaseYear = item.ReleaseYear;
                song.AlbumCoverUrl = item.AlbumCoverUrl ?? "";
                song.DurationSeconds = item.DurationSeconds;
                song.MusicBrainzId = item.MusicBrainzId;

                await context.SaveChangesAsync();
            }
        }
        else if (item.Country == "RawSongs")
        {
            var raw = await context.RawSongs.FindAsync((long)item.Id);
            if (raw != null)
            {
                string ytId = raw.YoutubeVideoId ?? $"LOCAL-{Guid.NewGuid():N}";
                var existingSong = await context.Songs.FirstOrDefaultAsync(s => s.YoutubeVideoId == ytId);

                if (existingSong != null)
                {
                    existingSong.Title = item.CleanTitle;
                    existingSong.Artist = item.CleanArtist;
                    existingSong.Album = string.IsNullOrWhiteSpace(item.Album) ? "Single" : item.Album;
                    existingSong.ReleaseYear = item.ReleaseYear;
                    existingSong.Country = string.IsNullOrWhiteSpace(raw.Country) ? "Unknown" : raw.Country;
                    existingSong.AlbumCoverUrl = item.AlbumCoverUrl ?? "";
                    existingSong.DurationSeconds = item.DurationSeconds;
                    existingSong.MusicBrainzId = item.MusicBrainzId;
                }
                else
                {
                    var newSong = new SongsModel
                    {
                        RawId = raw.Id,
                        YoutubeVideoId = ytId,
                        MusicBrainzId = item.MusicBrainzId,
                        Title = item.CleanTitle,
                        Artist = item.CleanArtist,
                        Album = string.IsNullOrWhiteSpace(item.Album) ? "Single" : item.Album,
                        ReleaseYear = item.ReleaseYear,
                        Country = string.IsNullOrWhiteSpace(raw.Country) ? "Unknown" : raw.Country,
                        AlbumCoverUrl = item.AlbumCoverUrl ?? "",
                        AudioUrl = raw.AudioUrl ?? $"/downloads/{item.FileName}",
                        DurationSeconds = item.DurationSeconds,
                        IsDownloaded = true
                    };
                    await context.Songs.AddAsync(newSong);
                }

                context.RawSongs.Remove(raw);
                await context.SaveChangesAsync();
            }
        }
    }
}
