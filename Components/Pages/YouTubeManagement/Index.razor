@page "/youtubemanagement"
@namespace Hypen.Web.Components.Pages.YouTubeManagement

<PageTitle>YouTube Auto-Detect Sync - Hypen</PageTitle>

<div class="yt-sync-container">
    <div class="yt-sync-header">
        <h2 class="yt-sync-title">YouTube Auto-Detect Sync</h2>
        <p class="yt-sync-subtitle">Sinkronisasi otomatis untuk mendeteksi lagu dan playlist terbaru langsung dari akun YouTube & YouTube Music Anda</p>
    </div>

    @if (!string.IsNullOrEmpty(StatusMessage))
    {
        <div class="yt-status-alert @(IsError ? "yt-status-error" : "yt-status-success")">
            <span class="yt-status-icon">@(IsError ? "⚠️" : "ℹ️")</span>
            <span class="yt-status-text">@StatusMessage</span>
        </div>
    }

    <div class="yt-sync-grid">
        <!-- Action Trigger Card -->
        <div class="yt-card">
            <div class="yt-card-header">
                <h3>Sinkronisasi Akun</h3>
            </div>
            <div class="yt-card-body">
                <p class="yt-card-desc">
                    Klik tombol di bawah untuk memeriksa pembaruan library, playlist, dan menyinkronkan data lagu terbaru ke Staging Buffer.
                </p>

                <div class="yt-form-actions">
                    <button class="yt-btn yt-btn-primary" @onclick="ExecuteAutoSyncAsync" disabled="@IsSyncing">
                        @if (IsSyncing)
                        {
                            <span class="yt-spinner"></span>
                            <span>Menyinkronkan Akun...</span>
                        }
                        else
                        {
                            <span>🔄 Sync Data Terbaru dari Akun</span>
                        }
                    </button>
                </div>
            </div>
        </div>

        <!-- Summary & Status Card -->
        <div class="yt-card">
            <div class="yt-card-header">
                <h3>Status Library & Staging</h3>
            </div>
            <div class="yt-card-body">
                <div class="yt-metrics-container">
                    <div class="yt-metric-box">
                        <span class="yt-metric-value">@PendingRawCount</span>
                        <span class="yt-metric-label">Pending Staging</span>
                    </div>

                    <div class="yt-metric-box">
                        <span class="yt-metric-value">@CompletedSongsCount</span>
                        <span class="yt-metric-label">Completed Library</span>
                    </div>
                </div>

                <div class="yt-info-row">
                    <span class="yt-info-label">Item Baru Ditemukan:</span>
                    <span class="yt-info-value">@TotalAddedToStaging lagu</span>
                </div>
                <div class="yt-info-row">
                    <span class="yt-info-label">Terakhir Disinkronkan:</span>
                    <span class="yt-info-value">@(LastSyncTime.HasValue ? LastSyncTime.Value.ToString("dd MMM yyyy HH:mm:ss") : "-")</span>
                </div>
            </div>
        </div>
    </div>
</div>
