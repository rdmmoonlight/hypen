@namespace Hypen.Web.Components

<aside class="hypen-sidebar @(isExpanded ? "expanded" : "collapsed")">
    <div class="sidebar-top">
        <div class="sidebar-header">
            @if (isExpanded)
            {
                <div class="brand-info animate-fade">
                    <h3 class="nebula-title">Hypen Vault</h3>
                    <span class="portal-subtitle">Audio Portal</span>
                </div>
            }
            
            <button type="button" class="toggle-btn" @onclick="ToggleSidebar" title="@(isExpanded ? "Collapse Sidebar" : "Expand Sidebar")">
                <i class="ti @(isExpanded ? "ti-chevron-left" : "ti-chevron-right")"></i>
            </button>
        </div>

        <nav class="sidebar-nav">
            <NavLink href="library" Match="NavLinkMatch.All" class="nav-item-nebula" title="Pustaka Musik">
                <i class="ti ti-music"></i>
                @if (isExpanded)
                {
                    <span class="nav-text animate-fade">Pustaka Musik</span>
                }
            </NavLink>

            <NavLink href="extraction" class="nav-item-nebula" title="Library Extraction Engine">
                <i class="ti ti-refresh"></i>
                @if (isExpanded)
                {
                    <span class="nav-text animate-fade">Extraction</span>
                }
            </NavLink>

            <NavLink href="staging" class="nav-item-nebula" title="Staging Buffer Review">
                <i class="ti ti-stack-2"></i>
                @if (isExpanded)
                {
                    <span class="nav-text animate-fade">Staging Buffer</span>
                }
            </NavLink>

            <!-- Vault Tools Dropdown Parent -->
            <div class="nav-dropdown-wrapper">
                <NavLink href="tools" Match="NavLinkMatch.Prefix" class="nav-item-nebula d-flex align-items-center justify-content-between" @onclick="OnToolsParentClick" title="Vault Tools & Maintenance Center">
                    <div class="d-flex align-items-center gap-2">
                        <i class="ti ti-tools"></i>
                        @if (isExpanded)
                        {
                            <span class="nav-text animate-fade ms-1">Vault Tools</span>
                        }
                    </div>
                    @if (isExpanded)
                    {
                        <span class="dropdown-trigger" @onclick:stopPropagation="true" @onclick="ToggleToolsSubmenu">
                            <i class="ti @(isToolsSubmenuOpen ? "ti-chevron-down" : "ti-chevron-right") dropdown-arrow"></i>
                        </span>
                    }
                </NavLink>

                <!-- Submenu / Dropdown Items -->
                @if (isToolsSubmenuOpen && isExpanded)
                {
                    <div class="submenu-container animate-fade">
                        <NavLink href="tools/dedup" class="nav-item-nebula submenu-item" title="Duplicate Detector">
                            <i class="ti ti-copy"></i>
                            <span class="nav-text">Duplicate Detector</span>
                        </NavLink>

                        <NavLink href="tools/localsync" class="nav-item-nebula submenu-item" title="Local Sync">
                            <i class="ti ti-folder-symlink"></i>
                            <span class="nav-text">Local Sync</span>
                        </NavLink>

                        <NavLink href="tools/drivedetector" class="nav-item-nebula submenu-item" title="GDrive Management">
                            <i class="ti ti-brand-google-drive"></i>
                            <span class="nav-text">GDrive Management</span>
                        </NavLink>
                    </div>
                }
            </div>

            <NavLink href="settingss" class="nav-item-nebula" title="Pengaturan Akun">
                <i class="ti ti-settings"></i>
                @if (isExpanded)
                {
                    <span class="nav-text animate-fade">Pengaturan</span>
                }
            </NavLink>
        </nav>
    </div>

    @if (isExpanded)
    {
        <div class="sidebar-footer animate-fade">
            <p class="footer-text">
                💡 Enjoy your music via <strong class="text-accent">Hypen Music</strong>.
            </p>
        </div>
    }
</aside>
