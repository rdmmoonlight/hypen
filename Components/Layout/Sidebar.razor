@namespace Hypen.Web.Components

<aside class="hypen-sidebar @(isExpanded ? "expanded" : "collapsed")">
    <div class="sidebar-top">
        <div class="sidebar-header">
            @if (isExpanded)
            {
                <div class="brand-info animate-fade">
                    <h3 class="nebula-title">Hypen Vault</h3>
                    <span class="portal-subtitle">Audio Portal</span>
                </div>
            }
            
            <button type="button" class="toggle-btn" @onclick="ToggleSidebar" title="@(isExpanded ? "Collapse Sidebar" : "Expand Sidebar")">
                <i class="bi @(isExpanded ? "bi-chevron-left" : "bi-chevron-right")"></i>
            </button>
        </div>

        <nav class="sidebar-nav">
            <NavLink href="library" Match="NavLinkMatch.All" class="nav-item-nebula" title="Pustaka Musik">
                <i class="bi bi-music-note-list fs-5"></i>
                @if (isExpanded)
                {
                    <span class="nav-text animate-fade">Pustaka Musik</span>
                }
            </NavLink>

            <NavLink href="extraction" class="nav-item-nebula" title="Library Extraction Engine">
                <i class="bi bi-arrow-repeat fs-5"></i>
                @if (isExpanded)
                {
                    <span class="nav-text animate-fade">Extraction</span>
                }
            </NavLink>

            <NavLink href="staging" class="nav-item-nebula" title="Staging Buffer Review">
                <i class="bi bi-stack fs-5"></i>
                @if (isExpanded)
                {
                    <span class="nav-text animate-fade">Staging Buffer</span>
                }
            </NavLink>

            <!-- Vault Tools Dropdown Parent -->
            <div class="nav-dropdown-wrapper">
                <button type="button" class="nav-item-nebula btn-dropdown-toggle w-100 border-0 bg-transparent text-start" @onclick="ToggleToolsSubmenu" title="Vault Tools & Maintenance Center">
                    <div class="d-flex align-items-center justify-content-between w-100">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-tools fs-5"></i>
                            @if (isExpanded)
                            {
                                <span class="nav-text animate-fade ms-2">Vault Tools</span>
                            }
                        </div>
                        @if (isExpanded)
                        {
                            <i class="bi @(isToolsSubmenuOpen ? "bi-chevron-down" : "bi-chevron-right") dropdown-arrow ms-auto"></i>
                        }
                    </div>
                </button>

                <!-- Submenu / Dropdown Items -->
                @if (isToolsSubmenuOpen && isExpanded)
                {
                    <div class="submenu-container ps-4 animate-fade">
                        <NavLink href="tools/duplicate-detector" class="nav-item-nebula submenu-item" title="Duplicate Detector">
                            <i class="bi bi-files fs-6"></i>
                            <span class="nav-text fs-7">Duplicate Detector</span>
                        </NavLink>

                        <NavLink href="tools/local-sync" class="nav-item-nebula submenu-item" title="Local Sync">
                            <i class="bi bi-folder-symlink fs-6"></i>
                            <span class="nav-text fs-7">Local Sync</span>
                        </NavLink>

                        <NavLink href="tools/gdrive-management" class="nav-item-nebula submenu-item" title="GDrive Management">
                            <i class="bi bi-cloud-arrow-up fs-6"></i>
                            <span class="nav-text fs-7">GDrive Management</span>
                        </NavLink>
                    </div>
                }
            </div>

            <NavLink href="setting" class="nav-item-nebula" title="Pengaturan Akun">
                <i class="bi bi-gear-fill fs-5"></i>
                @if (isExpanded)
                {
                    <span class="nav-text animate-fade">Pengaturan</span>
                }
            </NavLink>
        </nav>
    </div>

    @if (isExpanded)
    {
        <div class="sidebar-footer animate-fade">
            <p class="footer-text">
                💡 Enjoy your music via <strong class="text-accent">Hypen Music</strong>.
            </p>
        </div>
    }
</aside>
