@page "/"

<PageTitle>Hypen Vault Downloader</PageTitle>

<main class="main-container">
    <!-- Header Title -->
    <div class="input-group" style="margin-bottom: 25px;">
        <h2 class="nebula-title" style="font-size: 1.8rem; margin-bottom: 5px;">Hypen Downloader Portal</h2>
        <p style="color: var(--text-secondary); font-size: 0.95rem; margin: 0;">
            Ekstrak audio YouTube ke Vault, lalu unduh ke perangkat Anda. Pemutaran lagu ditangani oleh aplikasi Mobile.
        </p>
    </div>

    <!-- Input Track Single -->
    <div class="input-group">
        <h3 class="nebula-title">Import Single Track</h3>
        <div class="input-inline">
            <input type="text" @bind="ytUrl" placeholder="Tempel link video YouTube..." disabled="@isLoading" />
            <button class="btn-nebula" @onclick="ConvertVideo" disabled="@isLoading">
                @(isLoading ? "Memproses..." : "Add Track")
            </button>
        </div>
    </div>

    <!-- Input Playlist YouTube -->
    <div class="input-group">
        <h3 class="nebula-title">Import YouTube Playlist</h3>
        <div class="input-inline">
            <input type="text" @bind="playlistUrl" placeholder="Tempel link playlist YouTube..." disabled="@isLoading" />
            <button class="btn-nebula btn-secondary" @onclick="ConvertPlaylist" disabled="@isLoading">
                @(isLoading ? "Memproses..." : "Import Playlist")
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(statusMsg))
    {
        <p class="status-msg" style="color: @(isError ? "#f72585" : "#4cc9f0"); font-weight: 500; margin-top: 10px;">@statusMsg</p>
    }

    <!-- Controls Bar & Search -->
    <div class="controls-bar input-group" style="margin-top: 25px;">
        <div class="input-inline" style="margin-bottom: 10px;">
            <input type="text" @bind="searchQuery" @bind:event="oninput" placeholder="Cari judul lagu atau artis..." />
        </div>
        <div class="action-buttons-inline" style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
            <label style="color: var(--text-secondary); font-size: 0.9rem; cursor: pointer; display: flex; align-items: center; gap: 5px;">
                <input type="checkbox" @onchange="ToggleSelectAll" /> Pilih Semua
            </label>
            <button class="btn-nebula btn-secondary" @onclick="DownloadSelected">Download Selected</button>
            <button class="btn-nebula btn-danger" @onclick="DeleteSelected">Hapus Selected</button>
        </div>
    </div>

    <!-- Library Grid Section -->
    <h3 class="nebula-title section-header" style="margin-top: 20px;">Library Collection</h3>
    <div class="card-grid">
        @if (FilteredSongs == null)
        {
            <p style="color: var(--text-secondary); text-align: center; grid-column: 1 / -1;">Memuat library...</p>
        }
        else if (!FilteredSongs.Any())
        {
            <p style="color: var(--text-secondary); text-align: center; grid-column: 1 / -1;">Tidak ada lagu ditemukan.</p>
        }
        else
        {
            @foreach (var song in FilteredSongs)
            {
                <div class="card" style="display: flex; align-items: center; padding: 12px; gap: 12px;">
                    <input type="checkbox" class="song-checkbox" @bind="song.IsSelected" />
                    
                    @if (!string.IsNullOrEmpty(song.CoverUrl))
                    {
                        <img src="@song.CoverUrl" alt="Cover" style="width: 48px; height: 48px; border-radius: 6px; object-fit: cover;" />
                    }

                    <div class="card-info" style="flex-grow: 1; overflow: hidden;">
                        <div class="card-title" style="font-weight: bold; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@song.Title</div>
                        <div class="card-artist" style="color: var(--text-secondary); font-size: 0.88rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@song.Artist</div>
                    </div>
                    
                    <div class="card-actions" style="display: flex; gap: 6px;">
                        <button class="btn-nebula btn-secondary" style="padding: 6px 12px; font-size: 0.85rem;" @onclick="() => DownloadSingle(song)">Download</button>
                        <button class="btn-nebula btn-danger" style="padding: 6px 12px; font-size: 0.85rem;" @onclick="() => DeleteSingle(song.Id)">Hapus</button>
                    </div>
                </div>
            }
        }
    </div>
</main>
