@page "/"
@using Hypen.Web.Components

<PageTitle>Hypen Vault Downloader</PageTitle>

<div style="display: flex; min-height: 100vh; background: #0b0c10; color: #c5c6c7; font-size: 0.78rem;">

    <!-- SIDEBAR -->
    <Sidebar
        @bind-YtUrl="ytUrl"
        @bind-PlaylistUrl="playlistUrl"
        IsLoading="@isLoading"
        OnConvertVideo="ConvertVideo"
        OnConvertPlaylist="ConvertPlaylist" />

    <!-- MAIN CONTENT -->
    <main style="flex-grow: 1; padding: 12px; overflow-x: auto;">

        <!-- STATUS -->
        @if (!string.IsNullOrEmpty(statusMsg))
        {
            <p style="
                color: @(isError ? "#f72585" : "#4cc9f0");
                font-weight: 500;
                font-size: 0.75rem;
                margin-bottom: 6px;">
                @statusMsg
            </p>
        }

        <!-- PROGRESS -->
        @if (isLoading && totalQueueCount > 0)
        {
            <div style="
                background: rgba(255, 255, 255, 0.08);
                border-radius: 4px;
                padding: 2px;
                margin-bottom: 10px;">

                <div style="
                    background: rgba(255, 255, 255, 0.1);
                    border-radius: 3px;
                    overflow: hidden;
                    height: 6px;">

                    <div style="
                        width: @(progressPercentage)%;
                        background: linear-gradient(90deg, #4cc9f0, #7209b7);
                        height: 100%;
                        transition: width 0.3s ease;">
                    </div>

                </div>

                <div style="
                    display: flex;
                    justify-content: space-between;
                    font-size: 0.7rem;
                    color: #c5c6c7;
                    margin-top: 2px;">

                    <span>
                        Progres:
                        @currentProcessedCount /
                        @totalQueueCount Lagu
                    </span>

                    <span>
                        @progressPercentage%
                    </span>

                </div>
            </div>
        }

        <!-- TOP CONTROLS -->
        <div style="
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
            gap: 8px;
            flex-wrap: wrap;">

            <!-- SEARCH -->
            <input
                type="text"
                @bind="searchQuery"
                @bind:event="oninput"
                placeholder="Cari judul lagu atau artis..."
                style="
                    padding: 3px 8px;
                    width: 220px;
                    background: #1f2833;
                    border: 1px solid #45a29e;
                    color: #fff;
                    border-radius: 3px;
                    font-size: 0.75rem;" />

            <!-- ACTIONS -->
            <div style="
                display: flex;
                gap: 6px;
                align-items: center;">

                <!-- SELECT ALL -->
                <label style="
                    font-size: 0.75rem;
                    cursor: pointer;
                    display: flex;
                    align-items: center;
                    gap: 4px;
                    color: #fff;
                    user-select: none;">

                    <input
                        type="checkbox"
                        checked="@IsSelectAllChecked"
                        @onchange="ToggleSelectAll" />

                    Pilih Semua
                </label>

                <!-- DOWNLOAD SELECTED -->
                <button
                    class="btn-nebula btn-secondary"
                    style="
                        padding: 3px 8px;
                        font-size: 0.72rem;"
                    @onclick="DownloadSelected"
                    disabled="@isLoading">

                    Download Selected
                </button>

                <!-- DELETE SELECTED -->
                <button
                    class="btn-nebula btn-danger"
                    style="
                        padding: 3px 8px;
                        font-size: 0.72rem;"
                    @onclick="DeleteSelected"
                    disabled="@isLoading">

                    Hapus Selected
                </button>

            </div>
        </div>

        <!-- SONG TABLE -->
        <div style="
            background: rgba(255, 255, 255, 0.02);
            border-radius: 4px;
            border: 1px solid rgba(255, 255, 255, 0.08);
            overflow: hidden;">

            <table style="
                width: 100%;
                border-collapse: collapse;
                text-align: left;
                font-size: 0.75rem;
                line-height: 1.1;">

                <!-- TABLE HEADER -->
                <thead>
                    <tr style="
                        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
                        background: rgba(255, 255, 255, 0.04);
                        font-size: 0.72rem;
                        text-transform: uppercase;">

                        <!-- SELECT ALL -->
                        <th style="
                            padding: 4px 6px;
                            width: 30px;
                            text-align: center;">

                            <input
                                type="checkbox"
                                checked="@IsSelectAllChecked"
                                @onchange="ToggleSelectAll" />

                        </th>

                        <!-- TITLE -->
                        <th style="padding: 4px 6px;">
                            Judul Lagu
                        </th>

                        <!-- ARTIST -->
                        <th style="padding: 4px 6px;">
                            Artis / Uploader
                        </th>

                        <!-- ACTION -->
                        <th style="
                            padding: 4px 6px;
                            width: 110px;
                            text-align: center;">

                            Aksi

                        </th>

                    </tr>
                </thead>

                <!-- TABLE BODY -->
                <tbody>

                    @if (songs == null)
                    {
                        <tr>
                            <td
                                colspan="4"
                                style="
                                    padding: 10px;
                                    text-align: center;
                                    color: #66fcf1;">

                                Memuat library...

                            </td>
                        </tr>
                    }
                    else if (!FilteredSongs.Any())
                    {
                        <tr>
                            <td
                                colspan="4"
                                style="
                                    padding: 10px;
                                    text-align: center;
                                    color: #c5c6c7;">

                                Tidak ada lagu ditemukan.

                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var song in FilteredSongs)
                        {
                            <tr style="
                                border-bottom: 1px solid rgba(255, 255, 255, 0.03);">

                                <!-- SONG CHECKBOX -->
                                <td style="
                                    padding: 2px 6px;
                                    text-align: center;">

                                    <input
                                        type="checkbox"
                                        @bind="song.IsSelected" />

                                </td>

                                <!-- TITLE -->
                                <td style="
                                    padding: 2px 6px;
                                    font-weight: 500;
                                    color: #fff;
                                    white-space: nowrap;
                                    overflow: hidden;
                                    text-overflow: ellipsis;
                                    max-width: 300px;">

                                    @song.Title

                                </td>

                                <!-- ARTIST -->
                                <td style="
                                    padding: 2px 6px;
                                    color: #a0a5aa;
                                    white-space: nowrap;
                                    overflow: hidden;
                                    text-overflow: ellipsis;
                                    max-width: 200px;">

                                    @song.Artist

                                </td>

                                <!-- ACTIONS -->
                                <td style="
                                    padding: 2px 6px;
                                    text-align: center;">

                                    <!-- DOWNLOAD -->
                                    <button
                                        class="btn-nebula btn-secondary"
                                        style="
                                            padding: 1px 6px;
                                            font-size: 0.68rem;
                                            margin-right: 2px;"
                                        @onclick="() => DownloadSingle(song)"
                                        disabled="@isLoading">

                                        Unduh

                                    </button>

                                    <!-- DELETE -->
                                    <button
                                        class="btn-nebula btn-danger"
                                        style="
                                            padding: 1px 6px;
                                            font-size: 0.68rem;"
                                        @onclick="() => DeleteSingle(song.Id)"
                                        disabled="@isLoading">

                                        Hapus

                                    </button>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>
        </div>

    </main>
</div>
