@page "/"
@inherits IndexBase

<PageTitle>Hypen Vault Player - Crypt Edition</PageTitle>

<main class="main-container">
    <div class="input-group">
        <h3 class="gothic-title">Summon Single Track</h3>
        <div class="input-inline">
            <input type="text" @bind="ytUrl" placeholder="Tempel tautan ritual YouTube..." />
            <button class="btn-gothic" @onclick="ConvertVideo">Add Track</button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(statusMsg))
    {
        <p class="status-msg" style="color: @(isError ? "#8b0000" : "#7b1fa2");">@statusMsg</p>
    }

    <h3 class="gothic-title section-header">Graveyard Library</h3>
    <div class="card-grid">
        @if (songs == null)
        {
            <p style="color: var(--text-secondary); text-align: center;">Membangkitkan arwah lagu...</p>
        }
        else
        {
            @foreach (var song in songs)
            {
                <div class="card">
                    <div class="card-info" style="margin-left: 10px;">
                        <div class="card-title">@song.Title</div>
                        <div class="card-artist">@song.Artist</div>
                    </div>
                    <div class="card-actions">
                        <button class="btn-gothic" @onclick="() => PlaySong(song)">▶</button>
                        <button class="btn-gothic btn-danger" @onclick="() => DeleteSingle(song.Id)">⚰️</button>
                    </div>
                </div>
            }
        }
    </div>
</main>
