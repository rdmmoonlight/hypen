@page "/"

<PageTitle>Hypen Vault Downloader</PageTitle>

<div style="display: flex; min-height: 100vh; background: #0b0c10; color: #c5c6c7;">
    
    <!-- SIDEBAR KIRI: Form Converter / Import -->
    <aside style="width: 320px; background: rgba(255, 255, 255, 0.03); border-right: 1px solid rgba(255, 255, 255, 0.08); padding: 20px; flex-shrink: 0;">
        <h3 class="nebula-title" style="font-size: 1.4rem; margin-bottom: 20px; color: #4cc9f0;">Hypen Downloader</h3>

        <!-- Input Single Video -->
        <div style="margin-bottom: 25px;">
            <label style="font-size: 0.85rem; font-weight: 600; margin-bottom: 8px; display: block;">Import Single Track</label>
            <input type="text" @bind="ytUrl" placeholder="Link video YouTube..." disabled="@isLoading" style="width: 100%; padding: 8px 12px; margin-bottom: 8px; background: #1f2833; border: 1px solid #45a29e; color: #fff; border-radius: 4px;" />
            <button class="btn-nebula" @onclick="ConvertVideo" disabled="@isLoading" style="width: 100%;">
                @(isLoading ? "Memproses..." : "+ Extract Audio")
            </button>
        </div>

        <!-- Input Playlist -->
        <div style="margin-bottom: 25px;">
            <label style="font-size: 0.85rem; font-weight: 600; margin-bottom: 8px; display: block;">Import YouTube Playlist</label>
            <input type="text" @bind="playlistUrl" placeholder="Link playlist YouTube..." disabled="@isLoading" style="width: 100%; padding: 8px 12px; margin-bottom: 8px; background: #1f2833; border: 1px solid #45a29e; color: #fff; border-radius: 4px;" />
            <button class="btn-nebula btn-secondary" @onclick="ConvertPlaylist" disabled="@isLoading" style="width: 100%;">
                @(isLoading ? "Memproses..." : "+ Import Playlist")
            </button>
        </div>

        <p style="font-size: 0.8rem; color: #66fcf1; line-height: 1.4;">
            * Lagu yang diekstrak akan tersimpan di Vault Neon DB dan siap diputar via Aplikasi Mobile Hypen.
        </p>
    </aside>

    <!-- AREA UTAMA: Status, Controls, & List Tulisan (Tabel) -->
    <main style="flex-grow: 1; padding: 25px; overflow-x: auto;">
        
        <!-- Status Notification & Progress Bar -->
        @if (!string.IsNullOrEmpty(statusMsg))
        {
            <p style="color: @(isError ? "#f72585" : "#4cc9f0"); font-weight: 500; margin-bottom: 12px;">@statusMsg</p>
        }

        @if (isLoading && totalQueueCount > 0)
        {
            <div style="background: rgba(255, 255, 255, 0.08); border-radius: 8px; padding: 4px; margin-bottom: 20px;">
                <div style="background: rgba(255, 255, 255, 0.1); border-radius: 6px; overflow: hidden; height: 10px;">
                    <div style="width: @(progressPercentage)%; background: linear-gradient(90deg, #4cc9f0, #7209b7); height: 100%; transition: width 0.3s ease;"></div>
                </div>
                <div style="display: flex; justify-content: space-between; font-size: 0.8rem; color: #c5c6c7; margin-top: 4px;">
                    <span>Progres: @currentProcessedCount / @totalQueueCount Lagu</span>
                    <span>@progressPercentage%</span>
                </div>
            </div>
        }

        <!-- Top Controls & Filter Bar -->
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; gap: 15px; flex-wrap: wrap;">
            <input type="text" @bind="searchQuery" @bind:event="oninput" placeholder="Cari judul lagu atau artis..." style="padding: 8px 12px; width: 280px; background: #1f2833; border: 1px solid #45a29e; color: #fff; border-radius: 4px;" />
            
            <div style="display: flex; gap: 10px; align-items: center;">
                <label style="font-size: 0.9rem; cursor: pointer; display: flex; align-items: center; gap: 6px;">
                    <input type="checkbox" @onchange="ToggleSelectAll" /> Pilih Semua
                </label>
                <button class="btn-nebula btn-secondary" @onclick="DownloadSelected" disabled="@isLoading">Download Selected</button>
                <button class="btn-nebula btn-danger" @onclick="DeleteSelected" disabled="@isLoading">Hapus Selected</button>
            </div>
        </div>

        <!-- LIST LAGU: Tabel Ringkas (Tanpa Thumbnail) -->
        <div style="background: rgba(255, 255, 255, 0.02); border-radius: 8px; border: 1px solid rgba(255, 255, 255, 0.08); overflow: hidden;">
            <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem;">
                <thead>
                    <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.1); background: rgba(255, 255, 255, 0.03);">
                        <th style="padding: 12px; width: 40px; text-align: center;">#</th>
                        <th style="padding: 12px;">Judul Lagu</th>
                        <th style="padding: 12px;">Artis / Uploader</th>
                        <th style="padding: 12px; width: 180px; text-align: center;">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    @if (FilteredSongs == null)
                    {
                        <tr>
                            <td colspan="4" style="padding: 20px; text-align: center; color: #66fcf1;">Memuat library...</td>
                        </tr>
                    }
                    else if (!FilteredSongs.Any())
                    {
                        <tr>
                            <td colspan="4" style="padding: 20px; text-align: center; color: #c5c6c7;">Tidak ada lagu ditemukan.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var song in FilteredSongs)
                        {
                            <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.05);">
                                <td style="padding: 10px; text-align: center;">
                                    <input type="checkbox" @bind="song.IsSelected" />
                                </td>
                                <td style="padding: 10px; font-weight: 600; color: #fff;">@song.Title</td>
                                <td style="padding: 10px; color: #c5c6c7;">@song.Artist</td>
                                <td style="padding: 10px; text-align: center;">
                                    <button class="btn-nebula btn-secondary" style="padding: 4px 10px; font-size: 0.8rem; margin-right: 4px;" @onclick="() => DownloadSingle(song)" disabled="@isLoading">Unduh</button>
                                    <button class="btn-nebula btn-danger" style="padding: 4px 10px; font-size: 0.8rem;" @onclick="() => DeleteSingle(song.Id)" disabled="@isLoading">Hapus</button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </main>
</div>
