@page "/"

<PageTitle>Hypen Vault Player</PageTitle>

<main class="main-container">
    <!-- Integration Header Bar (Last.fm Status) -->
    <div class="integration-bar input-group" style="display: flex; align-items: center; justify-content: space-between; background: rgba(255, 255, 255, 0.03); padding: 10px 15px; border-radius: 8px; margin-bottom: 20px;">
        <div style="display: flex; align-items: center; gap: 10px;">
            <span style="font-weight: 600; color: #ff0000;">Last.fm:</span>
            @if (!string.IsNullOrEmpty(lastFmSessionKey))
            {
                <span style="color: #4cc9f0; font-size: 0.9em;">Connected (Scrobbling Active)</span>
            }
            else
            {
                <span style="color: var(--text-secondary); font-size: 0.9em;">Not Connected</span>
            }
        </div>
        <div>
            @if (string.IsNullOrEmpty(lastFmSessionKey))
            {
                <button class="btn-nebula btn-secondary" style="padding: 5px 12px; font-size: 0.85em;" @onclick="ConnectLastFm">Connect Last.fm</button>
            }
        </div>
    </div>

    <!-- Input Track Single -->
    <div class="input-group">
        <h3 class="nebula-title">Import Single Track</h3>
        <div class="input-inline">
            <input type="text" @bind="ytUrl" placeholder="Tempel link video YouTube..." />
            <button class="btn-nebula" @onclick="ConvertVideo">Add Track</button>
        </div>
    </div>

    <!-- Input Playlist YouTube -->
    <div class="input-group">
        <h3 class="nebula-title">Import YouTube Playlist</h3>
        <div class="input-inline">
            <input type="text" @bind="playlistUrl" placeholder="Tempel link playlist YouTube..." />
            <button class="btn-nebula btn-secondary" @onclick="ConvertPlaylist">Import Playlist</button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(statusMsg))
    {
        <p class="status-msg" style="color: @(isError ? "#f72585" : "#4cc9f0");">@statusMsg</p>
    }

    <!-- Controls Bar -->
    <div class="controls-bar input-group">
        <div class="input-inline" style="margin-bottom: 10px;">
            <input type="text" @bind="searchQuery" @bind:event="oninput" placeholder="Cari judul lagu atau artis..." />
        </div>
        <div class="action-buttons-inline">
            <label><input type="checkbox" @onchange="ToggleSelectAll" /> Pilih Semua</label>
            <button class="btn-nebula btn-secondary" @onclick="DownloadSelected">Download Selected</button>
            <button class="btn-nebula btn-danger" @onclick="DeleteSelected">Hapus Selected</button>
        </div>
    </div>

    <h3 class="nebula-title section-header">Library Collection</h3>
    <div class="card-grid">
        @if (FilteredSongs == null)
        {
            <p style="color: var(--text-secondary); text-align: center;">Memuat library...</p>
        }
        else if (!FilteredSongs.Any())
        {
            <p style="color: var(--text-secondary); text-align: center;">Tidak ada lagu ditemukan.</p>
        }
        else
        {
            @foreach (var song in FilteredSongs)
            {
                <div class="card">
                    <input type="checkbox" class="song-checkbox" @bind="song.IsSelected" />
                    
                    <div class="card-info" style="margin-left: 10px; flex-grow: 1;">
                        <div class="card-title" style="font-weight: bold;">@song.Title</div>
                        <div class="card-artist" style="color: var(--text-secondary); font-size: 0.9em;">@song.Artist</div>
                    </div>
                    
                    <div class="card-actions">
                        <button class="btn-nebula" @onclick="() => PlaySong(song)">Play</button>
                        <button class="btn-nebula btn-secondary" @onclick="() => DownloadSingle(song)">Download</button>
                        <button class="btn-nebula btn-danger" @onclick="() => DeleteSingle(song.Id)">Hapus</button>
                    </div>
                </div>
            }
        }
    </div>
</main>

<!-- Player Bar -->
<div class="player-bar" style="position: fixed; bottom: 0; left: 0; right: 0; background: rgba(15, 15, 26, 0.95); backdrop-filter: blur(10px); padding: 15px 20px; display: flex; align-items: center; justify-content: space-between; border-top: 1px solid rgba(255, 255, 255, 0.1); z-index: 1000;">
    <div class="now-playing" style="font-weight: 500; color: #4cc9f0;">
        @(currentPlayingTrack ?? "No track selected...")
    </div>
    <div>
        @if (!string.IsNullOrEmpty(currentAudioUrl))
        {
            <audio id="audioPlayer" src="@currentAudioUrl" controls autoplay style="height: 35px;"></audio>
        }
        else
        {
            <audio id="audioPlayer" controls disabled style="height: 35px; opacity: 0.5;"></audio>
        }
    </div>
</div>
