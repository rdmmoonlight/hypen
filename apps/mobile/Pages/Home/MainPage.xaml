<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="HypenMaui.Pages.Home.MainPage"
             BackgroundColor="#0b0914">

    <Grid RowDefinitions="Auto, Auto, *, Auto">
        
        <!-- Header & Input Group -->
        <VerticalStackLayout Grid.Row="0" Padding="16" Spacing="12">
            <Label Text="HYPEN VAULT" FontFamily="Orbitron" FontSize="22" FontAttributes="Bold" TextColor="#4cc9f0" HorizontalOptions="Center"/>
            
            <!-- Search & Filter Bar -->
            <Entry x:Name="SearchInput" Placeholder="🔍 Cari lagu atau artis..." 
                   TextChanged="OnSearchTextChanged"
                   PlaceholderColor="#6c757d" TextColor="White" BackgroundColor="#141226"/>

            <!-- Action Bar -->
            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                <Button Text="📥 Download Selected" Clicked="OnDownloadSelectedClicked" BackgroundColor="#4cc9f0" TextColor="#0b0914" FontAttributes="Bold"/>
                <Button Text="🗑️ Delete Selected" Clicked="OnDeleteSelectedClicked" BackgroundColor="#dc3545" TextColor="White" FontAttributes="Bold"/>
            </HorizontalStackLayout>
            
            <Label x:Name="StatusLabel" Text="" TextColor="#4cc9f0" HorizontalOptions="Center" FontSize="12"/>

            <!-- SYSTEM UPDATES CARD -->
            <Border BackgroundColor="#141226"
                    Stroke="#2a274c"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="16">
                <Border.Shadow>
                    <Shadow Brush="#000000" Offset="0,4" Radius="10" Opacity="0.2" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="12">
                    <Label Text="SYSTEM SETTINGS"
                           TextColor="#a0a5c0"
                           FontSize="11"
                           FontAttributes="Bold"
                           CharacterSpacing="0.8" />

                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Auto-Update from GitHub"
                                   TextColor="White"
                                   FontSize="13"
                                   FontAttributes="Bold" />
                            <Label Text="Perbarui aplikasi secara otomatis"
                                   TextColor="#6c757d"
                                   FontSize="10" />
                        </VerticalStackLayout>
                        <Switch x:Name="AutoUpdateSwitch"
                                Grid.Column="1"
                                OnColor="#4cc9f0"
                                ThumbColor="White"
                                Toggled="OnAutoUpdateToggled" />
                    </Grid>

                    <Button Text="Check for Updates"
                            BackgroundColor="#2a274c"
                            TextColor="#4cc9f0"
                            FontAttributes="Bold"
                            FontSize="12"
                            CornerRadius="10"
                            HeightRequest="40"
                            Clicked="OnCheckUpdateManualClicked" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>

        <Label Grid.Row="1" Text="Library Collection" FontSize="18" FontAttributes="Bold" TextColor="White" Margin="16,0,16,8"/>

        <!-- Collection View (List Lagu) -->
        <RefreshView Grid.Row="2" x:Name="RefreshControl" Refreshing="OnRefreshTriggered">
            <CollectionView x:Name="SongsCollectionView" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BackgroundColor="#141226" BorderColor="#2a274c" CornerRadius="8" Margin="16,4" Padding="10">
                            <Grid ColumnDefinitions="Auto, Auto, *, Auto">
                                <!-- Checkbox Multi-Select -->
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalOptions="Center"/>
                                
                                <!-- Cover Thumbnail -->
                                <Image Grid.Column="1" Source="{Binding Cover}" WidthRequest="50" HeightRequest="50" Aspect="AspectFill" Margin="8,0"/>
                                
                                <!-- Info Lagu -->
                                <VerticalStackLayout Grid.Column="2" VerticalOptions="Center">
                                    <Label Text="{Binding Title}" TextColor="White" FontAttributes="Bold" LineBreakMode="TailTruncation"/>
                                    <Label Text="{Binding Artist}" TextColor="#a0a5c0" FontSize="12" LineBreakMode="TailTruncation"/>
                                </VerticalStackLayout>
                                
                                <!-- Tombol Aksi Single -->
                                <HorizontalStackLayout Grid.Column="3" Spacing="4" VerticalOptions="Center">
                                    <Button Text="▶" Clicked="OnPlaySingleClicked" CommandParameter="{Binding .}" BackgroundColor="#4cc9f0" TextColor="#0b0914" HeightRequest="36" WidthRequest="36" Padding="0"/>
                                    <Button Text="📥" Clicked="OnDownloadSingleClicked" CommandParameter="{Binding .}" BackgroundColor="#2a274c" TextColor="White" HeightRequest="36" WidthRequest="36" Padding="0"/>
                                    <Button Text="🗑️" Clicked="OnDeleteSingleClicked" CommandParameter="{Binding .}" BackgroundColor="#4a0000" TextColor="White" HeightRequest="36" WidthRequest="36" Padding="0"/>
                                </HorizontalStackLayout>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- Player Bar di Bawah -->
        <Frame Grid.Row="3" BackgroundColor="#141226" BorderColor="#4cc9f0" Padding="12" CornerRadius="0">
            <VerticalStackLayout Spacing="6">
                <Label x:Name="NowPlayingLabel" Text="No track selected..." TextColor="#4cc9f0" FontAttributes="Bold" HorizontalOptions="Center" LineBreakMode="TailTruncation"/>
                <toolkit:MediaElement x:Name="AudioPlayer" ShouldShowPlaybackControls="True" HeightRequest="50"/>
            </VerticalStackLayout>
        </Frame>
    </Grid>
</ContentPage>
