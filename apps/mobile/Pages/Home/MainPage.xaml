<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="HypenMaui.Pages.Home.MainPage"
             BackgroundColor="#0b0914">

    <Grid RowDefinitions="Auto, Auto, *, Auto">

        <!-- MediaElement fisik TUNGGAL untuk seluruh app. Disembunyikan karena semua kontrol
             visual playback ada di mini bar (di bawah) dan Now Playing Page (custom UI). -->
        <toolkit:MediaElement x:Name="AudioPlayer" WidthRequest="0" HeightRequest="0" IsVisible="False" />

        <!-- Header & Input Group -->
        <VerticalStackLayout Grid.Row="0" Padding="16" Spacing="12">
            <!-- Search & Filter Bar -->
            <Entry x:Name="SearchInput" Placeholder="🔍 Cari lagu atau artis..." 
                   TextChanged="OnSearchTextChanged"
                   PlaceholderColor="#6c757d" TextColor="White" BackgroundColor="#141226"/>

            <!-- Action Bar -->
            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                <Button Text="🔄 Scan Ulang Library" Clicked="OnRescanClicked" BackgroundColor="#4cc9f0" TextColor="#0b0914" FontAttributes="Bold"/>
            </HorizontalStackLayout>
            
            <Label x:Name="StatusLabel" Text="" TextColor="#4cc9f0" HorizontalOptions="Center" FontSize="12"/>
        </VerticalStackLayout>

        <Label Grid.Row="1" Text="Library Collection" FontSize="18" FontAttributes="Bold" TextColor="White" Margin="16,0,16,8"/>

        <!-- Collection View (List Lagu) -->
        <RefreshView Grid.Row="2" x:Name="RefreshControl" Refreshing="OnRefreshTriggered">
            <CollectionView x:Name="SongsCollectionView" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="#141226" Stroke="#2a274c" StrokeShape="RoundRectangle8" Margin="16,4" Padding="10">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <!-- Cover Thumbnail (Album Art Lokal) -->
                                <Image Grid.Column="0" Source="{Binding Cover}" WidthRequest="50" HeightRequest="50" Aspect="AspectFill" Margin="0,0,8,0"/>

                                <!-- Info Lagu -->
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                    <Label Text="{Binding Title}" TextColor="White" FontAttributes="Bold" LineBreakMode="TailTruncation"/>
                                    <Label Text="{Binding Artist}" TextColor="#a0a5c0" FontSize="12" LineBreakMode="TailTruncation"/>
                                </VerticalStackLayout>

                                <!-- Tombol Play -->
                                <Button Grid.Column="2" Text="▶" Clicked="OnPlaySingleClicked" CommandParameter="{Binding .}" BackgroundColor="#4cc9f0" TextColor="#0b0914" HeightRequest="36" WidthRequest="36" Padding="0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- Mini Player Bar: ringkasan elegan, tap untuk buka Now Playing Page -->
        <Border x:Name="MiniPlayerBar" Grid.Row="3" IsVisible="False" BackgroundColor="#141226" Stroke="#2a274c"
               Padding="10,8" StrokeShape="RoundRectangle0" HasShadow="True">
            <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMiniBarTapped" />
                </Grid.GestureRecognizers>

                <Image Grid.Column="0" x:Name="MiniCover" WidthRequest="42" HeightRequest="42"
                       Aspect="AspectFill" Margin="0,0,10,0">
                    <Image.Clip>
                        <RoundRectangleGeometry StrokeShape="RoundRectangle6" Rect="0,0,42,42" />
                    </Image.Clip>
                </Image>

                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label x:Name="MiniTitle" Text="No track selected" TextColor="White" FontAttributes="Bold"
                           FontSize="13" LineBreakMode="TailTruncation"/>
                    <Label x:Name="MiniArtist" Text="" TextColor="#a0a5c0" FontSize="11" LineBreakMode="TailTruncation"/>
                </VerticalStackLayout>

                <Button Grid.Column="2" x:Name="MiniPlayPauseButton" Text="▶" Clicked="OnMiniPlayPauseClicked"
                        BackgroundColor="Transparent" TextColor="#4cc9f0" FontSize="20" WidthRequest="42" Padding="0"/>

                <Button Grid.Column="3" Text="⏭" Clicked="OnMiniNextClicked"
                        BackgroundColor="Transparent" TextColor="#a0a5c0" FontSize="18" WidthRequest="38" Padding="0"/>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
