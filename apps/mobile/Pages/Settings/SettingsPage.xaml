<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HypenMaui.Pages.Settings.SettingsPage"
             Title="Settings"
             BackgroundColor="#0B0914">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style TargetType="Border">
                <Setter Property="BackgroundColor" Value="#141226" />
                <Setter Property="Stroke" Value="#282240" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="StrokeShape" Value="RoundRectangle 12" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="White" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="20">

            <Label Text="Pengaturan" FontSize="24" FontAttributes="Bold" TextColor="White" />

            <!-- GOOGLE DRIVE VAULT -->
            <Border>
                <VerticalStackLayout Spacing="12">
                    <Label Text="📁 Google Drive Vault" FontSize="16" FontAttributes="Bold" TextColor="#4CC9F0" />
                    <Label x:Name="GoogleDriveStatusLabel" Text="Status: Belum Terhubung" FontSize="13" TextColor="#A0A0B0" />
                    <Button x:Name="GoogleDriveAuthButton" Text="Hubungkan Google Drive" BackgroundColor="#8A5CF5" Clicked="OnGoogleDriveAuthClicked" />
                </VerticalStackLayout>
            </Border>

            <!-- TERABOX VAULT -->
            <Border>
                <VerticalStackLayout Spacing="12">
                    <Label Text="📦 TeraBox Vault" FontSize="16" FontAttributes="Bold" TextColor="#4CC9F0" />
                    <Label x:Name="TeraBoxStatusLabel" Text="Status: Belum Terhubung" FontSize="13" TextColor="#A0A0B0" />
                    <Button x:Name="TeraBoxAuthButton" Text="Hubungkan TeraBox Token" BackgroundColor="#8A5CF5" Clicked="OnTeraBoxAuthClicked" />
                </VerticalStackLayout>
            </Border>

            <!-- LAST.FM INTEGRATION -->
            <Border>
                <VerticalStackLayout Spacing="12">
                    <Label Text="🎵 Last.fm Scrobbler" FontSize="16" FontAttributes="Bold" TextColor="#8A5CF5" />
                    <Label x:Name="LastFmStatusLabel" Text="Status: Belum Terhubung" FontSize="13" TextColor="#A0A0B0" />
                    <Button x:Name="LastFmAuthButton" Text="Hubungkan Akun Last.fm" BackgroundColor="#8A5CF5" Clicked="OnLastFmAuthClicked" />
                </VerticalStackLayout>
            </Border>

            <!-- AUTO UPDATE CONTROL -->
            <Border>
                <VerticalStackLayout Spacing="12">
                    <Label Text="🔄 Pembaruan Aplikasi" FontSize="16" FontAttributes="Bold" TextColor="#8A5CF5" />
                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Auto-Update Otomatis" FontSize="14" TextColor="White" />
                            <Label Text="Cek &amp; pasang pembaruan otomatis saat startup" FontSize="11" TextColor="#6C6C80" />
                        </VerticalStackLayout>
                        <Switch x:Name="AutoUpdateSwitch" Grid.Column="1" OnColor="#8A5CF5" Toggled="OnAutoUpdateToggled" />
                    </Grid>
                    <Button Text="Cek Pembaruan Manual" BackgroundColor="#282240" Clicked="OnCheckUpdateManualClicked" />
                </VerticalStackLayout>
            </Border>

            <!-- APP INFO -->
            <VerticalStackLayout HorizontalOptions="Center" Spacing="4" Margin="0,20,0,0">
                <Label Text="Hypen Vault" FontSize="14" FontAttributes="Bold" TextColor="#8A5CF5" HorizontalOptions="Center" />
                <Label Text="v1.0.0 • Personal Cloud &amp; Local Music Player" FontSize="11" TextColor="#6C6C80" HorizontalOptions="Center" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
