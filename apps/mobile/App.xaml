<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="HypenMaui.App"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:HypenMaui">

    <Application.Resources>
        <ResourceDictionary>
            <!-- Definisi Warna Langsung -->
            <Color x:Key="PrimaryBackground">#F8F9FA</Color>
            <Color x:Key="Primary">#512BD4</Color>
            <Color x:Key="Secondary">#DFD8F7</Color>

            <!-- Brush pendukung jika XAML menggunakan SolidColorBrush -->
            <SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="{StaticResource PrimaryBackground}" />
        </ResourceDictionary>
    </Application.Resources>
    
</Application>
