<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Primary & Brand Colors -->
    <Color x:Key="Primary">#512BD4</Color>
    <Color x:Key="Secondary">#DFD8F7</Color>
    <Color x:Key="Tertiary">#2B0B98</Color>
    
    <!-- Accent Colors -->
    <Color x:Key="AccentCyan">#00D2FF</Color>
    <Color x:Key="AccentBlue">#007AFF</Color>
    <Color x:Key="AccentPurple">#7000FF</Color>
    <Color x:Key="AccentPink">#FF2D55</Color>

    <!-- Background Colors -->
    <Color x:Key="PrimaryBackground">#F8F9FA</Color>
    <Color x:Key="CardBackground">#FFFFFF</Color>

    <!-- Status Colors -->
    <Color x:Key="Success">#34C759</Color>
    <Color x:Key="Warning">#FF9500</Color>
    <Color x:Key="Error">#FF3B30</Color>

    <!-- Text & Border Colors -->
    <Color x:Key="PrimaryText">#1F1F1F</Color>
    <Color x:Key="SecondaryText">#6E6E6E</Color>
    <Color x:Key="BorderColor">#E1E1E1</Color>

    <!-- Neutral Colors (Grayscale) -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray900">#1F1F1F</Color>

    <!-- SolidColorBrushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackground}" />
    <SolidColorBrush x:Key="AccentCyanBrush" Color="{StaticResource AccentCyan}" />
</ResourceDictionary>
