<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- targetSdkVersion dipatok eksplisit ke 35 (dalam rentang aman 33-35 yang disarankan Play Store) -->
		<TargetFrameworks>net10.0-android35.0</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>HypenMaui</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Display name -->
		<ApplicationTitle>Hypen Vault</ApplicationTitle>
		<!-- App Identifier -->
		<ApplicationId>com.hypen.vault</ApplicationId>

		<!-- App Version -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

	</PropertyGroup>

	<!--
		Signing Release APK dengan keystore permanen.
		Nilai AndroidSigningKeyStore/Alias/Pass diisi via -p: dari CI (GitHub Secrets)
		atau dari file .csproj.user lokal. WAJIB konsisten di setiap build Release,
		kalau tidak update APK akan gagal ("App not installed" - signature mismatch).
	-->
	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<AndroidKeyStore>true</AndroidKeyStore>
		<AndroidSigningKeyStore Condition="'$(AndroidSigningKeyStore)'==''">hypen-release.keystore</AndroidSigningKeyStore>
		<AndroidSigningKeyAlias Condition="'$(AndroidSigningKeyAlias)'==''">hypen-release-key</AndroidSigningKeyAlias>
	</PropertyGroup>

	<PropertyGroup>		<!-- Target Android 9.0 (API 28) Minimum -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">28.0</SupportedOSPlatformVersion>

		<!--
			CATATAN KEAMANAN: Last.fm API Key/Secret dan Google Client Id/Secret TIDAK LAGI
			diinjeksikan sebagai AssemblyMetadata. AssemblyMetadata tersimpan sebagai string
			plaintext di dalam DLL hasil build dan bisa diekstrak langsung dari APK release
			(ildasm/strings/apktool) tanpa perlu root. Nilai compile-time (LASTFM_KEY,
			GOOGLE_CLIENT_ID) tetap disuntik CI lewat DefineConstants seperti sebelumnya untuk
			kebutuhan compile-time constant di service masing-masing; SEMUA token sesi milik
			pengguna (session key, access token, cookie) sekarang wajib lewat SecureStorage
			(lihat Services/SecureTokenStore.cs), bukan Preferences/AssemblyMetadata.
		-->

		<!-- Abaikan warning/error konflik batasan versi dependensi NuGet -->
		<NoWarn>$(NoWarn);NU1605;NU1107;NU1608;NU1603;NU1701</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<!-- 
		  APP ICON SETUP (Optimasi Launcher ColorOS Oppo)
		  - ForegroundScale="0.65": Memberikan safe-zone 65% agar logo di dalam ikon 
		    tidak terpotong oleh shape masking (squircle/lingkaran) bawaan Oppo.
		-->
		<MauiIcon Include="Resources\AppIcon\appicon.png" 
				  Color="#0b0914" 
				  ForegroundScale="0.65" />

		<!-- 
		  SPLASH SCREEN SETUP (Optimasi Layar HD+ 720x1520 Oppo A12)
		  - Color="#0b0914": Disamakan dengan warna ikon agar tidak flicker/blink warna saat app dibuka.
		  - BaseSize="128,128": Ukuran dp ideal agar logo berada tepat di tengah & proporsional.
		  - Resize="true": Scaling otomatis antar tingkat kerapatan layar (DPI).
		-->
		<MauiSplashScreen Include="Resources\Splash\splash.png" 
						  Color="#0b0914" 
						  BaseSize="400,400" 
						  Resize="true" />

		<!-- Custom Assets & Fonts -->
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<!-- Paket Utama .NET MAUI -->
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.60" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.60" />
		<PackageReference Include="Microsoft.Maui.Core" Version="10.0.60" />
		<PackageReference Include="Microsoft.Maui.Essentials" Version="10.0.60" />

		<!-- Community Toolkit & MediaElement -->
		<PackageReference Include="CommunityToolkit.Maui" Version="10.0.0" />
		<PackageReference Include="CommunityToolkit.Maui.MediaElement" Version="10.0.0" />
	</ItemGroup>

</Project>
