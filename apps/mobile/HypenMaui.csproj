<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>HypenMaui</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Display name -->
		<ApplicationTitle>Hypen Vault</ApplicationTitle>
		<!-- App Identifier -->
		<ApplicationId>com.hypen.vault</ApplicationId>

		<!-- App Version (Di-override secara dinamis oleh GitHub Actions saat Release) -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- Wajib Target Android 9.0 (API 28) Minimum -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">28.0</SupportedOSPlatformVersion>

		<!-- Abaikan error konflik batasan versi dependensi NuGet (Termasuk NU1605) -->
		<NoWarn>$(NoWarn);NU1605;NU1107;NU1608;NU1603;NU1701</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon & Splash Screen Setup -->
		<MauiIcon Include="Resources\AppIcon\appicon.png" Color="#0b0914" />
		<MauiSplashScreen Include="Resources\Splash\splash.png" Color="#000000" BaseSize="213,461" />

		<!-- Custom Assets & Fonts -->
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<!-- Paket Utama .NET MAUI -->
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.60" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.60" />
		<PackageReference Include="Microsoft.Maui.Core" Version="10.0.60" />
		<PackageReference Include="Microsoft.Maui.Essentials" Version="10.0.60" />

		<!-- Community Toolkit & MediaElement -->
		<PackageReference Include="CommunityToolkit.Maui" Version="10.0.0" />
		<PackageReference Include="CommunityToolkit.Maui.MediaElement" Version="10.0.0" />
	</ItemGroup>

</Project>
