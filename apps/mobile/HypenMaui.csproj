<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Target Framework sesuai standar .NET 10 (diperlukan untuk kompilasi) -->
		<TargetFrameworks>net10.0-android36.1</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>HypenMaui</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Identity & Metadata App -->
		<ApplicationTitle>Hypen Vault</ApplicationTitle>
		<ApplicationId>com.hypen.vault</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- Batas Minimum OS versi Android 9.0 (API 28) -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">28.0</SupportedOSPlatformVersion>
		
		<NoWarn>$(NoWarn);NU1605;NU1107;NU1608;NU1603;NU1701</NoWarn>
	</PropertyGroup>

	<!-- Injeksi Key via CI/CD -->
	<PropertyGroup Condition="'$(LASTFM_KEY)' != ''">
		<DefineConstants>$(DefineConstants);LASTFM_KEY;LASTFM_SECRET</DefineConstants>
	</PropertyGroup>

	<!-- Signing Release APK -->
	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<AndroidKeyStore>true</AndroidKeyStore>
		<AndroidSigningKeyStore Condition="'$(AndroidSigningKeyStore)'==''">hypen-release.keystore</AndroidSigningKeyStore>
		<AndroidSigningKeyAlias Condition="'$(AndroidSigningKeyAlias)'==''">hypen-release-key</AndroidSigningKeyAlias>
	</PropertyGroup>

	<!-- Assets, Icons & Fonts -->
	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.png" Color="#0b0914" ForegroundScale="0.65" />
		<MauiSplashScreen Include="Resources\Splash\splash.png" Color="#0b0914" BaseSize="128,128" Resize="true" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<!-- Dependencies -->
	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.60" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.60" />
		<PackageReference Include="Microsoft.Maui.Core" Version="10.0.60" />
		<PackageReference Include="Microsoft.Maui.Essentials" Version="10.0.60" />
		<PackageReference Include="CommunityToolkit.Maui" Version="10.0.0" />
		<PackageReference Include="CommunityToolkit.Maui.MediaElement" Version="10.0.0" />
	</ItemGroup>

</Project>
