<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- targetSdkVersion dipatok eksplisit ke 35 (dalam rentang aman 33-35 yang disarankan Play Store) -->
		<TargetFrameworks>net10.0-android35.0</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>HypenMaui</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Display name -->
		<ApplicationTitle>Hypen Vault</ApplicationTitle>
		<!-- App Identifier -->
		<ApplicationId>com.hypen.vault</ApplicationId>

		<!-- App Version -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

	</PropertyGroup>

	<!--
		Signing Release APK dengan keystore permanen.
		Nilai AndroidSigningKeyStore/Alias/Pass diisi via -p: dari CI (GitHub Secrets)
		atau dari file .csproj.user lokal. WAJIB konsisten di setiap build Release,
		kalau tidak update APK akan gagal ("App not installed" - signature mismatch).
	-->
	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<AndroidKeyStore>true</AndroidKeyStore>
		<AndroidSigningKeyStore Condition="'$(AndroidSigningKeyStore)'==''">hypen-release.keystore</AndroidSigningKeyStore>
		<AndroidSigningKeyAlias Condition="'$(AndroidSigningKeyAlias)'==''">hypen-release-key</AndroidSigningKeyAlias>
	</PropertyGroup>

	<PropertyGroup>		<!-- Target Android 9.0 (API 28) Minimum -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">28.0</SupportedOSPlatformVersion>
		<NoWarn>$(NoWarn);NU1605;NU1107;NU1608;NU1603;NU1701</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.png" 
				  Color="#0b0914" 
				  ForegroundScale="0.65" />
		<MauiSplashScreen Include="Resources\Splash\splash.png" 
                  Color="#000000" 
                  BaseSize="128,128" 
                  Resize="true" />

		<!-- Custom Assets & Fonts -->
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.60" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.60" />
		<PackageReference Include="Microsoft.Maui.Core" Version="10.0.60" />
		<PackageReference Include="Microsoft.Maui.Essentials" Version="10.0.60" />
		<PackageReference Include="CommunityToolkit.Maui" Version="10.0.0" />
		<PackageReference Include="CommunityToolkit.Maui.MediaElement" Version="10.0.0" />
	</ItemGroup>

</Project>
