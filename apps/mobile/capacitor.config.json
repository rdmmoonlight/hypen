{
  "appId": "com.hypen.vault",
  "appName": "Hypen Vault",
  "webDir": "www",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "allowNavigation": [
      "hypen-0s65.onrender.com",
      "*.onrender.com",
      "*.ytimg.com",
      "*.googlevideo.com"
    ]
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    }
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": true
  }
}
