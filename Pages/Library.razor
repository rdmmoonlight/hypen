@page "/library"
@page "/"
@using Hypen.Web.Models
@using Hypen.Web.Services
@inject ISongService SongService
@inject IJSRuntime JS

@* 
  Silakan inject service pemutar global Anda di sini nantinya. 
  Contoh: @inject IPlayerService PlayerService 
*@

<PageTitle>Hypen Music Vault Library</PageTitle>

<div style="padding: 24px; background: #0b0c10; color: #c5c6c7; min-height: 100vh; font-family: system-ui, -apple-system, sans-serif;">

    @if (!string.IsNullOrEmpty(statusMsg))
    {
        <div style="background: @(isError ? "rgba(247, 37, 133, 0.1)" : "rgba(76, 201, 240, 0.1)"); 
                    border-left: 4px solid @(isError ? "#f72585" : "#4cc9f0"); 
                    padding: 8px 12px; margin-bottom: 16px; border-radius: 4px;">
            <p style="color: @(isError ? "#ff4d6d" : "#4cc9f0"); font-weight: 500; font-size: 0.8rem; margin: 0;">
                @statusMsg
            </p>
        </div>
    }

    <!-- PLAYLIST HEADER INFO -->
    <div style="display: flex; align-items: flex-end; gap: 20px; margin-bottom: 24px; padding-bottom: 24px; border-bottom: 1px solid rgba(255,255,255,0.05);">
        <div style="width: 140px; height: 140px; background: linear-gradient(135deg, #1f2833, #45a29e); border-radius: 8px; display: flex; align-items: center; justify-content: center; box-shadow: 0 8px 24px rgba(0,0,0,0.4);">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 18V5l12-2v13"></path>
                <circle cx="6" cy="18" r="3"></circle>
                <circle cx="18" cy="16" r="3"></circle>
            </svg>
        </div>
        <div>
            <span style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1.5px; font-weight: 600;">Playlist Permanen</span>
            <h1 style="font-size: 2.5rem; color: #fff; margin: 8px 0; font-weight: 800; letter-spacing: -0.5px;">My Vault Library</h1>
            <div style="font-size: 0.85rem; color: #a0a5aa; display: flex; align-items: center; gap: 8px;">
                <span style="color: #fff; font-weight: 500;">Ghe Entertainment</span>
                <span>•</span>
                <span>@songs.Count Lagu</span>
            </div>
        </div>
    </div>

    <!-- BATCH QUEUE PROGRESS BAR -->
    @if (isLoading && totalQueueCount > 0)
    {
        <div style="background: rgba(255, 255, 255, 0.05); border-radius: 6px; padding: 12px; margin-bottom: 16px;">
            <div style="background: rgba(0, 0, 0, 0.5); border-radius: 4px; overflow: hidden; height: 8px; position: relative;">
                <div style="width: @(progressPercentage)%; background: linear-gradient(90deg, #4cc9f0, #45a29e); height: 100%; transition: width 0.3s ease;"></div>
            </div>
            <div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: #c5c6c7; margin-top: 8px;">
                <span>Progres Antrean Unduhan: @currentProcessedCount / @totalQueueCount Lagu</span>
                <span style="font-weight: bold; color: #fff;">@progressPercentage%</span>
            </div>
        </div>
    }

    <!-- PLAYLIST CONTROLS & TOOLBAR -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; flex-wrap: wrap; gap: 12px;">
        
        <!-- Playback Actions -->
        <div style="display: flex; gap: 12px; align-items: center;">
            <button style="background: #4cc9f0; color: #000; border: none; border-radius: 50%; width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: transform 0.2s;" @onclick="PlayAll" title="Play All">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            </button>
            <button class="btn-nebula btn-secondary" style="padding: 6px 12px; font-size: 0.8rem; background: transparent; border: 1px solid rgba(255,255,255,0.2); color: #fff; border-radius: 20px;" @onclick="AddSelectedToQueue" disabled="@isLoading">
                + Tambah Pilihan ke Antrean
            </button>
        </div>

        <!-- Management Actions -->
        <div style="display: flex; gap: 10px; align-items: center;">
            <input type="text"
                   @bind="searchQuery"
                   @bind:event="oninput"
                   placeholder="Cari dalam playlist..."
                   style="padding: 6px 12px; width: 220px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: #fff; border-radius: 20px; font-size: 0.8rem; outline: none;" />

            <button class="btn-nebula btn-secondary" style="padding: 6px 12px; font-size: 0.75rem; border-radius: 4px;" @onclick="DownloadSelected" disabled="@isLoading">
                Unduh Pilihan
            </button>
            <button class="btn-nebula btn-danger" style="padding: 6px 12px; font-size: 0.75rem; border-radius: 4px; background: rgba(247, 37, 133, 0.2); border: 1px solid rgba(247, 37, 133, 0.4); color: #ff4d6d;" @onclick="DeleteSelected" disabled="@isLoading">
                Hapus Pilihan
            </button>
        </div>
    </div>

    <!-- PLAYLIST TABLE -->
    <div>
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.8rem;">
            <thead>
                <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.1); color: #a0a5aa; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.5px;">
                    <th style="padding: 8px; width: 40px; text-align: center;">
                        <input type="checkbox" checked="@isSelectAllChecked" @onchange="ToggleSelectAll" style="cursor: pointer;" />
                    </th>
                    <th style="padding: 8px; width: 40px; text-align: center;">#</th>
                    <th style="padding: 8px;">Judul</th>
                    <th style="padding: 8px;">Artis</th>
                    <th style="padding: 8px; text-align: right; padding-right: 16px;">Aksi Playlist & File</th>
                </tr>
            </thead>
            <tbody>
                @if (songs.Count == 0 && isLoading)
                {
                    <tr>
                        <td colspan="5" style="padding: 32px 16px; text-align: center; color: #4cc9f0; font-size: 0.9rem;">
                            Memuat daftar putar...
                        </td>
                    </tr>
                }
                else if (!FilteredSongs.Any())
                {
                    <tr>
                        <td colspan="5" style="padding: 32px 16px; text-align: center; color: #a0a5aa; font-size: 0.9rem;">
                            Vault kosong atau lagu tidak ditemukan.
                        </td>
                    </tr>
                }
                else
                {
                    int index = 1;
                    @foreach (var song in FilteredSongs)
                    {
                        var currentIndex = index++;
                        <tr @key="song.Id" style="border-bottom: 1px solid rgba(255, 255, 255, 0.03); transition: background 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.04)'" onmouseout="this.style.background='transparent'">
                            <td style="padding: 10px 8px; text-align: center;">
                                <input type="checkbox" checked="@song.IsSelected" @onchange="(e) => OnSongSelectChanged(song, e)" style="cursor: pointer;" />
                            </td>
                            <td style="padding: 10px 8px; text-align: center; color: #a0a5aa;">
                                @currentIndex
                            </td>
                            <td style="padding: 10px 8px; font-weight: 500; color: #fff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 300px;">
                                @song.Title
                            </td>
                            <td style="padding: 10px 8px; color: #a0a5aa; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 200px;">
                                @song.Artist
                            </td>
                            <td style="padding: 10px 8px; text-align: right;">
                                <!-- Aksi Player -->
                                <button style="background: transparent; border: none; color: #fff; cursor: pointer; padding: 4px 8px; margin-right: 4px;" @onclick="() => PlaySong(song)" title="Putar Sekarang">
                                    ▶
                                </button>
                                <button style="background: transparent; border: none; color: #c5c6c7; cursor: pointer; padding: 4px 8px; margin-right: 12px; font-size: 1.1rem;" @onclick="() => AddToQueue(song)" title="Tambahkan ke Antrean">
                                    +
                                </button>
                                
                                <!-- Aksi File -->
                                <button style="background: rgba(255,255,255,0.1); border: none; color: #fff; padding: 4px 10px; border-radius: 4px; font-size: 0.7rem; cursor: pointer; margin-right: 4px;" @onclick="() => DownloadSingle(song)" disabled="@isLoading">
                                    Unduh
                                </button>
                                <button style="background: transparent; border: 1px solid rgba(247, 37, 133, 0.4); color: #ff4d6d; padding: 3px 10px; border-radius: 4px; font-size: 0.7rem; cursor: pointer;" @onclick="() => DeleteSingle(song.Id)" disabled="@isLoading">
                                    Hapus
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</div>

@code {
    private List<CloudSongModel> songs = [];
    private string searchQuery = "";
    private string statusMsg = "";
    private bool isLoading;
    private bool isError;
    private bool isSelectAllChecked;

    private int totalQueueCount = 0;
    private int currentProcessedCount = 0;
    private int progressPercentage = 0;

    private IEnumerable<CloudSongModel> FilteredSongs =>
        string.IsNullOrWhiteSpace(searchQuery)
            ? songs
            : songs.Where(song =>
                song.Title.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                song.Artist.Contains(searchQuery, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await LoadLibrary();
    }

    private async Task LoadLibrary()
    {
        try
        {
            isLoading = true;
            UpdateStatus("Memuat library vault...");

            songs = await SongService.GetSongsAsync();
            isSelectAllChecked = false;
            UpdateStatus("");
        }
        catch (Exception ex)
        {
            UpdateStatus($"Gagal memuat library: {ex.Message}", true);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    // ==========================================
    // AKSI PLAYLIST (Integrasikan ke Player Anda)
    // ==========================================

    private void PlaySong(CloudSongModel song)
    {
        // TODO: Panggil service pemutar global Anda
        // contoh: PlayerService.PlayNow(song);
        UpdateStatus($"Mengirim '{song.Title}' ke pemutar...");
    }

    private void AddToQueue(CloudSongModel song)
    {
        // TODO: Panggil service pemutar global Anda
        // contoh: PlayerService.Enqueue(song);
        UpdateStatus($"'{song.Title}' ditambahkan ke antrean putar.");
    }

    private void PlayAll()
    {
        var listToPlay = FilteredSongs.ToList();
        if (listToPlay.Count == 0) return;

        // TODO: Kirim seluruh listToPlay ke pemutar global Anda
        // contoh: PlayerService.PlayList(listToPlay);
        UpdateStatus($"Memulai pemutaran {listToPlay.Count} lagu...");
    }

    private void AddSelectedToQueue()
    {
        var selected = songs.Where(s => s.IsSelected).ToList();
        if (selected.Count == 0)
        {
            UpdateStatus("Pilih minimal satu lagu untuk ditambahkan ke antrean.", true);
            return;
        }

        // TODO: Tambahkan 'selected' ke antrean global
        // contoh: PlayerService.EnqueueList(selected);
        UpdateStatus($"{selected.Count} lagu pilihan ditambahkan ke antrean putar.");
    }


    // ==========================================
    // MANAJEMEN FILE & UI (Sudah Lengkap)
    // ==========================================

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        isSelectAllChecked = e.Value is bool val && val;
        foreach (var song in FilteredSongs)
        {
            song.IsSelected = isSelectAllChecked;
        }
    }

    private void OnSongSelectChanged(CloudSongModel song, ChangeEventArgs e)
    {
        song.IsSelected = e.Value is bool val && val;
        var list = FilteredSongs.ToList();
        if (list.Count > 0)
        {
            isSelectAllChecked = list.All(s => s.IsSelected);
        }
    }

    private async Task DownloadSingle(CloudSongModel song)
    {
        try
        {
            UpdateStatus($"Mempersiapkan unduhan: {song.Title}...");
            await SongService.DownloadSongAsync(song.AudioUrl, $"{song.Artist} - {song.Title}");
            UpdateStatus("");
        }
        catch (Exception ex)
        {
            UpdateStatus($"Gagal mengunduh lagu: {ex.Message}", true);
        }
    }

    private async Task DownloadSelected()
    {
        var selected = songs.Where(song => song.IsSelected).ToList();
        if (selected.Count == 0)
        {
            UpdateStatus("Tidak ada lagu yang dipilih.", true);
            return;
        }

        try
        {
            isLoading = true;
            totalQueueCount = selected.Count;
            currentProcessedCount = 0;
            progressPercentage = 0;
            StateHasChanged();

            foreach (var song in selected)
            {
                currentProcessedCount++;
                progressPercentage = (int)((double)currentProcessedCount / totalQueueCount * 100);
                UpdateStatus($"[Antrean {currentProcessedCount}/{totalQueueCount}] Mengunduh: {song.Title}...");

                await SongService.DownloadSongAsync(song.AudioUrl, $"{song.Artist} - {song.Title}");
                await Task.Delay(1200);
            }

            progressPercentage = 100;
            UpdateStatus($"Selesai mengunduh seluruh {totalQueueCount} lagu!");
        }
        catch (Exception ex)
        {
            UpdateStatus($"Gagal mengunduh antrean: {ex.Message}", true);
        }
        finally
        {
            isLoading = false;
            totalQueueCount = 0;
            StateHasChanged();
        }
    }

    private async Task DeleteSingle(int id)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", "Yakin ingin menghapus lagu ini dari vault?");
        if (!confirmed) return;

        if (await SongService.DeleteSongAsync(id))
        {
            await LoadLibrary();
        }
    }

    private async Task DeleteSelected()
    {
        var selectedIds = songs.Where(song => song.IsSelected).Select(song => song.Id).ToArray();
        if (selectedIds.Length == 0)
        {
            UpdateStatus("Tidak ada lagu yang dipilih.", true);
            return;
        }

        bool confirmed = await JS.InvokeAsync<bool>("confirm", $"Yakin ingin menghapus {selectedIds.Length} lagu?");
        if (!confirmed) return;

        if (await SongService.DeleteBatchSongsAsync(selectedIds))
        {
            await LoadLibrary();
        }
    }

    private void UpdateStatus(string msg, bool error = false)
    {
        statusMsg = msg;
        isError = error;
        StateHasChanged();
    }
}
