@page "/library/sync"

<PageTitle>Sync Engine - Hypen Music Vault</PageTitle>

<div style="padding: 24px; background: #0a0b0e; color: #8a8f98; min-height: 100vh; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
    
    <!-- HEADER -->
    <div style="margin-bottom: 24px; padding-bottom: 16px; border-bottom: 1px solid rgba(255,255,255,0.06); display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 12px;">
        <div>
            <div style="font-size: 0.65rem; text-transform: uppercase; letter-spacing: 2px; color: #525866; margin-bottom: 4px; font-weight: 600;">System Pipeline</div>
            <h1 style="font-size: 1.25rem; color: #e6e8ec; margin: 0; font-weight: 500; letter-spacing: -0.2px;">Staging Sync Engine</h1>
        </div>
        <a href="/library" style="text-decoration: none; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); color: #8a8f98; padding: 6px 14px; border-radius: 4px; font-size: 0.75rem; font-family: monospace; transition: all 0.2s;">
            ← LIBRARY (@completedSongsCount)
        </a>
    </div>

    <!-- STATUS ALERT -->
    @if (!string.IsNullOrEmpty(statusMsg))
    {
        <div style="background: @(isError ? "rgba(247, 37, 133, 0.05)" : "rgba(76, 201, 240, 0.05)"); 
                    border-left: 2px solid @(isError ? "#ff4d6d" : "#4cc9f0"); 
                    padding: 8px 14px; margin-bottom: 20px; border-radius: 2px;">
            <p style="color: @(isError ? "#ff4d6d" : "#4cc9f0"); font-weight: 400; font-size: 0.75rem; margin: 0; letter-spacing: 0.3px;">
                @statusMsg
            </p>
        </div>
    }

    <!-- TAB SWITCHER -->
    <div style="display: flex; gap: 12px; margin-bottom: 20px; border-bottom: 1px solid rgba(255,255,255,0.06);">
        <button style="background: transparent; border: none; padding: 8px 12px; font-size: 0.75rem; font-family: monospace; cursor: pointer; color: @(activeTab == "ingest" ? "#e6e8ec" : "#525866"); border-bottom: 2px solid @(activeTab == "ingest" ? "#45a29e" : "transparent");" 
                @onclick='() => SwitchTab("ingest")'>
            01. EXTRACTION
        </button>
        <button style="background: transparent; border: none; padding: 8px 12px; font-size: 0.75rem; font-family: monospace; cursor: pointer; color: @(activeTab == "staging" ? "#e6e8ec" : "#525866"); border-bottom: 2px solid @(activeTab == "staging" ? "#45a29e" : "transparent");" 
                @onclick='() => SwitchTab("staging")'>
            02. STAGING BUFFER (@pendingRawCount PENDING)
        </button>
    </div>

    <!-- ========================================================================= -->
    <!-- TAB 1: EKSTRAKSI / INGESTION -->
    <!-- ========================================================================= -->
    @if (activeTab == "ingest")
    {
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 16px; margin-bottom: 24px;">
            <!-- INGESTION VIA YOUTUBE -->
            <div style="background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.05); border-radius: 4px; padding: 18px;">
                <div style="font-size: 0.7rem; font-family: monospace; color: #525866; text-transform: uppercase; margin-bottom: 8px;">Source // Remote</div>
                <h3 style="color: #d0d3d8; font-size: 0.9rem; font-weight: 500; margin: 0 0 12px 0;">YouTube Stream Ingest</h3>

                <div style="margin-bottom: 12px;">
                    <label style="display: block; font-size: 0.65rem; color: #525866; margin-bottom: 4px; font-family: monospace; text-transform: uppercase;">Playlist / Video ID</label>
                    <input type="text" @bind="targetPlaylistId" placeholder="LL atau Playlist ID..." 
                           style="width: 100%; padding: 6px 10px; background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.08); color: #d0d3d8; border-radius: 4px; font-size: 0.75rem; font-family: monospace; outline: none;" />
                </div>

                <div style="margin-bottom: 16px;">
                    <label style="display: block; font-size: 0.65rem; color: #525866; margin-bottom: 4px; font-family: monospace; text-transform: uppercase;">Fetch Limit</label>
                    <select @bind="maxResults" style="width: 100%; padding: 6px 10px; background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.08); color: #d0d3d8; border-radius: 4px; font-size: 0.75rem; font-family: monospace; outline: none;">
                        <option value="10">10 Track Terbaru</option>
                        <option value="25">25 Track Terbaru</option>
                        <option value="50">50 Track Terbaru</option>
                    </select>
                </div>

                <button style="width: 100%; background: rgba(255, 255, 255, 0.06); color: #e6e8ec; border: 1px solid rgba(255,255,255,0.1); padding: 8px; border-radius: 4px; font-size: 0.75rem; font-family: monospace; cursor: pointer;" 
                        @onclick="StartYouTubeIngestionToRaw" disabled="@isProcessing">
                    @(isProcessing ? "PROCESSING..." : "EXTRACT TO STAGING")
                </button>
            </div>

            <!-- INGESTION VIA LOCAL MP3 -->
            <div style="background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.05); border-radius: 4px; padding: 18px;">
                <div style="font-size: 0.7rem; font-family: monospace; color: #525866; text-transform: uppercase; margin-bottom: 8px;">Source // Local</div>
                <h3 style="color: #d0d3d8; font-size: 0.9rem; font-weight: 500; margin: 0 0 12px 0;">Local Audio Ingest</h3>

                <div>
                    <InputFile OnChange="HandleFileSelection" multiple accept=".mp3" style="color: #666c7a; font-size: 0.75rem; font-family: monospace;" />
                </div>
            </div>
        </div>

        @if (extractedList.Count > 0)
        {
            <div style="background: rgba(255, 255, 255, 0.02); border-radius: 4px; border: 1px solid rgba(255, 255, 255, 0.05); overflow: hidden; margin-bottom: 24px;">
                <div style="padding: 10px 14px; font-size: 0.72rem; font-family: monospace; border-bottom: 1px solid rgba(255,255,255,0.05); color: #8a8f98; display: flex; justify-content: space-between; align-items: center;">
                    <span>PARSED FILE PREVIEW</span>
                    <span style="color: #45a29e;">@extractedList.Count(i => i.IsSelected) SELECTED</span>
                </div>
                
                <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.8rem;">
                    <thead>
                        <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.05); color: #525866; font-size: 0.68rem; text-transform: uppercase; font-family: monospace;">
                            <th style="padding: 8px; width: 32px; text-align: center;"><input type="checkbox" @onchange="ToggleSelectAllLocal" checked="@isAllLocalSelected" style="opacity: 0.6;" /></th>
                            <th style="padding: 8px;">File Name</th>
                            <th style="padding: 8px;">Raw Artist</th>
                            <th style="padding: 8px;">Raw Title</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in extractedList)
                        {
                            <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.02);">
                                <td style="padding: 8px; text-align: center;"><input type="checkbox" @bind="item.IsSelected" style="opacity: 0.6;" /></td>
                                <td style="padding: 8px; color: #525866; font-size: 0.75rem; font-family: monospace;">@item.FileName</td>
                                <td style="padding: 8px;"><input type="text" @bind="item.CleanArtist" style="background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.08); color: #d0d3d8; padding: 4px 6px; border-radius: 2px; font-size: 0.75rem; width: 95%; outline: none;" /></td>
                                <td style="padding: 8px;"><input type="text" @bind="item.CleanTitle" style="background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.08); color: #d0d3d8; padding: 4px 6px; border-radius: 2px; font-size: 0.75rem; width: 95%; outline: none;" /></td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div style="padding: 12px; background: rgba(0,0,0,0.2); border-top: 1px solid rgba(255,255,255,0.05); text-align: right;">
                    <button style="background: rgba(255,255,255,0.08); color: #e6e8ec; border: 1px solid rgba(255,255,255,0.1); padding: 6px 16px; border-radius: 4px; font-size: 0.75rem; font-family: monospace; cursor: pointer;" 
                            @onclick="SaveLocalIngestionToRaw" disabled="@isProcessing">
                        @(isProcessing ? "SAVING..." : $"COMMIT {extractedList.Count(i => i.IsSelected)} FILES TO STAGING")
                    </button>
                </div>
            </div>
        }
    }

    <!-- ========================================================================= -->
    <!-- TAB 2: STAGING REVIEW (MATCH -> EDIT SEMUA ATRIBUT -> UPLOAD TO COMPLETE) -->
    <!-- ========================================================================= -->
    @if (activeTab == "staging")
    {
        <div style="background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.05); border-radius: 4px; padding: 12px 16px; margin-bottom: 16px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
            <div>
                <div style="font-size: 0.68rem; font-family: monospace; color: #525866; text-transform: uppercase;">Buffer Pipeline</div>
                <div style="font-size: 0.8rem; color: #d0d3d8;">Review metadata & sinkronisasi data staging.</div>
            </div>
            <div style="display: flex; gap: 8px;">
                <button style="background: transparent; color: #45a29e; border: 1px solid rgba(69, 162, 158, 0.3); padding: 6px 12px; border-radius: 4px; font-size: 0.72rem; font-family: monospace; cursor: pointer;" 
                        @onclick="SmartMatchAllPending" disabled="@isProcessing">
                    🔍 MATCH ALL
                </button>
                <button style="background: rgba(255,255,255,0.08); color: #e6e8ec; border: 1px solid rgba(255,255,255,0.1); padding: 6px 12px; border-radius: 4px; font-size: 0.72rem; font-family: monospace; cursor: pointer;" 
                        @onclick="UploadAllToComplete" disabled="@isProcessing">
                    🚀 COMMIT ALL TO LIBRARY
                </button>
            </div>
        </div>

        @if (stagingList.Count == 0)
        {
            <div style="padding: 40px; text-align: center; color: #525866; font-family: monospace; font-size: 0.75rem; background: rgba(255,255,255,0.01); border-radius: 4px; border: 1px solid rgba(255,255,255,0.03);">
                NO PENDING TRACKS IN STAGING BUFFER.
            </div>
        }
        else
        {
            <div style="background: rgba(255, 255, 255, 0.02); border-radius: 4px; border: 1px solid rgba(255, 255, 255, 0.05); overflow-x: auto;">
                <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.78rem; min-width: 1000px;">
                    <thead>
                        <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.05); color: #525866; font-size: 0.68rem; text-transform: uppercase; font-family: monospace;">
                            <th style="padding: 8px 10px; width: 180px;">Judul</th>
                            <th style="padding: 8px 10px; width: 150px;">Artis</th>
                            <th style="padding: 8px 10px; width: 140px;">Album</th>
                            <th style="padding: 8px 10px; width: 70px;">Tahun</th>
                            <th style="padding: 8px 10px; width: 60px;">Reg</th>
                            <th style="padding: 8px 10px; width: 70px;">Durasi</th>
                            <th style="padding: 8px 10px;">Cover URL</th>
                            <th style="padding: 8px 10px; text-align: right; width: 110px;">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in stagingList)
                        {
                            <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.02);">
                                <!-- TITLE -->
                                <td style="padding: 6px 8px;">
                                    <input type="text" @bind="row.Title" style="background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.08); color: #d0d3d8; padding: 4px 6px; border-radius: 2px; font-size: 0.75rem; width: 100%; outline: none;" />
                                </td>

                                <!-- ARTIST -->
                                <td style="padding: 6px 8px;">
                                    <input type="text" @bind="row.Artist" style="background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.08); color: #d0d3d8; padding: 4px 6px; border-radius: 2px; font-size: 0.75rem; width: 100%; outline: none;" />
                                </td>

                                <!-- ALBUM -->
                                <td style="padding: 6px 8px;">
                                    <input type="text" @bind="row.Album" placeholder="Single" style="background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.08); color: #d0d3d8; padding: 4px 6px; border-radius: 2px; font-size: 0.75rem; width: 100%; outline: none;" />
                                </td>

                                <!-- YEAR -->
                                <td style="padding: 6px 8px;">
                                    <input type="number" @bind="row.ReleaseYear" placeholder="2024" style="background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.08); color: #d0d3d8; padding: 4px 6px; border-radius: 2px; font-size: 0.75rem; width: 100%; font-family: monospace; outline: none;" />
                                </td>

                                <!-- COUNTRY -->
                                <td style="padding: 6px 8px;">
                                    <input type="text" @bind="row.Country" placeholder="ID" style="background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.08); color: #4cc9f0; padding: 4px 6px; border-radius: 2px; font-size: 0.75rem; width: 100%; font-family: monospace; outline: none;" />
                                </td>

                                <!-- DURATION -->
                                <td style="padding: 6px 8px;">
                                    <input type="number" @bind="row.DurationSeconds" placeholder="0" style="background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.08); color: #d0d3d8; padding: 4px 6px; border-radius: 2px; font-size: 0.75rem; width: 100%; font-family: monospace; outline: none;" />
                                </td>

                                <!-- COVER URL -->
                                <td style="padding: 6px 8px;">
                                    <input type="text" @bind="row.AlbumCoverUrl" placeholder="https://..." style="background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.08); color: #666c7a; padding: 4px 6px; border-radius: 2px; font-size: 0.72rem; font-family: monospace; width: 100%; outline: none;" />
                                </td>

                                <!-- ACTIONS -->
                                <td style="padding: 6px 8px; text-align: right; white-space: nowrap;">
                                    <button style="background: transparent; border: none; color: #45a29e; padding: 4px 4px; font-size: 0.72rem; cursor: pointer;" 
                                            title="Smart Match"
                                            @onclick="() => SmartMatchSingleRaw(row)" disabled="@isProcessing">
                                        🔍
                                    </button>
                                    
                                    <button style="background: transparent; border: none; color: #e6e8ec; padding: 4px 4px; font-size: 0.72rem; cursor: pointer;" 
                                            title="Commit to Library"
                                            @onclick="() => UploadSingleRawToComplete(row)" disabled="@isProcessing">
                                        🚀
                                    </button>
                                    
                                    <button style="background: transparent; border: none; color: rgba(247, 37, 133, 0.5); padding: 4px 4px; font-size: 0.72rem; cursor: pointer;" 
                                            title="Hapus"
                                            @onclick="() => DeleteRawItem(row.Id)" disabled="@isProcessing">
                                        ✕
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }

</div>
