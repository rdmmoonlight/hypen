@page "/library/sync"

<PageTitle>Sync Engine - Hypen Music Vault</PageTitle>

<div style="padding: 24px; background: #0a0b0e; color: #8a8f98; min-height: 100vh; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
    
    <!-- HEADER -->
    <div style="margin-bottom: 24px; padding-bottom: 16px; border-bottom: 1px solid rgba(255,255,255,0.06); display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 12px;">
        <div>
            <div style="font-size: 0.65rem; text-transform: uppercase; letter-spacing: 2px; color: #525866; margin-bottom: 4px; font-weight: 600;">System Pipeline</div>
            <h1 style="font-size: 1.25rem; color: #e6e8ec; margin: 0; font-weight: 500; letter-spacing: -0.2px;">Extraction Engine</h1>
        </div>
        <div style="display: flex; gap: 8px;">
            <a href="/library/sync/staging" style="text-decoration: none; background: rgba(69, 162, 158, 0.1); border: 1px solid rgba(69, 162, 158, 0.3); color: #45a29e; padding: 6px 14px; border-radius: 4px; font-size: 0.75rem; font-family: monospace; transition: all 0.2s;">
                STAGING BUFFER (@pendingRawCount) →
            </a>
            <a href="/library" style="text-decoration: none; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); color: #8a8f98; padding: 6px 14px; border-radius: 4px; font-size: 0.75rem; font-family: monospace; transition: all 0.2s;">
                ← LIBRARY (@completedSongsCount)
            </a>
        </div>
    </div>

    <!-- STATUS ALERT -->
    @if (!string.IsNullOrEmpty(statusMsg))
    {
        <div style="background: @(isError ? "rgba(247, 37, 133, 0.05)" : "rgba(76, 201, 240, 0.05)"); 
                    border-left: 2px solid @(isError ? "#ff4d6d" : "#4cc9f0"); 
                    padding: 8px 14px; margin-bottom: 20px; border-radius: 2px;">
            <p style="color: @(isError ? "#ff4d6d" : "#4cc9f0"); font-weight: 400; font-size: 0.75rem; margin: 0; letter-spacing: 0.3px;">
                @statusMsg
            </p>
        </div>
    }

    <!-- EKSTRAKSI / INGESTION CONTENT -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 16px; margin-bottom: 24px;">
        <!-- INGESTION VIA YOUTUBE -->
        <div style="background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.05); border-radius: 4px; padding: 18px;">
            <div style="font-size: 0.7rem; font-family: monospace; color: #525866; text-transform: uppercase; margin-bottom: 8px;">Source // Remote</div>
            <h3 style="color: #d0d3d8; font-size: 0.9rem; font-weight: 500; margin: 0 0 12px 0;">YouTube Stream Ingest</h3>

            <div style="margin-bottom: 12px;">
                <label style="display: block; font-size: 0.65rem; color: #525866; margin-bottom: 4px; font-family: monospace; text-transform: uppercase;">Playlist / Video ID</label>
                <input type="text" @bind="targetPlaylistId" placeholder="LL atau Playlist ID..." 
                       style="width: 100%; padding: 6px 10px; background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.08); color: #d0d3d8; border-radius: 4px; font-size: 0.75rem; font-family: monospace; outline: none;" />
            </div>

            <div style="margin-bottom: 16px;">
                <label style="display: block; font-size: 0.65rem; color: #525866; margin-bottom: 4px; font-family: monospace; text-transform: uppercase;">Fetch Limit</label>
                <select @bind="maxResults" style="width: 100%; padding: 6px 10px; background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.08); color: #d0d3d8; border-radius: 4px; font-size: 0.75rem; font-family: monospace; outline: none;">
                    <option value="10">10 Track Terbaru</option>
                    <option value="25">25 Track Terbaru</option>
                    <option value="50">50 Track Terbaru</option>
                </select>
            </div>

            <button style="width: 100%; background: rgba(255, 255, 255, 0.06); color: #e6e8ec; border: 1px solid rgba(255,255,255,0.1); padding: 8px; border-radius: 4px; font-size: 0.75rem; font-family: monospace; cursor: pointer;" 
                    @onclick="StartYouTubeIngestionToRaw" disabled="@isProcessing">
                @(isProcessing ? "PROCESSING..." : "EXTRACT TO STAGING")
            </button>
        </div>

        <!-- INGESTION VIA LOCAL MP3 -->
        <div style="background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.05); border-radius: 4px; padding: 18px;">
            <div style="font-size: 0.7rem; font-family: monospace; color: #525866; text-transform: uppercase; margin-bottom: 8px;">Source // Local</div>
            <h3 style="color: #d0d3d8; font-size: 0.9rem; font-weight: 500; margin: 0 0 12px 0;">Local Audio Ingest</h3>

            <div>
                <InputFile OnChange="HandleFileSelection" multiple accept=".mp3" style="color: #666c7a; font-size: 0.75rem; font-family: monospace;" />
            </div>
        </div>
    </div>

    @if (extractedList.Count > 0)
    {
        <div style="background: rgba(255, 255, 255, 0.02); border-radius: 4px; border: 1px solid rgba(255, 255, 255, 0.05); overflow: hidden; margin-bottom: 24px;">
            <div style="padding: 10px 14px; font-size: 0.72rem; font-family: monospace; border-bottom: 1px solid rgba(255,255,255,0.05); color: #8a8f98; display: flex; justify-content: space-between; align-items: center;">
                <span>PARSED FILE PREVIEW</span>
                <span style="color: #45a29e;">@extractedList.Count(i => i.IsSelected) SELECTED</span>
            </div>
            
            <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.8rem;">
                <thead>
                    <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.05); color: #525866; font-size: 0.68rem; text-transform: uppercase; font-family: monospace;">
                        <th style="padding: 8px; width: 32px; text-align: center;"><input type="checkbox" @onchange="ToggleSelectAllLocal" checked="@isAllLocalSelected" style="opacity: 0.6;" /></th>
                        <th style="padding: 8px;">File Name</th>
                        <th style="padding: 8px;">Raw Artist</th>
                        <th style="padding: 8px;">Raw Title</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in extractedList)
                    {
                        <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.02);">
                            <td style="padding: 8px; text-align: center;"><input type="checkbox" @bind="item.IsSelected" style="opacity: 0.6;" /></td>
                            <td style="padding: 8px; color: #525866; font-size: 0.75rem; font-family: monospace;">@item.FileName</td>
                            <td style="padding: 8px;"><input type="text" @bind="item.CleanArtist" style="background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.08); color: #d0d3d8; padding: 4px 6px; border-radius: 2px; font-size: 0.75rem; width: 95%; outline: none;" /></td>
                            <td style="padding: 8px;"><input type="text" @bind="item.CleanTitle" style="background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.08); color: #d0d3d8; padding: 4px 6px; border-radius: 2px; font-size: 0.75rem; width: 95%; outline: none;" /></td>
                        </tr>
                    }
                </tbody>
            </table>

            <div style="padding: 12px; background: rgba(0,0,0,0.2); border-top: 1px solid rgba(255,255,255,0.05); text-align: right;">
                <button style="background: rgba(255,255,255,0.08); color: #e6e8ec; border: 1px solid rgba(255,255,255,0.1); padding: 6px 16px; border-radius: 4px; font-size: 0.75rem; font-family: monospace; cursor: pointer;" 
                        @onclick="SaveLocalIngestionToRaw" disabled="@isProcessing">
                    @(isProcessing ? "SAVING..." : $"COMMIT {extractedList.Count(i => i.IsSelected)} FILES TO STAGING")
                </button>
            </div>
        </div>
    }

</div>
