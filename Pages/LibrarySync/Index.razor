@page "/library/sync"

<PageTitle>Sync Engine - Hypen Music Vault</PageTitle>

<div class="sync-container">
    <!-- HEADER -->
    <div class="sync-header">
        <div>
            <div class="subtitle">System Pipeline</div>
            <h1 class="title">Extraction Engine</h1>
        </div>
        <div class="nav-actions">
            <a href="/library/sync/staging" class="btn-nav btn-staging">
                STAGING BUFFER (@pendingRawCount:N0) →
            </a>
            <a href="/library" class="btn-nav btn-library">
                ← LIBRARY (@completedSongsCount:N0)
            </a>
        </div>
    </div>

    <!-- STATUS ALERT -->
    @if (!string.IsNullOrEmpty(statusMsg))
    {
        <div class="status-alert @(isError ? "alert-error" : "alert-info")">
            <p class="status-text">@statusMsg</p>
        </div>
    }

    <!-- EKSTRAKSI / INGESTION CONTENT -->
    <div class="ingest-grid">
        <!-- INGESTION VIA YOUTUBE -->
        <div class="card-ingest">
            <div class="source-tag">Source // Remote</div>
            <h3 class="card-title">YouTube Stream Ingest</h3>

            <div class="form-group">
                <label class="form-label">Playlist / Video ID</label>
                <input type="text" @bind="targetPlaylistId" placeholder="LL atau Playlist ID..." class="form-control" />
            </div>

            <div class="form-group-large">
                <label class="form-label">Fetch Limit</label>
                <select @bind="maxResults" class="form-control">
                    <option value="10">10 Track Terbaru</option>
                    <option value="25">25 Track Terbaru</option>
                    <option value="50">50 Track Terbaru</option>
                    <option value="@int.MaxValue">Unlimited (Seluruh Playlist)</option>
                </select>
            </div>

            <button class="btn-action" @onclick="StartYouTubeIngestionToRaw" disabled="@isProcessing">
                @(isProcessing ? "PROCESSING..." : "EXTRACT TO STAGING")
            </button>
        </div>

        <!-- INGESTION VIA LOCAL MP3 -->
        <div class="card-ingest">
            <div class="source-tag">Source // Local</div>
            <h3 class="card-title">Local Audio Ingest</h3>

            <div>
                <InputFile OnChange="HandleFileSelection" multiple accept=".mp3" class="input-file" />
            </div>
        </div>
    </div>

    <!-- PREVIEW TABLE FILE MP3 -->
    @if (extractedList.Count > 0)
    {
        <div class="preview-container">
            <div class="preview-header">
                <span>PARSED FILE PREVIEW</span>
                <span class="count-tag">@extractedList.Count(i => i.IsSelected) SELECTED</span>
            </div>

            <table class="preview-table">
                <thead>
                    <tr>
                        <th class="th-check">
                            <input type="checkbox" @onchange="ToggleSelectAllLocal" checked="@isAllLocalSelected" class="checkbox-input" />
                        </th>
                        <th>File Name</th>
                        <th>Raw Artist</th>
                        <th>Raw Title</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in extractedList)
                    {
                        <tr>
                            <td class="td-check">
                                <input type="checkbox" @bind="item.IsSelected" class="checkbox-input" />
                            </td>
                            <td class="file-name">@item.FileName</td>
                            <td>
                                <input type="text" @bind="item.CleanArtist" class="form-control table-input" />
                            </td>
                            <td>
                                <input type="text" @bind="item.CleanTitle" class="form-control table-input" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="preview-footer">
                <button class="btn-action btn-commit" @onclick="SaveLocalIngestionToRaw" disabled="@isProcessing">
                    @(isProcessing ? "SAVING..." : $"COMMIT {extractedList.Count(i => i.IsSelected):N0} FILES TO STAGING")
                </button>
            </div>
        </div>
    }
</div>
