@page "/library/sync"

<PageTitle>Sync Engine - Hypen Music Vault</PageTitle>

<div style="padding: 24px; background: #0b0c10; color: #c5c6c7; min-height: 100vh; font-family: system-ui, -apple-system, sans-serif;">
    
    <!-- HEADER -->
    <div style="margin-bottom: 20px; padding-bottom: 16px; border-bottom: 1px solid rgba(255,255,255,0.05); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
        <div>
            <h1 style="font-size: 1.8rem; color: #fff; margin: 0 0 6px 0; font-weight: 700;">🔄 Hypen Staging Sync Engine</h1>
            <p style="font-size: 0.85rem; color: #a0a5aa; margin: 0;">
                Pipeline ringkas: Ekstraksi → Staging RAW (Smart Match & Edit Semua Atribut) → Upload ke Complete Table.
            </p>
        </div>
        <a href="/library" style="text-decoration: none; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.1); color: #fff; padding: 8px 16px; border-radius: 20px; font-size: 0.8rem; transition: background 0.2s;">
            ← Kembali ke Library (@completedSongsCount Lagu)
        </a>
    </div>

    <!-- STATUS ALERT -->
    @if (!string.IsNullOrEmpty(statusMsg))
    {
        <div style="background: @(isError ? "rgba(247, 37, 133, 0.1)" : "rgba(76, 201, 240, 0.1)"); 
                    border-left: 4px solid @(isError ? "#f72585" : "#4cc9f0"); 
                    padding: 10px 14px; margin-bottom: 20px; border-radius: 4px;">
            <p style="color: @(isError ? "#ff4d6d" : "#4cc9f0"); font-weight: 500; font-size: 0.82rem; margin: 0;">
                @statusMsg
            </p>
        </div>
    }

    <!-- TAB SWITCHER -->
    <div style="display: flex; gap: 8px; margin-bottom: 20px; border-bottom: 1px solid rgba(255,255,255,0.08);">
        <button style="background: transparent; border: none; padding: 10px 18px; font-size: 0.85rem; font-weight: 600; cursor: pointer; color: @(activeTab == "ingest" ? "#4cc9f0" : "#a0a5aa"); border-bottom: 2px solid @(activeTab == "ingest" ? "#4cc9f0" : "transparent");" 
                @onclick='() => SwitchTab("ingest")'>
            📥 1. Ekstraksi (YouTube & File MP3)
        </button>
        <button style="background: transparent; border: none; padding: 10px 18px; font-size: 0.85rem; font-weight: 600; cursor: pointer; color: @(activeTab == "staging" ? "#4cc9f0" : "#a0a5aa"); border-bottom: 2px solid @(activeTab == "staging" ? "#4cc9f0" : "transparent");" 
                @onclick='() => SwitchTab("staging")'>
            🛠 2. Staging RAW (@pendingRawCount Pending)
        </button>
    </div>

    <!-- ========================================================================= -->
    <!-- TAB 1: EKSTRAKSI / INGESTION -->
    <!-- ========================================================================= -->
    @if (activeTab == "ingest")
    {
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 20px; margin-bottom: 24px;">
            <!-- INGESTION VIA YOUTUBE -->
            <div style="background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 8px; padding: 20px;">
                <h3 style="color: #fff; font-size: 1rem; margin-top: 0; margin-bottom: 12px;">🔴 YouTube Extraction</h3>
                <p style="font-size: 0.78rem; color: #a0a5aa; margin-bottom: 16px;">
                    Tarik video/playlist dari YouTube. Data mentah akan ditampung di <code>songs_raw</code> sebagai status <b>PENDING</b>.
                </p>

                <div style="margin-bottom: 12px;">
                    <label style="display: block; font-size: 0.72rem; color: #a0a5aa; margin-bottom: 4px; text-transform: uppercase;">Playlist / Video ID</label>
                    <input type="text" @bind="targetPlaylistId" placeholder="LL (Liked Songs) atau Playlist ID" 
                           style="width: 100%; padding: 8px 12px; background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.1); color: #fff; border-radius: 4px; font-size: 0.85rem;" />
                </div>

                <div style="margin-bottom: 16px;">
                    <label style="display: block; font-size: 0.72rem; color: #a0a5aa; margin-bottom: 4px; text-transform: uppercase;">Jumlah Tarik Max</label>
                    <select @bind="maxResults" style="width: 100%; padding: 8px 12px; background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.1); color: #fff; border-radius: 4px; font-size: 0.85rem;">
                        <option value="10">10 Lagu Terbaru</option>
                        <option value="25">25 Lagu Terbaru</option>
                        <option value="50">50 Lagu Terbaru</option>
                    </select>
                </div>

                <button style="width: 100%; background: #f72585; color: #fff; font-weight: 600; border: none; padding: 10px; border-radius: 4px; font-size: 0.8rem; cursor: pointer;" 
                        @onclick="StartYouTubeIngestionToRaw" disabled="@isProcessing">
                    @(isProcessing ? "Menarik..." : "📥 Ekstrak YouTube ke Staging")
                </button>
            </div>

            <!-- INGESTION VIA LOCAL MP3 -->
            <div style="background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 8px; padding: 20px;">
                <h3 style="color: #fff; font-size: 1rem; margin-top: 0; margin-bottom: 12px;">📁 Local MP3 Extraction</h3>
                <p style="font-size: 0.78rem; color: #a0a5aa; margin-bottom: 16px;">
                    Pilih file MP3 untuk dibaca ID3 tag/nama filenya.
                </p>

                <div>
                    <InputFile OnChange="HandleFileSelection" multiple accept=".mp3" style="color: #fff; font-size: 0.85rem;" />
                </div>
            </div>
        </div>

        @if (extractedList.Count > 0)
        {
            <div style="background: rgba(255, 255, 255, 0.02); border-radius: 6px; border: 1px solid rgba(255, 255, 255, 0.08); overflow: hidden; margin-bottom: 24px;">
                <div style="padding: 12px 16px; font-weight: 600; font-size: 0.85rem; border-bottom: 1px solid rgba(255,255,255,0.05); color: #fff; display: flex; justify-content: space-between; align-items: center;">
                    <span>Review Parsing Awal MP3 (Sebelum Masuk Staging)</span>
                    <span style="font-size: 0.75rem; color: #4cc9f0;">@extractedList.Count(i => i.IsSelected) file dipilih</span>
                </div>
                
                <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.8rem;">
                    <thead>
                        <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.1); color: #a0a5aa; font-size: 0.75rem; text-transform: uppercase;">
                            <th style="padding: 10px; width: 40px; text-align: center;"><input type="checkbox" @onchange="ToggleSelectAllLocal" checked="@isAllLocalSelected" /></th>
                            <th style="padding: 10px;">Nama File</th>
                            <th style="padding: 10px;">Raw Artis</th>
                            <th style="padding: 10px;">Raw Judul</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in extractedList)
                        {
                            <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.03);">
                                <td style="padding: 10px; text-align: center;"><input type="checkbox" @bind="item.IsSelected" /></td>
                                <td style="padding: 10px; color: #a0a5aa; font-size: 0.75rem;">@item.FileName</td>
                                <td style="padding: 10px;"><input type="text" @bind="item.CleanArtist" style="background: rgba(0,0,0,0.4); border: 1px solid rgba(255,255,255,0.1); color: #fff; padding: 4px 8px; border-radius: 4px; font-size: 0.8rem; width: 90%;" /></td>
                                <td style="padding: 10px;"><input type="text" @bind="item.CleanTitle" style="background: rgba(0,0,0,0.4); border: 1px solid rgba(255,255,255,0.1); color: #fff; padding: 4px 8px; border-radius: 4px; font-size: 0.8rem; width: 90%;" /></td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div style="padding: 16px; background: rgba(0,0,0,0.2); border-top: 1px solid rgba(255,255,255,0.05); text-align: right;">
                    <button style="background: #4cc9f0; color: #000; font-weight: 600; border: none; padding: 10px 24px; border-radius: 4px; font-size: 0.85rem; cursor: pointer;" 
                            @onclick="SaveLocalIngestionToRaw" disabled="@isProcessing">
                        @(isProcessing ? "Menyimpan ke Staging..." : $"📥 Simpan {extractedList.Count(i => i.IsSelected)} MP3 ke Staging RAW")
                    </button>
                </div>
            </div>
        }
    }

    <!-- ========================================================================= -->
    <!-- TAB 2: STAGING REVIEW (MATCH -> EDIT SEMUA ATRIBUT -> UPLOAD TO COMPLETE) -->
    <!-- ========================================================================= -->
    @if (activeTab == "staging")
    {
        <div style="background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 8px; padding: 16px; margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
            <div>
                <h3 style="color: #fff; font-size: 0.95rem; margin: 0 0 4px 0;">Buffer Staging RAW</h3>
                <p style="font-size: 0.78rem; color: #a0a5aa; margin: 0;">Jalankan <b>Smart Match</b> untuk autofill metadata, Anda dapat <b>mengedit seluruh kolom atribut</b> di bawah, lalu klik <b>Upload</b>.</p>
            </div>
            <div style="display: flex; gap: 8px;">
                <button style="background: rgba(76, 201, 240, 0.2); color: #4cc9f0; border: 1px solid rgba(76, 201, 240, 0.4); font-weight: 600; padding: 8px 16px; border-radius: 4px; font-size: 0.8rem; cursor: pointer;" 
                        @onclick="SmartMatchAllPending" disabled="@isProcessing">
                    🔍 Smart Match Semua
                </button>
                <button style="background: #4cc9f0; color: #000; font-weight: 600; border: none; padding: 8px 16px; border-radius: 4px; font-size: 0.8rem; cursor: pointer;" 
                        @onclick="UploadAllToComplete" disabled="@isProcessing">
                    🚀 Upload Semua ke Complete
                </button>
            </div>
        </div>

        @if (stagingList.Count == 0)
        {
            <div style="padding: 40px; text-align: center; color: #a0a5aa; background: rgba(255,255,255,0.01); border-radius: 8px;">
                🎉 Tidak ada data PENDING di Staging RAW.
            </div>
        }
        else
        {
            <div style="background: rgba(255, 255, 255, 0.02); border-radius: 6px; border: 1px solid rgba(255, 255, 255, 0.08); overflow-x: auto;">
                <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.8rem; min-width: 1100px;">
                    <thead>
                        <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.1); color: #a0a5aa; font-size: 0.72rem; text-transform: uppercase;">
                            <th style="padding: 10px; width: 50px;">Cover</th>
                            <th style="padding: 10px; width: 180px;">Judul</th>
                            <th style="padding: 10px; width: 150px;">Artis</th>
                            <th style="padding: 10px; width: 140px;">Album</th>
                            <th style="padding: 10px; width: 80px;">Tahun</th>
                            <th style="padding: 10px; width: 90px;">Negara</th>
                            <th style="padding: 10px; width: 70px;">Durasi(s)</th>
                            <th style="padding: 10px; width: 180px;">Cover URL</th>
                            <th style="padding: 10px; text-align: center; width: 170px;">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in stagingList)
                        {
                            <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.03);">
                                <!-- COVER THUMBNAIL PREVIEW -->
                                <td style="padding: 8px; text-align: center;">
                                    @if (!string.IsNullOrEmpty(row.AlbumCoverUrl))
                                    {
                                        <img src="@row.AlbumCoverUrl" alt="Cover" style="width: 36px; height: 36px; object-fit: cover; border-radius: 4px;" />
                                    }
                                    else
                                    {
                                        <div style="width: 36px; height: 36px; background: rgba(255,255,255,0.05); border-radius: 4px; display: flex; align-items: center; justify-content: center; font-size: 0.6rem; color: #a0a5aa;">No Cover</div>
                                    }
                                </td>

                                <!-- EDITABLE TITLE -->
                                <td style="padding: 8px;">
                                    <input type="text" @bind="row.Title" style="background: rgba(0,0,0,0.4); border: 1px solid rgba(255,255,255,0.1); color: #fff; padding: 4px 6px; border-radius: 4px; font-size: 0.78rem; width: 100%;" />
                                </td>

                                <!-- EDITABLE ARTIST -->
                                <td style="padding: 8px;">
                                    <input type="text" @bind="row.Artist" style="background: rgba(0,0,0,0.4); border: 1px solid rgba(255,255,255,0.1); color: #fff; padding: 4px 6px; border-radius: 4px; font-size: 0.78rem; width: 100%;" />
                                </td>

                                <!-- EDITABLE ALBUM -->
                                <td style="padding: 8px;">
                                    <input type="text" @bind="row.Album" placeholder="Single" style="background: rgba(0,0,0,0.4); border: 1px solid rgba(255,255,255,0.1); color: #fff; padding: 4px 6px; border-radius: 4px; font-size: 0.78rem; width: 100%;" />
                                </td>

                                <!-- EDITABLE RELEASE YEAR -->
                                <td style="padding: 8px;">
                                    <input type="number" @bind="row.ReleaseYear" placeholder="2024" style="background: rgba(0,0,0,0.4); border: 1px solid rgba(255,255,255,0.1); color: #fff; padding: 4px 6px; border-radius: 4px; font-size: 0.78rem; width: 100%;" />
                                </td>

                                <!-- EDITABLE COUNTRY -->
                                <td style="padding: 8px;">
                                    <input type="text" @bind="row.Country" placeholder="ID" style="background: rgba(0,0,0,0.4); border: 1px solid rgba(255,255,255,0.1); color: #4cc9f0; padding: 4px 6px; border-radius: 4px; font-size: 0.78rem; width: 100%;" />
                                </td>

                                <!-- EDITABLE DURATION SECONDS -->
                                <td style="padding: 8px;">
                                    <input type="number" @bind="row.DurationSeconds" placeholder="0" style="background: rgba(0,0,0,0.4); border: 1px solid rgba(255,255,255,0.1); color: #fff; padding: 4px 6px; border-radius: 4px; font-size: 0.78rem; width: 100%;" />
                                </td>

                                <!-- EDITABLE ALBUM COVER URL -->
                                <td style="padding: 8px;">
                                    <input type="text" @bind="row.AlbumCoverUrl" placeholder="https://..." style="background: rgba(0,0,0,0.4); border: 1px solid rgba(255,255,255,0.1); color: #a0a5aa; padding: 4px 6px; border-radius: 4px; font-size: 0.75rem; width: 100%;" />
                                </td>

                                <!-- ACTION BUTTONS -->
                                <td style="padding: 8px; text-align: center;">
                                    <div style="display: flex; gap: 4px; justify-content: center;">
                                        <button style="background: rgba(76, 201, 240, 0.2); color: #4cc9f0; border: 1px solid rgba(76, 201, 240, 0.4); padding: 4px 8px; border-radius: 4px; font-size: 0.72rem; cursor: pointer;" 
                                                title="Cari metadata otomatis di Internet"
                                                @onclick="() => SmartMatchSingleRaw(row)" disabled="@isProcessing">
                                            🔍 Match
                                        </button>
                                        
                                        <button style="background: #4cc9f0; color: #000; border: none; padding: 4px 8px; border-radius: 4px; font-size: 0.72rem; font-weight: 600; cursor: pointer;" 
                                                title="Upload data hasil edit ke Complete Table"
                                                @onclick="() => UploadSingleRawToComplete(row)" disabled="@isProcessing">
                                            🚀 Upload
                                        </button>
                                        
                                        <button style="background: rgba(247, 37, 133, 0.2); color: #ff4d6d; border: 1px solid rgba(247, 37, 133, 0.3); padding: 4px 8px; border-radius: 4px; font-size: 0.72rem; cursor: pointer;" 
                                                title="Hapus baris ini dari Staging"
                                                @onclick="() => DeleteRawItem(row.Id)" disabled="@isProcessing">
                                            🗑
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }

</div>
