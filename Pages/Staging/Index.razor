@page "/staging"
@namespace Hypen.Web.Pages.Staging

<PageTitle>Staging Buffer - Hypen Music Vault</PageTitle>

<div class="container-fluid py-4 bg-dark text-light min-vh-100">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-end border-bottom border-secondary pb-3 mb-4 flex-wrap gap-2">
        <div>
            <div class="text-uppercase text-muted fw-bold small mb-1" style="letter-spacing: 2px; font-size: 0.7rem;">System Pipeline</div>
            <h1 class="h4 mb-0 fw-normal text-white">Staging Buffer Review</h1>
        </div>
        <div class="d-flex gap-2">
            <a href="/library/sync" class="btn btn-outline-secondary btn-sm font-monospace">
                ← EXTRACTION
            </a>
            <a href="/library" class="btn btn-outline-secondary btn-sm font-monospace">
                LIBRARY (@completedSongsCount)
            </a>
        </div>
    </div>

    <!-- STATUS ALERT -->
    @if (!string.IsNullOrEmpty(statusMsg))
    {
        <div class="alert @(isError ? "alert-danger" : "alert-info") alert-dismissible fade show mb-4 py-2" role="alert">
            <small class="font-monospace">@statusMsg</small>
        </div>
    }

    <!-- STAGING REVIEW TOOLBAR -->
    <div class="card bg-secondary bg-opacity-10 border-secondary mb-4">
        <div class="card-body py-2 px-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <div class="text-uppercase text-muted font-monospace small" style="font-size: 0.75rem;">
                    Buffer Pipeline (@pendingRawCount PENDING) 
                    @if (selectedRawIds.Count > 0)
                    {
                        <span class="text-info ms-2 fw-bold">[ @selectedRawIds.Count TERPILIH ]</span>
                    }
                </div>
                <div class="small text-secondary">Review metadata & sinkronisasi data staging.</div>
            </div>
            
            <div class="d-flex gap-2 flex-wrap">
                <!-- TOMBOL AKSI MASSAL ITEM TERPILIH -->
                @if (selectedRawIds.Count > 0)
                {
                    <button class="btn btn-outline-info btn-sm font-monospace" @onclick="SmartMatchSelected" disabled="@isProcessing">
                        🔍 MATCH SELECTED (@selectedRawIds.Count)
                    </button>
                    <button class="btn btn-info btn-sm font-monospace text-dark fw-bold" @onclick="UploadSelectedToComplete" disabled="@isProcessing">
                        🚀 COMMIT SELECTED (@selectedRawIds.Count)
                    </button>
                    <button class="btn btn-outline-danger btn-sm font-monospace" @onclick="DeleteSelectedRawItems" disabled="@isProcessing">
                        ✕ DELETE SELECTED (@selectedRawIds.Count)
                    </button>
                }

                <!-- TOMBOL AKSI GLOBAL -->
                <button class="btn btn-outline-light btn-sm font-monospace" @onclick="SmartMatchAllPending" disabled="@isProcessing">
                    MATCH ALL
                </button>
                <button class="btn btn-light btn-sm font-monospace text-dark fw-bold" @onclick="UploadAllToComplete" disabled="@isProcessing">
                    COMMIT ALL
                </button>
            </div>
        </div>
    </div>

    <!-- TABLE / EMPTY STATE -->
    @if (stagingList.Count == 0)
    {
        <div class="card bg-secondary bg-opacity-10 border-secondary text-center py-5">
            <div class="card-body text-muted font-monospace small">
                NO PENDING TRACKS IN STAGING BUFFER.
            </div>
        </div>
    }
    else
    {
        <div class="card bg-dark border-secondary">
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0" style="font-size: 0.85rem; min-width: 1000px;">
                    <thead class="table-group-divider border-secondary text-uppercase text-muted font-monospace small" style="font-size: 0.7rem;">
                        <tr>
                            <th class="text-center" style="width: 40px;">
                                <input type="checkbox" class="form-check-input" checked="@IsAllSelected" @onchange="ToggleSelectAll" />
                            </th>
                            <th style="width: 180px;">Judul</th>
                            <th style="width: 150px;">Artis</th>
                            <th style="width: 140px;">Album</th>
                            <th style="width: 80px;">Tahun</th>
                            <th style="width: 70px;">Reg</th>
                            <th style="width: 80px;">Durasi</th>
                            <th>Cover URL</th>
                            <th class="text-end" style="width: 110px;">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in stagingList)
                        {
                            var isSelected = selectedRawIds.Contains(row.Id);
                            <tr class="@(isSelected ? "table-active" : "")">
                                <!-- CHECKBOX SELECT -->
                                <td class="text-center">
                                    <input type="checkbox" class="form-check-input" checked="@isSelected" @onchange="@(e => ToggleSelect(row.Id, e))" />
                                </td>

                                <!-- TITLE -->
                                <td>
                                    <input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="row.Title" />
                                </td>

                                <!-- ARTIST -->
                                <td>
                                    <input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="row.Artist" />
                                </td>

                                <!-- ALBUM -->
                                <td>
                                    <input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="row.Album" placeholder="Single" />
                                </td>

                                <!-- YEAR -->
                                <td>
                                    <input type="number" class="form-control form-control-sm bg-dark text-light border-secondary font-monospace" @bind="row.ReleaseYear" placeholder="2024" />
                                </td>

                                <!-- COUNTRY -->
                                <td>
                                    <input type="text" class="form-control form-control-sm bg-dark text-info border-secondary font-monospace" @bind="row.Country" placeholder="ID" />
                                </td>

                                <!-- DURATION -->
                                <td>
                                    <input type="number" class="form-control form-control-sm bg-dark text-light border-secondary font-monospace" @bind="row.DurationSeconds" placeholder="0" />
                                </td>

                                <!-- COVER URL -->
                                <td>
                                    <input type="text" class="form-control form-control-sm bg-dark text-muted border-secondary font-monospace" @bind="row.AlbumCoverUrl" placeholder="https://..." />
                                </td>

                                <!-- ACTIONS -->
                                <td class="text-end text-nowrap">
                                    <button class="btn btn-link btn-sm text-info p-1" title="Smart Match" @onclick="() => SmartMatchSingleRaw(row)" disabled="@isProcessing">
                                        🔍
                                    </button>
                                    <button class="btn btn-link btn-sm text-light p-1" title="Commit to Library" @onclick="() => UploadSingleRawToComplete(row)" disabled="@isProcessing">
                                        🚀
                                    </button>
                                    <button class="btn btn-link btn-sm text-danger p-1 opacity-75" title="Hapus" @onclick="() => DeleteRawItem(row.Id)" disabled="@isProcessing">
                                        ✕
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

</div>
