@page "/staging"
@namespace Hypen.Web.Pages.Staging

<PageTitle>Staging Buffer - Hypen Music Vault</PageTitle>

<div class="staging-container">
    
    <!-- HEADER -->
    <div class="staging-header">
        <div>
            <div class="pipeline-tag">System Pipeline</div>
            <h1 class="staging-title">Staging Buffer Review</h1>
        </div>
        <div class="nav-actions">
            <a href="/library/sync" class="btn-nav">← EXTRACTION</a>
            <a href="/library" class="btn-nav">LIBRARY (@completedSongsCount)</a>
        </div>
    </div>

    <!-- STATUS ALERT -->
    @if (!string.IsNullOrEmpty(statusMsg))
    {
        <div class="status-alert @(isError ? "error" : "info")">
            <p>@statusMsg</p>
        </div>
    }

    <!-- STAGING REVIEW TOOLBAR -->
    <div class="staging-toolbar">
        <div>
            <div class="toolbar-info">
                Buffer Pipeline (@pendingRawCount PENDING) 
                @if (selectedRawIds.Count > 0)
                {
                    <span class="selected-badge">[ @selectedRawIds.Count TERPILIH ]</span>
                }
            </div>
            <div class="toolbar-subtext">Review metadata & sinkronisasi data staging.</div>
        </div>
        <div class="toolbar-actions">
            @if (selectedRawIds.Count > 0)
            {
                <button class="btn-action match-selected" @onclick="SmartMatchSelected" disabled="@isProcessing">
                    🔍 MATCH SELECTED (@selectedRawIds.Count)
                </button>
                <button class="btn-action commit-selected" @onclick="UploadSelectedToComplete" disabled="@isProcessing">
                    🚀 COMMIT SELECTED (@selectedRawIds.Count)
                </button>
                <button class="btn-action delete-selected" @onclick="DeleteSelectedRawItems" disabled="@isProcessing">
                    ✕ DELETE SELECTED (@selectedRawIds.Count)
                </button>
            }

            <button class="btn-action global-action" @onclick="SmartMatchAllPending" disabled="@isProcessing">
                MATCH ALL
            </button>
            <button class="btn-action commit-all" @onclick="UploadAllToComplete" disabled="@isProcessing">
                COMMIT ALL
            </button>
        </div>
    </div>

    @if (stagingList.Count == 0)
    {
        <div class="empty-state">
            NO PENDING TRACKS IN STAGING BUFFER.
        </div>
    }
    else
    {
        <div class="table-wrapper">
            <table class="staging-table">
                <thead>
                    <tr>
                        <th class="col-checkbox">
                            <input type="checkbox" checked="@IsAllSelected" @onchange="ToggleSelectAll" class="custom-chk" />
                        </th>
                        <th class="col-title">Judul</th>
                        <th class="col-artist">Artis</th>
                        <th class="col-album">Album</th>
                        <th class="col-year">Tahun</th>
                        <th class="col-reg">Reg</th>
                        <th class="col-duration">Durasi</th>
                        <th class="col-cover">Cover URL</th>
                        <th class="col-actions">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in stagingList)
                    {
                        var isSelected = selectedRawIds.Contains(row.Id);
                        <tr class="@(isSelected ? "selected-row" : "")">
                            <td class="col-checkbox">
                                <input type="checkbox" checked="@isSelected" @onchange="@(e => ToggleSelect(row.Id, e))" class="custom-chk" />
                            </td>
                            <td>
                                <input type="text" @bind="row.Title" class="input-cell" />
                            </td>
                            <td>
                                <input type="text" @bind="row.Artist" class="input-cell" />
                            </td>
                            <td>
                                <input type="text" @bind="row.Album" placeholder="Single" class="input-cell" />
                            </td>
                            <td>
                                <input type="number" @bind="row.ReleaseYear" placeholder="2026" class="input-cell mono" />
                            </td>
                            <td>
                                <input type="text" @bind="row.Country" placeholder="ID" class="input-cell mono highlight-text" />
                            </td>
                            <td>
                                <input type="number" @bind="row.DurationSeconds" placeholder="0" class="input-cell mono" />
                            </td>
                            <td>
                                <input type="text" @bind="row.AlbumCoverUrl" placeholder="https://..." class="input-cell mono text-muted-url" />
                            </td>
                            <td class="col-actions">
                                <button class="btn-icon match" title="Smart Match" @onclick="() => SmartMatchSingleRaw(row)" disabled="@isProcessing">🔍</button>
                                <button class="btn-icon commit" title="Commit to Library" @onclick="() => UploadSingleRawToComplete(row)" disabled="@isProcessing">🚀</button>
                                <button class="btn-icon delete" title="Hapus" @onclick="() => DeleteRawItem(row.Id)" disabled="@isProcessing">✕</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <!-- MODAL SMART MATCH CANDIDATE SELECTION -->
    @if (activeReviewItem != null)
    {
        <div class="modal-backdrop">
            <div class="modal-card">
                <div class="modal-header">
                    <h3>Pilih Hasil Match Terbaik</h3>
                    <button class="btn-close" @onclick="CloseReviewModal">✕</button>
                </div>
                <div class="modal-body">
                    <p class="modal-subtext">
                        Pilih atribut lagu yang paling sesuai dengan file MP3 Anda.
                        <br />
                        <span class="reason-badge">⚠️ @activeReviewItem.MatchConfidenceReason</span>
                    </p>
                    <div class="candidate-list">
                        @foreach (var candidate in activeReviewItem.Candidates)
                        {
                            int diff = Math.Abs(candidate.DurationSeconds - (activeReviewItem.DurationSeconds ?? 0));
                            <div class="candidate-card" @onclick="() => SelectCandidate(candidate)">
                                <img src="@candidate.AlbumCoverUrl" alt="Cover" class="candidate-cover" />
                                <div class="candidate-info">
                                    <div class="candidate-title">@candidate.Title</div>
                                    <div class="candidate-artist">@candidate.Artist — <em>@candidate.Album (@(candidate.ReleaseYear?.ToString() ?? "N/A"))</em></div>
                                </div>
                                <div class="candidate-meta">
                                    <span class="diff-badge @(diff <= 3 ? "exact" : "warn")">
                                        Δ @diff Detik
                                    </span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn-nav" @onclick="CloseReviewModal">Batal</button>
                </div>
            </div>
        </div>
    }

</div>
