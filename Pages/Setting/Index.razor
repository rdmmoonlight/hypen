@page "/setting"
@rendermode @(new Microsoft.AspNetCore.Components.Web.InteractiveServerRenderMode(prerender: false))

<PageTitle>Pengaturan Akun - Hypen Vault</PageTitle>

<div class="matte-settings-container">
    <!-- Header Section -->
    <div class="matte-settings-header">
        <h2>Pengaturan Akun</h2>
        <p>Kelola integrasi OAuth YouTube dan Google Drive untuk ekosistem Hypen Vault.</p>
    </div>

    @if (IsLoading)
    {
        <div class="status-alert alert-loading">
            <div class="d-flex align-items-center gap-2">
                <span class="spinner-border spinner-border-sm" role="status"></span>
                <span>Memeriksa status otentikasi layanan Google...</span>
            </div>
        </div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="status-alert alert-error">
                <span>@ErrorMessage</span>
                <button type="button" class="btn-dismiss" @onclick="DismissError">&times;</button>
            </div>
        }

        @if (!string.IsNullOrEmpty(SuccessMessage))
        {
            <div class="status-alert alert-success">
                <span>@SuccessMessage</span>
                <button type="button" class="btn-dismiss" @onclick="DismissSuccess">&times;</button>
            </div>
        }

        <div class="integration-grid">
            <!-- 1. CARD INTEGRASI YOUTUBE -->
            <div class="matte-card">
                <div class="matte-card-header">
                    <div class="card-title-group">
                        <div class="icon-box icon-youtube">
                            <i class="bi bi-youtube"></i>
                        </div>
                        <div class="card-info">
                            <h5>YouTube Integration</h5>
                            <p>Sinkronisasi playlist, metadata, dan musik secara otomatis.</p>
                        </div>
                    </div>
                    <div>
                        <span class="status-badge @(IsYouTubeConnected ? "badge-connected" : "badge-disconnected")">
                            @(IsYouTubeConnected ? "TERHUBUNG" : "BELUM TERHUBUNG")
                        </span>
                    </div>
                </div>

                <hr class="matte-divider" />

                @if (IsYouTubeConnected)
                {
                    <div class="details-list">
                        <div class="detail-item">
                            <span class="detail-label">Account / Channel:</span>
                            <span class="detail-value highlight">@YouTubeAccountIdentifier</span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">Terakhir Diperbarui:</span>
                            <span class="detail-value">@(YouTubeLastUpdated?.ToString("dd MMM yyyy, HH:mm WIB") ?? "-")</span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">Status Token Refresh:</span>
                            <span class="detail-value success">Aktif</span>
                        </div>
                    </div>

                    <div class="card-actions">
                        <button class="btn-matte" @onclick="ReauthenticateYouTube">Hubungkan Ulang</button>
                        <button class="btn-matte btn-danger" @onclick="DisconnectYouTube">Putuskan Koneksi</button>
                    </div>
                }
                else
                {
                    <p class="text-muted style-small mb-3" style="font-size: 0.75rem;">
                        Login untuk memberikan otorisasi akses pustaka musik dan playlist YouTube Anda.
                    </p>
                    <div class="card-actions">
                        <button class="btn-matte btn-danger d-flex align-items-center gap-2" @onclick="InitiateYouTubeLogin">
                            <i class="bi bi-youtube"></i>
                            <span>Login dengan YouTube</span>
                        </button>
                    </div>
                }
            </div>

            <!-- 2. CARD INTEGRASI GOOGLE DRIVE -->
            <div class="matte-card">
                <div class="matte-card-header">
                    <div class="card-title-group">
                        <div class="icon-box icon-gdrive">
                            <i class="bi bi-google-drive"></i>
                        </div>
                        <div class="card-info">
                            <h5>Google Drive Sync</h5>
                            <p>Sinkronisasi file cadangan, database, dan file audio ke Google Drive.</p>
                        </div>
                    </div>
                    <div>
                        <span class="status-badge @(IsGDriveConnected ? "badge-connected" : "badge-disconnected")">
                            @(IsGDriveConnected ? "TERHUBUNG" : "BELUM TERHUBUNG")
                        </span>
                    </div>
                </div>

                <hr class="matte-divider" />

                @if (IsGDriveConnected)
                {
                    <div class="details-list">
                        <div class="detail-item">
                            <span class="detail-label">Akun Google:</span>
                            <span class="detail-value highlight">@GDriveAccountIdentifier</span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">Terakhir Diperbarui:</span>
                            <span class="detail-value">@(GDriveLastUpdated?.ToString("dd MMM yyyy, HH:mm WIB") ?? "-")</span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">Akses Folder Sync:</span>
                            <span class="detail-value success">Siap</span>
                        </div>
                    </div>

                    <div class="card-actions">
                        <button class="btn-matte" @onclick="ReauthenticateGDrive">Hubungkan Ulang</button>
                        <button class="btn-matte btn-danger" @onclick="DisconnectGDrive">Putuskan Koneksi</button>
                    </div>
                }
                else
                {
                    <p class="text-muted style-small mb-3" style="font-size: 0.75rem;">
                        Hubungkan akun Google Drive Anda untuk pencadangan file dan sinkronisasi pustaka lokal secara otomatis.
                    </p>
                    <div class="card-actions">
                        <button class="btn-matte btn-primary d-flex align-items-center gap-2" @onclick="InitiateGDriveLogin">
                            <i class="bi bi-google"></i>
                            <span>Login Google Drive</span>
                        </button>
                    </div>
                }
            </div>
        </div>
    }
</div>
