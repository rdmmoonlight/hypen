@page "/setting"
@using Microsoft.AspNetCore.Components.Web
@rendermode InteractiveServer

<PageTitle>Setting - YouTube Account Integration</PageTitle>

<div class="max-w-4xl mx-auto p-6 space-y-6">
    <div class="border-b pb-4">
        <h1 class="text-2xl font-bold text-gray-800">Pengaturan Akun</h1>
        <p class="text-sm text-gray-600">Kelola integrasi dan otentikasi akun YouTube Anda untuk ekosistem Hypen Vault.</p>
    </div>

    @if (IsLoading)
    {
        <div class="flex items-center space-x-3 p-4 bg-blue-50 text-blue-700 rounded-lg">
            <svg class="animate-spin h-5 w-5 text-blue-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <span>Memeriksa status otentikasi YouTube...</span>
        </div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="p-4 bg-red-100 border border-red-400 text-red-700 rounded-lg flex justify-between items-center">
                <span>@ErrorMessage</span>
                <button @onclick="DismissError" class="text-red-700 font-bold ml-4">&times;</button>
            </div>
        }

        @if (!string.IsNullOrEmpty(SuccessMessage))
        {
            <div class="p-4 bg-green-100 border border-green-400 text-green-700 rounded-lg flex justify-between items-center">
                <span>@SuccessMessage</span>
                <button @onclick="DismissSuccess" class="text-green-700 font-bold ml-4">&times;</button>
            </div>
        }

        <!-- Card Status YouTube -->
        <div class="bg-white shadow rounded-xl p-6 border border-gray-100">
            <div class="flex items-center justify-between mb-4">
                <div class="flex items-center space-x-3">
                    <div class="p-2 bg-red-100 text-red-600 rounded-lg">
                        <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                        </svg>
                    </div>
                    <div>
                        <h2 class="text-lg font-semibold text-gray-800">YouTube OAuth Integration</h2>
                        <p class="text-xs text-gray-500">Gunakan token untuk sinkronisasi playlist dan metadata YouTube.</p>
                    </div>
                </div>

                <div>
                    @if (IsConnected)
                    {
                        <span class="px-3 py-1 text-xs font-semibold text-green-800 bg-green-100 rounded-full">
                            Terhubung
                        </span>
                    }
                    else
                    {
                        <span class="px-3 py-1 text-xs font-semibold text-gray-600 bg-gray-100 rounded-full">
                            Belum Terhubung
                        </span>
                    }
                </div>
            </div>

            <hr class="my-4 border-gray-100" />

            @if (IsConnected)
            {
                <div class="space-y-3 mb-6 text-sm text-gray-700">
                    <div class="flex justify-between py-1 border-b border-gray-50">
                        <span class="font-medium text-gray-500">Account ID / Scope:</span>
                        <span class="font-mono text-gray-800">@AccountIdentifier</span>
                    </div>
                    <div class="flex justify-between py-1 border-b border-gray-50">
                        <span class="font-medium text-gray-500">Terakhir Diperbarui:</span>
                        <span>@(LastUpdated?.ToString("dd MMM yyyy, HH:mm WIB") ?? "-")</span>
                    </div>
                    <div class="flex justify-between py-1">
                        <span class="font-medium text-gray-500">Status Token Refresh:</span>
                        <span class="text-green-600 font-medium">Aktif</span>
                    </div>
                </div>

                <div class="flex justify-end space-x-3">
                    <button @onclick="Reauthenticate" class="px-4 py-2 text-sm bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium rounded-lg transition">
                        Hubungkan Ulang
                    </button>
                    <button @onclick="DisconnectAccount" class="px-4 py-2 text-sm bg-red-600 hover:bg-red-700 text-white font-medium rounded-lg transition">
                        Putuskan Koneksi
                    </button>
                </div>
            }
            else
            {
                <div class="text-sm text-gray-600 mb-6">
                    <p>Akun YouTube Anda belum dikonfigurasi. Login untuk mengizinkan aplikasi melakukan sinkronisasi lagu dan playlist secara otomatis.</p>
                </div>

                <div class="flex justify-end">
                    <button @onclick="InitiateLogin" class="px-5 py-2.5 bg-red-600 hover:bg-red-700 text-white font-medium text-sm rounded-lg shadow-sm transition flex items-center space-x-2">
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                        </svg>
                        <span>Login dengan YouTube</span>
                    </button>
                </div>
            }
        </div>
    }
</div>
