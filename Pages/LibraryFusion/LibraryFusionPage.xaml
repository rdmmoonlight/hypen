<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Hypen.Web.Models"
             x:Class="HypenMaui.Pages.LibraryFusion.LibraryFusionPage"
             Title="Library Fusion Vault"
             BackgroundColor="#121212">

    <Grid RowDefinitions="Auto, Auto, Auto, Auto, *" Padding="16" RowSpacing="12">
        
        <!-- Search Input -->
        <SearchBar x:Name="SearchInput"
                   Grid.Row="0"
                   Placeholder="Cari judul, artis, atau album..."
                   TextColor="White"
                   PlaceholderColor="Gray"
                   TextChanged="OnSearchTextChanged" />

        <!-- Status & Progress Indicator -->
        <VerticalStackLayout Grid.Row="1" Spacing="6">
            <Label x:Name="StatusLabel"
                   FontAttributes="Bold"
                   FontSize="13"
                   HorizontalOptions="Center" />
            
            <ProgressBar x:Name="DownloadProgressBar"
                         Progress="0"
                         IsVisible="False"
                         ProgressColor="#00E5FF" />
            
            <ActivityIndicator x:Name="LoadingIndicator"
                               IsRunning="False"
                               IsVisible="False"
                               Color="#00E5FF" />
        </VerticalStackLayout>

        <!-- Batch Controls -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="8">
            <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                <CheckBox x:Name="SelectAllCheckBox"
                          CheckedChanged="OnSelectAllCheckedChanged" />
                <Label Text="Pilih Semua"
                       TextColor="White"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Button Grid.Column="2"
                    Text="Unduh Terpilih"
                    BackgroundColor="#00E5FF"
                    TextColor="Black"
                    FontAttributes="Bold"
                    Clicked="OnDownloadSelectedClicked" />

            <Button Grid.Column="3"
                    Text="Hapus Terpilih"
                    BackgroundColor="#FF5252"
                    TextColor="White"
                    FontAttributes="Bold"
                    Clicked="OnDeleteSelectedClicked" />
        </Grid>

        <Separator Grid.Row="3" Color="#333333" />

        <!-- Songs CollectionView -->
        <RefreshView Grid.Row="4" x:Name="RefreshControl" Refreshing="OnRefreshTriggered">
            <CollectionView x:Name="SongsCollectionView"
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:CloudSongModel">
                        <Grid ColumnDefinitions="Auto, *, Auto, Auto"
                              Padding="8,12"
                              ColumnSpacing="12">
                            
                            <!-- Checkbox Select Item -->
                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding IsSelected}"
                                      IsEnabled="{Binding IsLocked, Converter={StaticResource InverseBoolConverter}}"
                                      CheckedChanged="OnSongCheckedChanged"
                                      VerticalOptions="Center" />

                            <!-- Info Song -->
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="{Binding Title}"
                                           TextColor="White"
                                           FontAttributes="Bold"
                                           FontSize="15"
                                           LineBreakMode="TailTruncation" />
                                    <!-- Lock Icon / Indicator -->
                                    <Label Text="🔒"
                                           FontSize="12"
                                           IsVisible="{Binding IsLocked}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Label Text="{Binding Artist}"
                                       TextColor="Gray"
                                       FontSize="13"
                                       LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>

                            <!-- Single Download -->
                            <Button Grid.Column="2"
                                    Text="⬇"
                                    BackgroundColor="#222222"
                                    TextColor="#00E5FF"
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    CornerRadius="20"
                                    CommandParameter="{Binding .}"
                                    Clicked="OnDownloadSingleClicked" />

                            <!-- Single Delete -->
                            <Button Grid.Column="3"
                                    Text="🗑"
                                    BackgroundColor="#222222"
                                    TextColor="#FF5252"
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    CornerRadius="20"
                                    CommandParameter="{Binding .}"
                                    Clicked="OnDeleteSingleClicked" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label Text="Tidak ada lagu di library vault."
                           TextColor="Gray"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
