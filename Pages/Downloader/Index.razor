@page "/downloader"
@using Hypen.Web.Components
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Downloader - Hypen Music Vault</PageTitle>

<div style="padding: 24px; background: #0a0b0e; color: #8a8f98; min-height: 100vh; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">

    <!-- HEADER -->
    <div style="margin-bottom: 24px; padding-bottom: 16px; border-bottom: 1px solid rgba(255,255,255,0.06);">
        <div style="font-size: 0.65rem; text-transform: uppercase; letter-spacing: 2px; color: #525866; margin-bottom: 4px; font-weight: 600;">System Ingestion</div>
        <h1 style="font-size: 1.25rem; color: #e6e8ec; margin: 0; font-weight: 500; letter-spacing: -0.2px;">Audio Extractor</h1>
    </div>

    <!-- INPUT PANELS -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 16px; margin-bottom: 20px;">
        <!-- Single Track Panel -->
        <div style="background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255,255,255,0.05); border-radius: 4px; padding: 18px;">
            <div style="font-size: 0.68rem; font-family: monospace; color: #525866; text-transform: uppercase; margin-bottom: 6px;">Source // Single Track</div>
            <h3 style="color: #d0d3d8; font-size: 0.88rem; font-weight: 500; margin: 0 0 12px 0;">Video / Audio Stream</h3>
            
            <input type="text" @bind="ytUrl" placeholder="URL YouTube / Music..." 
                   style="width: 100%; padding: 6px 10px; background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.08); color: #d0d3d8; border-radius: 4px; font-size: 0.75rem; font-family: monospace; outline: none; margin-bottom: 12px;" />
            
            <button style="width: 100%; background: rgba(255,255,255,0.06); color: #e6e8ec; border: 1px solid rgba(255,255,255,0.1); padding: 8px; border-radius: 4px; font-size: 0.75rem; font-family: monospace; cursor: pointer;" 
                    @onclick="ConvertVideo" disabled="@isLoading">
                EXTRACT TRACK
            </button>
        </div>

        <!-- Playlist Panel -->
        <div style="background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255,255,255,0.05); border-radius: 4px; padding: 18px;">
            <div style="font-size: 0.68rem; font-family: monospace; color: #525866; text-transform: uppercase; margin-bottom: 6px;">Source // Batch</div>
            <h3 style="color: #d0d3d8; font-size: 0.88rem; font-weight: 500; margin: 0 0 12px 0;">Playlist Stream</h3>
            
            <input type="text" @bind="playlistUrl" placeholder="URL Playlist YouTube..." 
                   style="width: 100%; padding: 6px 10px; background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.08); color: #d0d3d8; border-radius: 4px; font-size: 0.75rem; font-family: monospace; outline: none; margin-bottom: 12px;" />
            
            <button style="width: 100%; background: rgba(255,255,255,0.06); color: #e6e8ec; border: 1px solid rgba(255,255,255,0.1); padding: 8px; border-radius: 4px; font-size: 0.75rem; font-family: monospace; cursor: pointer;" 
                    @onclick="ConvertPlaylist" disabled="@isLoading">
                EXTRACT PLAYLIST
            </button>
        </div>
    </div>

    <!-- STATUS ALERT -->
    @if (!string.IsNullOrEmpty(statusMsg))
    {
        <div style="background: @(isError ? "rgba(247, 37, 133, 0.05)" : "rgba(76, 201, 240, 0.05)"); 
                    border-left: 2px solid @(isError ? "#ff4d6d" : "#4cc9f0"); 
                    padding: 8px 14px; margin-bottom: 20px; border-radius: 2px;">
            <p style="color: @(isError ? "#ff4d6d" : "#4cc9f0"); font-weight: 400; font-size: 0.75rem; margin: 0; font-family: monospace; letter-spacing: 0.3px;">
                @statusMsg
            </p>
        </div>
    }

    <!-- TERMINAL CONSOLE STREAMING -->
    @if (showTerminal)
    {
        <div style="background: #050608; border: 1px solid rgba(255,255,255,0.08); border-radius: 4px; padding: 12px; font-family: monospace;">
            <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(255,255,255,0.05); padding-bottom: 8px; margin-bottom: 10px;">
                <div style="display: flex; align-items: center; gap: 8px; font-size: 0.72rem; color: #8a8f98;">
                    <span style="width: 6px; height: 6px; border-radius: 50%; background: @(isLoading ? "#4cc9f0" : "#45a29e"); display: inline-block;"></span>
                    <span>CLI PROCESSOR // STREAM LOGS</span>
                </div>
                <div style="display: flex; gap: 8px; align-items: center;">
                    <span style="font-size: 0.68rem; color: #525866;">[STATUS: @(isLoading ? "RUNNING" : "FINISHED")]</span>

                    @if (isLoading)
                    {
                        <button style="background: transparent; border: 1px solid rgba(247, 37, 133, 0.3); color: #ff4d6d; border-radius: 2px; font-size: 0.65rem; padding: 2px 8px; cursor: pointer; font-family: monospace;" @onclick="KillTerminalProcess">
                            KILL PROCESS
                        </button>
                    }

                    <button style="background: transparent; border: 1px solid rgba(255,255,255,0.08); color: #525866; border-radius: 2px; font-size: 0.65rem; padding: 2px 8px; cursor: pointer; font-family: monospace;" @onclick="() => showTerminal = false">
                        CLOSE
                    </button>
                </div>
            </div>

            <div id="terminal-box" style="max-height: 320px; overflow-y: auto; font-size: 0.72rem; line-height: 1.4; white-space: pre-wrap; padding-right: 4px;">
                @foreach (var log in terminalLogs)
                {
                    <div style="color: @GetTerminalLogColor(log);">
                        @log
                    </div>
                }
            </div>
        </div>
    }

</div>
