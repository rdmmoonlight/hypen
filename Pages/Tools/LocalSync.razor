@page "/local-sync"
@using Hypen.Web.Data
@using Hypen.Web.Models
@using Hypen.Web.Services
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbContextFactory
@inject AudioMetadataService MetadataService

<h3>Sync MP3 Lokal</h3>

<div class="mb-3">
    <label class="form-label">Pilih Folder atau File MP3 dari Komputer:</label>
    <!-- Menggunakan HTML input biasa dengan atribut webkitdirectory agar bisa pilih 1 folder penuh -->
    <input type="file" class="form-control" 
           @attributes=@(new Dictionary<string, object> { { "webkitdirectory", true }, { "multiple", true } }) 
           @onchange="HandleFolderSelected" accept=".mp3,.wav,.m4a,.flac" />
</div>

@if (isSyncing)
{
    <div class="alert alert-info">
        <p class="mb-0">Sedang memproses... Diproses: <strong>@processedCount</strong> file dari total <strong>@totalFiles</strong> file.</p>
    </div>
}

@if (!string.IsNullOrEmpty(statusMessage))
{
    <div class="alert alert-success">
        @statusMessage
    </div>
}

@code {
    private bool isSyncing;
    private int processedCount;
    private int totalFiles;
    private string? statusMessage;

    private async Task HandleFolderSelected(ChangeEventArgs e)
    {
        // Catatan: Karena menggunakan elemen HTML <input type="file" webkitdirectory /> mentah,
        // penanganan file menggunakan interop atau dibaca via Event/Stream Blazor.
        // Jika menggunakan komponen <InputFile>, Blazor menyediakan e.GetMultipleFiles().
        // Mari kita gunakan pendekatan input standar Blazor yang mendukung multiple:
    }
}
