@page "/local-sync"
@using Hypen.Web.Data
@using Hypen.Web.Models
@using Hypen.Web.Services
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbContextFactory
@inject AudioMetadataService MetadataService

<PageTitle>Local Music Sync - Hypen Music</PageTitle>

<div class="matte-container">

    <!-- HEADER -->
    <div class="matte-header">
        <div>
            <div class="matte-subtitle">Local Storage Sync Engine</div>
            <h1 class="matte-title">Sync MP3 Lokal Ke Database</h1>
        </div>
        <div class="matte-counter">
            <i class="ti ti-folder-sync"></i> LOCAL SYNC
        </div>
    </div>

    <!-- ALERT STATUS -->
    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="status-alert alert-info">
            <p class="status-text"><i class="ti ti-info-circle"></i> @statusMessage</p>
        </div>
    }

    <!-- FILE UPLOAD CARD -->
    <div class="matte-card local-folder-card">
        <div class="matte-tag">Audio Directory &amp; File Scanner</div>
        <div class="card-title mt-2">Pilih Folder atau File Audio dari Komputer</div>
        <p class="status-text text-muted mb-3">
            Pilih folder atau beberapa file audio (.mp3, .wav, .m4a, .flac) untuk mengekstrak metadata dan menyinkronkan ke database.
        </p>

        <div class="local-folder-grid">
            <InputFile OnChange="HandleFileSelected" 
                       Multiple 
                       accept=".mp3,.wav,.m4a,.flac" 
                       class="matte-input" 
                       disabled="@isSyncing"
                       @attributes='new Dictionary<string, object> { { "webkitdirectory", "true" } }' />
        </div>

        <div class="local-folder-note">
            <span class="status-text">
                <i class="ti ti-shield-check"></i> Metadata diekstrak presisi menggunakan TagLib# dan disimpan ke tabel master SSOT.
            </span>
        </div>
    </div>

    <!-- PROGRESS / STATUS CARD -->
    @if (isSyncing)
    {
        <div class="matte-card text-center py-4">
            <div class="matte-tag">Processing Engine</div>
            <h3 class="card-title">Sedang Memproses &amp; Menyinkronkan File...</h3>
            <p class="status-text text-muted">
                Diproses: <strong>@processedCount</strong> dari total <strong>@totalFiles</strong> file.
            </p>
        </div>
    }
    else if (processedCount > 0 && !isSyncing)
    {
        <div class="matte-card text-center py-4 border-clean">
            <div class="matte-tag tag-clean">Sync Completed</div>
            <h3 class="card-title text-clean">Sinkronisasi Selesai!</h3>
            <p class="status-text text-muted">
                Berhasil memproses <strong>@processedCount</strong> file audio lokal ke dalam database.
            </p>
        </div>
    }

</div>

@code {
    private bool isSyncing;
    private int processedCount;
    private int totalFiles;
    private string? statusMessage;

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        // Perbaikan CS1739: Gunakan positional argument (2000)
        var files = e.GetMultipleFiles(2000);
        totalFiles = files.Count;
        processedCount = 0;

        if (totalFiles == 0) return;

        isSyncing = true;
        statusMessage = $"Mulai memproses {totalFiles} file audio...";
        StateHasChanged();

        try
        {
            using var dbContext = await DbContextFactory.CreateDbContextAsync();

            foreach (var file in files)
            {
                var ext = Path.GetExtension(file.Name).ToLower();
                if (ext != ".mp3" && ext != ".wav" && ext != ".m4a" && ext != ".flac")
                {
                    continue;
                }

                using var stream = file.OpenReadStream(maxAllowedSize: 1024 * 1024 * 100);
                using var memoryStream = new MemoryStream();
                await stream.CopyToAsync(memoryStream);
                memoryStream.Position = 0;

                var (artist, title) = MetadataService.ExtractMetadata(file.Name, memoryStream);

                var existingSong = await dbContext.Songs
                    .FirstOrDefaultAsync(s => s.Title.ToLower() == title.ToLower() && 
                                              s.Artist.ToLower() == artist.ToLower());

                // Perbaikan CS0266: simpan Id sebagai long
                long songId;

                if (existingSong == null)
                {
                    var newSong = new SongsModel
                    {
                        Title = title,
                        Artist = artist,
                        Status = "LOCAL_SYNC",
                        IsDownloaded = true
                    };

                    dbContext.Songs.Add(newSong);
                    await dbContext.SaveChangesAsync();
                    songId = newSong.Id;
                }
                else
                {
                    songId = existingSong.Id;
                }

                var existingLocalTrack = await dbContext.LocalTracks
                    .FirstOrDefaultAsync(lt => lt.FileName == file.Name && lt.FileSizeBytes == file.Size);

                if (existingLocalTrack == null)
                {
                    var localTrack = new LocalTrackModel
                    {
                        FilePath = file.Name,
                        FileName = file.Name,
                        FileSizeBytes = file.Size,
                        Title = title,
                        Artist = artist,
                        IsSyncedToDb = true,
                        SongId = (int)songId, // Cast explicit ke int
                        LastScannedAt = DateTime.UtcNow,
                        CreatedAt = DateTime.UtcNow,
                        UpdatedAt = DateTime.UtcNow
                    };

                    dbContext.LocalTracks.Add(localTrack);
                }
                else
                {
                    existingLocalTrack.SongId = (int)songId; // Cast explicit ke int
                    existingLocalTrack.IsSyncedToDb = true;
                    existingLocalTrack.LastScannedAt = DateTime.UtcNow;
                    existingLocalTrack.UpdatedAt = DateTime.UtcNow;
                }

                processedCount++;
                StateHasChanged();
            }

            await dbContext.SaveChangesAsync();
            statusMessage = $"Sukses menyinkronkan {processedCount} file ke database!";
        }
        catch (Exception ex)
        {
            statusMessage = $"Gagal menyinkronkan file: {ex.Message}";
        }
        finally
        {
            isSyncing = false;
            StateHasChanged();
        }
    }
}
