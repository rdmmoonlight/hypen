@page "/tools"
@using Hypen.Web.Models
@using Hypen.Web.Services
@inject SongDeduplicationEngine DedupEngine
@inject IJSRuntime JS

<PageTitle>Vault Tools - Hypen</PageTitle>

<div class="tools-container container-fluid py-4">
    <!-- Header Controls -->
    <div class="tools-header d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom border-secondary border-opacity-25">
        <div>
            <h3 class="mb-1 text-light fw-bold"><i class="bi bi-tools me-2 text-info"></i>Vault Utility Center</h3>
            <p class="text-muted mb-0 small">Pusat pemeliharaan data, pembersihan duplikasi, dan manajemen vault</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-info d-flex align-items-center gap-2" @onclick="ScanDuplicates" disabled="@isProcessing">
                @if (isProcessing)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                }
                else
                {
                    <i class="bi bi-search"></i>
                }
                <span>Scan Duplikat</span>
            </button>
            @if (duplicateGroups.Count > 0)
            {
                <button class="btn btn-danger d-flex align-items-center gap-2 fw-semibold" @onclick="PurgeSelected" disabled="@isProcessing">
                    <i class="bi bi-trash3-fill"></i>
                    <span>Purge Terpilih (@TotalToDeleteCount)</span>
                </button>
            }
        </div>
    </div>

    <!-- Alert / Status Feedback -->
    @if (!string.IsNullOrEmpty(statusMsg))
    {
        <div class="alert @(isError ? "alert-danger" : "alert-success") alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
            <i class="bi @(isError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill") fs-5"></i>
            <div>@statusMsg</div>
            <button type="button" class="btn-close ms-auto" @onclick="() => statusMsg = string.Empty"></button>
        </div>
    }

    <!-- Content State: Processing / Empty / Group Cards -->
    @if (isProcessing)
    {
        <div class="text-center py-5 my-5">
            <div class="spinner-border text-info mb-3" style="width: 3rem; height: 3rem;" role="status"></div>
            <h5 class="text-light fw-normal">Memindai seluruh isi vault...</h5>
            <p class="text-muted small">Algoritma fuzzy sedang membandingkan metadata, durasi, dan ID media.</p>
        </div>
    }
    else if (duplicateGroups.Count == 0 && hasScanned)
    {
        <div class="empty-state text-center py-5 my-4 rounded-3 border border-secondary border-opacity-25">
            <i class="bi bi-shield-check display-4 text-success d-block mb-3"></i>
            <h5 class="text-light">Vault Anda Bersih!</h5>
            <p class="text-muted small mb-0">Tidak ditemukan indikasi lagu duplikat pada database saat ini.</p>
        </div>
    }
    else
    {
        <div class="groups-wrapper">
            @foreach (var group in duplicateGroups)
            {
                <div class="card duplicate-group-card bg-dark border-secondary mb-4 shadow-sm">
                    <div class="card-header bg-dark bg-gradient d-flex justify-content-between align-items-center py-2 px-3 border-secondary border-opacity-50">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-warning text-dark font-monospace fw-bold">
                                @group.SimilarityScore% Match
                            </span>
                            <span class="text-light fw-semibold small">@group.MatchReason</span>
                        </div>
                        <small class="text-muted font-monospace">Grup Key: @group.GroupKey</small>
                    </div>
                    <div class="card-body p-3">
                        <div class="row g-3">
                            @foreach (var song in group.Items)
                            {
                                bool isKeep = group.KeepSongId == song.Id;
                                <div class="col-md-6">
                                    <div class="card comparison-card h-100 @(isKeep ? "keep-state" : "purge-state")"
                                         @onclick="() => group.KeepSongId = song.Id">
                                        <div class="card-body p-3 d-flex flex-column justify-content-between">
                                            <div>
                                                <!-- Action Indicator Radio -->
                                                <div class="d-flex justify-content-between align-items-center mb-3">
                                                    <div class="form-check">
                                                        <input class="form-check-input" type="radio" name="radio-@group.GroupKey" checked="@isKeep" readOnly />
                                                        <label class="form-check-label fw-bold @(isKeep ? "text-success" : "text-danger")">
                                                            @(isKeep ? "SIMPAN (MASTER)" : "KANDIDAT HAPUS")
                                                        </label>
                                                    </div>
                                                    <span class="badge bg-secondary bg-opacity-50 text-light font-monospace">#@song.Id</span>
                                                </div>

                                                <!-- Song Details -->
                                                <div class="d-flex align-items-center gap-3 mb-2">
                                                    <div class="cover-wrapper rounded overflow-hidden flex-shrink-0 bg-secondary bg-opacity-25">
                                                        @if (!string.IsNullOrEmpty(song.AlbumCoverUrl))
                                                        {
                                                            <img src="@song.AlbumCoverUrl" alt="Cover" class="cover-img" />
                                                        }
                                                        else
                                                        {
                                                            <div class="cover-placeholder d-flex align-items-center justify-content-center h-100 text-muted">
                                                                <i class="bi bi-music-note"></i>
                                                            </div>
                                                        }
                                                    </div>
                                                    <div class="overflow-hidden">
                                                        <h6 class="mb-1 text-light text-truncate" title="@song.Title">@song.Title</h6>
                                                        <p class="small text-muted mb-0 text-truncate"><i class="bi bi-person me-1"></i>@(string.IsNullOrEmpty(song.Artist) ? "-" : song.Artist)</p>
                                                    </div>
                                                </div>

                                                <!-- Metadata Table Badges -->
                                                <div class="metadata-grid mt-3 pt-2 border-top border-secondary border-opacity-25 small">
                                                    <div class="d-flex justify-content-between text-muted mb-1">
                                                        <span>Album:</span>
                                                        <span class="text-light text-truncate ms-2 ms-title">@(string.IsNullOrEmpty(song.Album) ? "-" : song.Album)</span>
                                                    </div>
                                                    <div class="d-flex justify-content-between text-muted mb-1">
                                                        <span>Durasi:</span>
                                                        <span class="text-light font-monospace">@(song.DurationSeconds.HasValue ? $"{song.DurationSeconds}s" : "-")</span>
                                                    </div>
                                                    <div class="d-flex justify-content-between text-muted">
                                                        <span>Source ID:</span>
                                                        <span class="text-light font-monospace text-truncate ms-2 ms-title">
                                                            @(string.IsNullOrEmpty(song.YoutubeVideoId) ? "-" : song.YoutubeVideoId)
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="mt-3 pt-2 text-end border-top border-secondary border-opacity-10">
                                                <span class="small text-muted">Klik kartu ini untuk menjadikan Master</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<DuplicateGroupModel> duplicateGroups = [];
    private bool isProcessing;
    private bool hasScanned;
    private string statusMsg = "";
    private bool isError;

    private int TotalToDeleteCount => duplicateGroups.Sum(g => g.Items.Count - 1);

    private async Task ScanDuplicates()
    {
        try
        {
            isProcessing = true;
            statusMsg = string.Empty;
            duplicateGroups = await DedupEngine.ScanAllDuplicatesAsync();
            hasScanned = true;
            
            if (duplicateGroups.Count > 0)
            {
                statusMsg = $"Berhasil memindai vault! Ditemukan {duplicateGroups.Count} kelompok lagu yang terindikasi duplikat.";
                isError = false;
            }
        }
        catch (Exception ex)
        {
            statusMsg = $"Gagal memindai database: {ex.Message}";
            isError = true;
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task PurgeSelected()
    {
        bool confirm = await JS.InvokeAsync<bool>("confirm", $"Konfirmasi: Yakin ingin menghapus {TotalToDeleteCount} lagu duplikat terpilih dari Vault?");
        if (!confirm) return;

        try
        {
            isProcessing = true;
            int deleted = await DedupEngine.PurgeDuplicatesAsync(duplicateGroups);
            statusMsg = $"Berhasil membersihkan {deleted} lagu duplikat dari Vault beserta penyesuaian relasinya!";
            isError = false;
            await ScanDuplicates();
        }
        catch (Exception ex)
        {
            statusMsg = $"Gagal mengeksekusi purge: {ex.Message}";
            isError = true;
        }
        finally
        {
            isProcessing = false;
        }
    }
}
