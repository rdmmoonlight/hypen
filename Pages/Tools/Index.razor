@page "/tools"
@using Hypen.Web.Models
@using Hypen.Web.Services

<PageTitle>Vault Tools Center - Hypen</PageTitle>

<div class="container-fluid py-4 tools-vault-container">

    <!-- Header -->
    <div class="tools-header d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-3 border-bottom border-secondary border-opacity-25 gap-3">
        <div>
            <h3 class="mb-1 text-light fw-bold">
                <i class="bi bi-tools text-info me-2"></i>Vault Maintenance Center
            </h3>
            <p class="text-muted mb-0 small">
                Pusat pemeliharaan data, pembersihan duplikasi, dan optimalisasi struktur vault.
            </p>
        </div>

        <div class="d-flex align-items-center gap-2 flex-wrap">
            <button class="btn btn-outline-info px-4 py-2 rounded-3 text-nowrap fw-semibold shadow-sm"
                    @onclick="ScanDuplicates"
                    disabled="@isProcessing">
                @if (isProcessing)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                    <span>Memindai...</span>
                }
                else
                {
                    <i class="bi bi-search me-2"></i>
                    <span>Scan Vault</span>
                }
            </button>

            @if (duplicateGroups.Count > 0)
            {
                <button class="btn btn-danger px-4 py-2 rounded-3 text-nowrap fw-semibold shadow-sm"
                        @onclick="PurgeSelected"
                        disabled="@isProcessing">
                    <i class="bi bi-trash me-2"></i>
                    Purge Selected (@TotalToDeleteCount)
                </button>
            }
        </div>
    </div>

    <!-- Status -->
    @if (!string.IsNullOrEmpty(statusMsg))
    {
        <div class="alert @(isError ? "alert-danger" : "alert-success")
                    bg-opacity-10 border-0 text-light alert-dismissible fade show
                    rounded-3 shadow-sm mb-4"
             role="alert">

            <i class="bi @(isError
                ? "bi-exclamation-triangle-fill text-danger"
                : "bi-check-circle-fill text-success") me-2 fs-5">
            </i>

            <span>@statusMsg</span>

            <button type="button"
                    class="btn-close btn-close-white"
                    @onclick="() => statusMsg = string.Empty">
            </button>
        </div>
    }

    <!-- Initial State -->
    @if (!hasScanned && !isProcessing)
    {
        <div class="vault-state-card card bg-dark bg-opacity-50 border-secondary border-opacity-25 rounded-4 text-center shadow">
            <div class="card-body">
                <i class="bi bi-cpu display-3 text-info mb-3"></i>
                <h4 class="text-light fw-bold mb-2">Mulai Pemindaian Vault</h4>
                <p class="text-muted small mb-0">
                    Klik <strong class="text-info">Scan Vault</strong>
                    untuk mendeteksi klaster duplikat secara otomatis.
                </p>
            </div>
        </div>
    }

    <!-- Loading State -->
    @if (isProcessing)
    {
        <div class="vault-state-card card bg-dark bg-opacity-50 border-secondary border-opacity-25 rounded-4 text-center shadow">
            <div class="card-body">
                <div class="spinner-border text-info vault-spinner mb-3" role="status"></div>
                <h5 class="text-light fw-bold mb-2">Memindai Seluruh Isi Vault...</h5>
                <p class="text-muted small mb-0">
                    Menganalisis kemiripan judul, artis, durasi, dan ID eksternal secara presisi.
                </p>
            </div>
        </div>
    }

    <!-- Clean State -->
    @if (hasScanned && !isProcessing && duplicateGroups.Count == 0)
    {
        <div class="vault-state-card card bg-dark bg-opacity-50 border-success border-opacity-25 rounded-4 text-center shadow">
            <div class="card-body">
                <i class="bi bi-shield-check display-3 text-success mb-3"></i>
                <h4 class="text-light fw-bold mb-2">Vault Anda Clean & Pristine!</h4>
                <p class="text-muted small mb-0">
                    Tidak ditemukan lagu duplikat berdasarkan parameter toleransi saat ini.
                </p>
            </div>
        </div>
    }

    <!-- Duplicate Clusters -->
    @if (hasScanned && !isProcessing && duplicateGroups.Count > 0)
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <span class="text-muted small">
                Terdeteksi
                <strong class="text-warning">@duplicateGroups.Count</strong>
                kelompok duplikat.
            </span>

            <span class="badge bg-secondary bg-opacity-50 text-light fw-normal px-3 py-2 rounded-pill">
                <i class="bi bi-lightbulb me-1"></i>
                Klik kartu lagu untuk menentukan Master
            </span>
        </div>

        <div class="row g-3">
            @foreach (var group in duplicateGroups)
            {
                <div class="col-12">
                    <div class="card bg-dark bg-opacity-75 border-secondary border-opacity-25 rounded-4 shadow-sm overflow-hidden">

                        <!-- Cluster Header -->
                        <div class="card-header cluster-header bg-secondary bg-opacity-10 border-bottom border-secondary border-opacity-25">
                            <div class="d-flex align-items-center gap-2 min-width-0">
                                <span class="badge bg-warning text-dark fw-bold rounded-2">
                                    @group.MatchReason
                                </span>

                                <span class="text-light fw-semibold text-truncate">
                                    Grup: @group.GroupKey
                                </span>
                            </div>

                            <span class="text-muted small font-monospace text-nowrap">
                                Kemiripan: @group.SimilarityScore%
                            </span>
                        </div>

                        <!-- Songs -->
                        <div class="card-body p-3">
                            <div class="row g-3">
                                @foreach (var song in group.Items)
                                {
                                    bool isKeep = group.KeepSongId == song.Id;

                                    <div class="col-md-6">
                                        <div class="card song-comparison-card h-100
                                            @(isKeep
                                                ? "border-success bg-success bg-opacity-10"
                                                : "border-secondary border-opacity-25 bg-dark bg-opacity-50 opacity-75")"
                                             @onclick="() => SelectMaster(group, song.Id)"
                                             role="button">

                                            <div class="card-body p-3 d-flex flex-column justify-content-between">

                                                <div>
                                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                                        <div class="form-check mb-0">
                                                            <input class="form-check-input"
                                                                   type="radio"
                                                                   name="keep-group-@group.GroupKey.GetHashCode()"
                                                                   checked="@isKeep"
                                                                   readOnly />

                                                            <label class="form-check-label fw-bold small
                                                                @(isKeep ? "text-success" : "text-danger")">
                                                                @(isKeep
                                                                    ? "🟢 SIMPAN (MASTER)"
                                                                    : "🔴 HAPUS (KANDIDAT)")
                                                            </label>
                                                        </div>

                                                        <span class="badge bg-black bg-opacity-50 text-muted font-monospace border border-secondary border-opacity-25">
                                                            #@song.Id
                                                        </span>
                                                    </div>

                                                    <h6 class="mb-1 text-light fw-bold text-truncate">
                                                        @song.Title
                                                    </h6>

                                                    <p class="small text-muted mb-2 text-truncate">
                                                        <i class="bi bi-mic me-1"></i>
                                                        @(song.Artist ?? "Unknown Artist")
                                                        <span class="mx-1">•</span>
                                                        <i class="bi bi-disc me-1"></i>
                                                        @(song.Album ?? "-")
                                                    </p>
                                                </div>

                                                <div class="song-meta pt-2 mt-2 border-top border-secondary border-opacity-25">
                                                    <span>
                                                        <i class="bi bi-clock me-1"></i>
                                                        @(song.DurationSeconds ?? 0)s
                                                    </span>

                                                    <div class="d-flex gap-2">
                                                        <span>
                                                            Cover:
                                                            @(!string.IsNullOrEmpty(song.AlbumCoverUrl)
                                                                ? "🖼️ Ada"
                                                                : "❌ Absen")
                                                        </span>

                                                        <span>
                                                            Source:
                                                            @(string.IsNullOrEmpty(song.YoutubeVideoId)
                                                                ? "LOCAL"
                                                                : song.YoutubeVideoId)
                                                        </span>
                                                    </div>
                                                </div>

                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                    </div>
                </div>
            }
        </div>
    }
</div>
