@page "/tools"
@using Hypen.Web.Models
@using Hypen.Web.Services

<PageTitle>Database Tools Center - Hypen Music</PageTitle>

<div class="matte-container">

    <!-- TAB NAVIGATION BAR -->
    <div class="matte-tabs">
        <button class="tab-item @(activeTab == "dedup" ? "active" : "")" @onclick='() => SwitchTab("dedup")'>
            <i class="ti ti-search"></i> DUPLICATE DETECTOR
        </button>
        <button class="tab-item @(activeTab == "local" ? "active" : "")" @onclick='() => SwitchTab("local")'>
            <i class="ti ti-folder-sync"></i> LOCAL SYNC
        </button>
        <button class="tab-item @(activeTab == "gdrive" ? "active" : "")" @onclick='() => SwitchTab("gdrive")'>
            <i class="ti ti-brand-google-drive"></i> GDRIVE MANAGEMENT
        </button>
    </div>

    <!-- ALERT STATUS -->
    @if (!string.IsNullOrEmpty(statusMsg))
    {
        <div class="status-alert @(isError ? "alert-error" : "alert-info")">
            <p class="status-text">@statusMsg</p>
        </div>
    }

    <!-- ========================================================================= -->
    <!-- TAB 1: DUPLICATE DETECTOR -->
    <!-- ========================================================================= -->
    @if (activeTab == "dedup")
    {
        <!-- HEADER -->
        <div class="matte-header">
            <div>
                <div class="matte-subtitle">System Maintenance</div>
                <h1 class="matte-title">Database Duplicate Detector</h1>
            </div>
            <div class="matte-counter">
                @duplicateGroups.Count CLUSTERS
            </div>
        </div>

        <!-- TOOLBAR -->
        <div class="matte-toolbar">
            <div class="matte-action-group">
                <button class="btn-matte btn-primary" @onclick="ScanDuplicates" disabled="@isProcessing">
                    <i class="ti ti-scan"></i> @(isProcessing ? "MEMINDAI DATABASE..." : "SCAN DATABASE FOR DUPLICATES")
                </button>

                @if (duplicateGroups.Count > 0)
                {
                    <button class="btn-matte btn-danger" @onclick="PurgeSelected" disabled="@(isProcessing || TotalToDeleteCount == 0)">
                        <i class="ti ti-trash"></i> PURGE TERPILIH (@TotalToDeleteCount)
                    </button>
                }
            </div>

            <div class="matte-search-group">
                <span class="status-badge"><i class="ti ti-database-check"></i> STATUS DB: OK</span>
            </div>
        </div>

        <!-- CONTENT DISPLAY -->
        @if (!hasScanned && !isProcessing)
        {
            <div class="matte-card text-center py-4">
                <div class="matte-tag">Maintenance Engine</div>
                <h3 class="card-title">Mulai Pemindaian Database</h3>
                <p class="status-text text-muted">
                    Klik <strong>SCAN DATABASE FOR DUPLICATES</strong> di atas untuk mendeteksi klaster lagu yang mirip secara otomatis.
                </p>
            </div>
        }
        else if (isProcessing)
        {
            <div class="matte-card text-center py-4">
                <div class="matte-tag">Analyzing Audio Metadata</div>
                <h3 class="card-title">Memindai Seluruh Isi Database...</h3>
                <p class="status-text text-muted">
                    Menganalisis kemiripan judul, artis, durasi, dan ID eksternal secara presisi.
                </p>
            </div>
        }
        else if (hasScanned && duplicateGroups.Count == 0)
        {
            <div class="matte-card text-center py-4 border-clean">
                <div class="matte-tag tag-clean">Database Status // Clean</div>
                <h3 class="card-title text-clean">Database Clean &amp; Pristine!</h3>
                <p class="status-text text-muted">
                    Tidak ditemukan lagu duplikat berdasarkan parameter toleransi saat ini.
                </p>
            </div>
        }
        else if (duplicateGroups.Count > 0)
        {
            <div class="preview-container">
                <div class="preview-header">
                    <span>TERDETEKSI (@duplicateGroups.Count:N0) KELOMPOK DUPLIKAT</span>
                    <span class="dup-summary-tag">@TotalToDeleteCount:N0 SONGS WILL BE REMOVED FROM DATABASE</span>
                </div>

                <div class="cluster-list">
                    @foreach (var group in duplicateGroups)
                    {
                        <div class="matte-card cluster-card">
                            <div class="cluster-sub-header">
                                <div class="cluster-title-info">
                                    <span class="badge-dup">@group.MatchReason</span>
                                    <span class="cluster-key">Grup: @group.GroupKey</span>
                                </div>
                                <span class="score-tag">Score: @group.SimilarityScore%</span>
                            </div>

                            <div class="song-compact-grid">
                                @foreach (var song in group.Items)
                                {
                                    bool isMaster = group.KeepSongId == song.Id;
                                    <div class="song-compact-card @(isMaster ? "card-keep" : "card-purge")"
                                         @onclick="() => OnMasterSelected(group, song.Id)">

                                        <div class="compact-card-header">
                                            <button type="button"
                                                    class="badge-action @(isMaster ? "badge-keep-btn" : "badge-purge-btn")"
                                                    @onclick:stopPropagation="true"
                                                    @onclick="() => OnMasterSelected(group, song.Id)">
                                                <i class="ti @(isMaster ? "ti-bookmark-check" : "ti-trash")"></i>
                                                @(isMaster ? "SIMPAN (MASTER)" : "HAPUS")
                                            </button>
                                            <span class="song-id-tag">#@song.Id</span>
                                        </div>

                                        <div class="compact-card-body">
                                            <div class="compact-song-title">@song.Title</div>
                                            <div class="compact-song-artist">
                                                @(song.Artist ?? "Unknown Artist") • @(song.Album ?? "Single")
                                            </div>
                                        </div>

                                        <div class="compact-card-footer">
                                            <span><i class="ti ti-clock"></i> @(song.DurationSeconds.HasValue ? TimeSpan.FromSeconds(song.DurationSeconds.Value).ToString(@"mm\:ss") : "-")</span>
                                            <span><i class="ti ti-photo"></i> @(!string.IsNullOrEmpty(song.AlbumCoverUrl) ? "Ada" : "Absen")</span>
                                            <span><i class="ti ti-id"></i> @(string.IsNullOrEmpty(song.YoutubeVideoId) ? "LOCAL" : song.YoutubeVideoId)</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }

    <!-- ========================================================================= -->
    <!-- TAB 2: LOCAL SYNC -->
    <!-- ========================================================================= -->
    @if (activeTab == "local")
    {
        <!-- HEADER -->
        <div class="matte-header">
            <div>
                <div class="matte-subtitle">Local Library Integration</div>
                <h1 class="matte-title">Local Music Sync</h1>
            </div>
            <div class="matte-counter">
                @localSongCount SONGS
            </div>
        </div>

        <!-- LOCAL SYNC INFO -->
        <div class="matte-card local-sync-card">
            <div class="matte-tag">Local Library Synchronization</div>
            <div class="local-sync-description">
                <h3 class="card-title">Sinkronisasi Koleksi Musik Lokal</h3>
                <p class="status-text text-muted">
                    Gunakan modul ini untuk memeriksa koleksi musik lokal terhadap database Hypen.
                </p>
            </div>

            <div class="local-sync-grid">
                <div class="local-stat">
                    <span class="local-stat-label">DATABASE SONGS</span>
                    <strong>@localSongCount</strong>
                </div>
                <div class="local-stat">
                    <span class="local-stat-label">LOCAL AUDIO</span>
                    <strong>@localAudioCount</strong>
                </div>
                <div class="local-stat">
                    <span class="local-stat-label">SYNC STATUS</span>
                    <strong class="@(localSyncClean ? "text-clean" : "text-warning")">
                        <i class="ti @(localSyncClean ? "ti-circle-check" : "ti-alert-circle")"></i>
                        @(localSyncClean ? "READY" : "CHECK REQUIRED")
                    </strong>
                </div>
            </div>
        </div>

        <!-- LOCAL FOLDER -->
        <div class="matte-card local-folder-card">
            <div class="matte-tag">Local Source</div>
            <div class="local-folder-grid">
                <input type="text" class="matte-input" @bind="localFolderPath" placeholder="Path folder musik lokal..." />
                <button class="btn-matte btn-primary" @onclick="ScanLocalLibrary" disabled="@isProcessing">
                    <i class="ti ti-folder-search"></i> @(isProcessing ? "SCANNING..." : "SCAN LOCAL LIBRARY")
                </button>
            </div>
            <div class="local-folder-note">
                <span class="status-text">
                    <i class="ti ti-info-circle"></i> Path lokal hanya dapat diproses oleh aplikasi/server jika folder tersebut dapat diakses oleh runtime Hypen.
                </span>
            </div>
        </div>

        <!-- LOCAL TOOLBAR -->
        <div class="matte-toolbar">
            <div class="matte-action-group">
                <button class="btn-matte" @onclick="LoadLocalLibrary" disabled="@isProcessing">
                    <i class="ti ti-refresh"></i> REFRESH LOCAL INDEX
                </button>
                <button class="btn-matte btn-success" @onclick="SyncLocalLibrary" disabled="@(isProcessing || localAudioCount == 0)">
                    <i class="ti ti-database-import"></i> SYNC TO DATABASE
                </button>
            </div>

            <div class="matte-search-group">
                <span class="status-badge"><i class="ti ti-files"></i> INDEXED: @localAudioCount</span>
                @if (localMissingCount > 0)
                {
                    <span class="dup-summary-tag"><i class="ti ti-alert-triangle"></i> MISSING: @localMissingCount</span>
                }
            </div>
        </div>

        <!-- LOCAL CONTENT DISPLAY -->
        @if (isProcessing && localAudioCount == 0)
        {
            <div class="matte-card text-center py-4">
                <div class="matte-tag">Local Storage Scanner</div>
                <h3 class="card-title">Memindai Koleksi Musik Lokal...</h3>
                <p class="status-text text-muted">Sistem sedang membaca indeks file audio lokal.</p>
            </div>
        }
        else if (!isProcessing && localAudioCount == 0)
        {
            <div class="matte-card text-center py-4">
                <div class="matte-tag">Local Index Empty</div>
                <h3 class="card-title">Belum Ada Koleksi Lokal Terindeks</h3>
                <p class="status-text text-muted">
                    Masukkan path folder musik lokal kemudian jalankan <strong>SCAN LOCAL LIBRARY</strong>.
                </p>
            </div>
        }
        else
        {
            <div class="preview-container">
                <div class="preview-header">
                    <span>LOCAL MUSIC INDEX (@localAudioCount:N0)</span>
                    <span class="@(localSyncClean ? "status-badge" : "dup-summary-tag")">
                        @(localSyncClean ? "SYNC READY" : $"{localMissingCount} NEED ATTENTION")
                    </span>
                </div>

                <div class="cluster-list">
                    <div class="local-sync-result">
                        <div class="local-result-row">
                            <span>LOCAL AUDIO FILES</span>
                            <strong>@localAudioCount</strong>
                        </div>
                        <div class="local-result-row">
                            <span>DATABASE SONGS</span>
                            <strong>@localSongCount</strong>
                        </div>
                        <div class="local-result-row">
                            <span>MISSING / UNMATCHED</span>
                            <strong class="@(localMissingCount > 0 ? "text-danger" : "text-clean")">@localMissingCount</strong>
                        </div>
                        <div class="local-result-row">
                            <span>SYNC STATE</span>
                            <strong class="@(localSyncClean ? "text-clean" : "text-warning")">
                                @(localSyncClean ? "CLEAN" : "REVIEW")
                            </strong>
                        </div>
                    </div>
                </div>
            </div>
        }
    }

    <!-- ========================================================================= -->
    <!-- TAB 3: GDRIVE MANAGEMENT -->
    <!-- ========================================================================= -->
    @if (activeTab == "gdrive")
    {
        <!-- HEADER -->
        <div class="matte-header">
            <div>
                <div class="matte-subtitle">Storage Integration</div>
                <h1 class="matte-title">Google Drive Tracks Management</h1>
            </div>
            <div class="matte-counter">
                @gdriveTracks.Count FILES TERDATA
            </div>
        </div>

        <!-- GDRIVE DIRECT FETCH PANEL -->
        <div class="matte-card gdrive-fetch-card">
            <div class="matte-tag">Direct Google Drive Sync (Authenticated Session)</div>
            <div class="gdrive-input-grid">
                <input type="text" @bind="gdriveFolderId" placeholder="Folder ID Spesifik (Opsional - Kosongkan untuk scan seluruh Drive)" class="matte-input" />
                <button class="btn-matte btn-primary" @onclick="FetchDriveFiles" disabled="@isProcessing">
                    <i class="ti ti-download"></i> FETCH DIRECTLY FROM MY GDRIVE
                </button>
            </div>
        </div>

        <!-- TOOLBAR -->
        <div class="matte-toolbar">
            <div class="matte-action-group">
                <button class="btn-matte" @onclick="LoadDriveTracks" disabled="@isProcessing">
                    <i class="ti ti-refresh"></i> REFRESH LOCAL INDEX
                </button>

                @if (UnlinkedCount > 0)
                {
                    <button class="btn-matte btn-success" @onclick="AutoLinkTracks" disabled="@isProcessing">
                        <i class="ti ti-link"></i> AUTO-LINK TO SONGS (@UnlinkedCount)
                    </button>
                }
            </div>

            <div class="matte-search-group">
                <span class="status-badge"><i class="ti ti-link"></i> LINKED: @LinkedCount</span>
                <span class="dup-summary-tag"><i class="ti ti-unlink"></i> UNLINKED: @UnlinkedCount</span>
            </div>
        </div>

        <!-- CONTENT DISPLAY -->
        @if (isProcessing && gdriveTracks.Count == 0)
        {
            <div class="matte-card text-center py-4">
                <div class="matte-tag">Storage Indexing</div>
                <h3 class="card-title">Memuat / Mengunduh Indeks Google Drive...</h3>
                <p class="status-text text-muted">Sedang terhubung langsung ke akun Google Drive Anda...</p>
            </div>
        }
        else if (!isProcessing && gdriveTracks.Count == 0)
        {
            <div class="matte-card text-center py-4">
                <div class="matte-tag">Indeks Kosong</div>
                <h3 class="card-title">Belum Ada File MP3 Terindeks dari Google Drive</h3>
                <p class="status-text text-muted">
                    Klik <strong>FETCH DIRECTLY FROM MY GDRIVE</strong> untuk memindai file MP3 langsung dari akun Google Drive Anda yang terhubung.
                </p>
            </div>
        }
        else
        {
            <div class="preview-container">
                <div class="preview-header">
                    <span>DATABASE GDRIVE TRACKS (@gdriveTracks.Count:N0)</span>
                    <span class="dup-summary-tag">@UnlinkedCount FILE BELUM TERHUBUNG</span>
                </div>

                <div class="cluster-list">
                    <div class="song-compact-grid">
                        @foreach (var track in gdriveTracks)
                        {
                            <div class="song-compact-card @(track.IsLinkedToSong ? "card-keep" : "card-purge")">
                                <div class="compact-card-header">
                                    <span class="@(track.IsLinkedToSong ? "badge-keep-btn" : "badge-purge-btn") badge-action">
                                        <i class="ti @(track.IsLinkedToSong ? "ti-link" : "ti-unlink")"></i>
                                        @(track.IsLinkedToSong ? "LINKED TO SONG" : "UNLINKED")
                                    </span>
                                    <span class="song-id-tag">ID: #@track.Id</span>
                                </div>

                                <div class="compact-card-body">
                                    <div class="compact-song-title">@(string.IsNullOrEmpty(track.Title) ? track.FileName : track.Title)</div>
                                    <div class="compact-song-artist">
                                        Artis: @(track.Artist ?? "Unknown Artist") • ID Drive: @track.FileId
                                    </div>
                                </div>

                                <div class="compact-card-footer">
                                    <span><i class="ti ti-clock"></i> @(TimeSpan.FromSeconds(track.DurationSeconds).ToString(@"mm\:ss"))</span>
                                    <span><i class="ti ti-hard-drive"></i> @((track.FileSizeBytes / (1024.0 * 1024.0)).ToString("0.0")) MB</span>
                                    @if (track.SongId.HasValue)
                                    {
                                        <span><i class="ti ti-music"></i> Song Ref: #@track.SongId</span>
                                    }
                                    else
                                    {
                                        <span><i class="ti ti-alert-circle"></i> Ref: None</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    }

</div>
