@page "/tools"
@using Hypen.Web.Models
@using Hypen.Web.Services

<PageTitle>Database Tools Center - Hypen Music</PageTitle>

<div class="library-container">

    <!-- ALERT STATUS -->
    @if (!string.IsNullOrEmpty(statusMsg))
    {
        <div class="alert-box @(isError ? "error" : "success")">
            <p class="alert-text">@statusMsg</p>
        </div>
    }

    <!-- HEADER -->
    <div class="header-section">
        <div>
            <div class="subtitle">System Maintenance</div>
            <h1 class="main-title">Duplicate Detector</h1>
        </div>
        <div class="track-counter">
            @duplicateGroups.Count CLUSTERS
        </div>
    </div>

    <!-- TOOLBAR -->
    <div class="toolbar">
        <div class="action-group">
            <button class="btn-refresh" @onclick="ScanDuplicates" disabled="@isProcessing">
                @(isProcessing ? "MEMINDAI DATABASE..." : "SCAN DATABASE")
            </button>

            @if (duplicateGroups.Count > 0)
            {
                <button class="btn-delete" @onclick="PurgeSelected" disabled="@(isProcessing || TotalToDeleteCount == 0)">
                    ✕ PURGE TERPILIH (@TotalToDeleteCount)
                </button>
            }
        </div>

        <div class="search-group">
            <span class="stream-ready">STATUS DB: OK</span>
        </div>
    </div>

    <!-- CONTENT DISPLAY -->
    @if (!hasScanned && !isProcessing)
    {
        <div class="table-empty py-5">
            Mulai pemindaian untuk menganalisis klaster duplikat di database.
        </div>
    }
    else if (isProcessing)
    {
        <div class="table-empty py-5">
            MEMINDAI SELURUH ISI DATABASE...
        </div>
    }
    else if (hasScanned && duplicateGroups.Count == 0)
    {
        <div class="table-empty py-5" style="color: #45a29e;">
            DATABASE CLEAN & PRISTINE! Tidak ditemukan lagu duplikat.
        </div>
    }
    else if (duplicateGroups.Count > 0)
    {
        <div class="table-responsive">
            <table class="vault-table">
                <thead>
                    <tr>
                        <th class="col-checkbox">Master</th>
                        <th>Keterangan / Match</th>
                        <th>Judul</th>
                        <th>Artis</th>
                        <th>Album</th>
                        <th>Durasi</th>
                        <th>YT ID</th>
                        <th class="col-status">Status Tindakan</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var group in duplicateGroups)
                    {
                        <!-- Header Baris Klaster -->
                        <tr class="data-row" style="background: rgba(255, 255, 255, 0.03);">
                            <td colspan="8" style="font-family: monospace; font-size: 0.75rem; color: #45a29e; padding: 6px 12px;">
                                <strong>KLASTER:</strong> @group.GroupKey | <strong>REASON:</strong> @group.MatchReason | <strong>SCORE:</strong> @group.SimilarityScore%
                            </td>
                        </tr>

                        <!-- Item Lagu Dalam Klaster -->
                        @foreach (var song in group.Items)
                        {
                            bool isMaster = group.KeepSongId == song.Id;
                            <tr @key="song.Id" class="data-row @(isMaster ? "" : "row-duplicate")">
                                <td class="col-checkbox">
                                    <input type="radio" 
                                           name="@($"group_{group.GetHashCode()}")" 
                                           checked="@isMaster" 
                                           @onchange="() => OnMasterSelected(group, song.Id)" 
                                           class="checkbox-input" />
                                </td>
                                <td class="cell-id">#@song.Id</td>
                                <td class="cell-title">@song.Title</td>
                                <td class="cell-artist">@(song.Artist ?? "Unknown Artist")</td>
                                <td class="cell-album">@(song.Album ?? "Single")</td>
                                <td class="cell-mono">@(song.DurationSeconds.HasValue ? TimeSpan.FromSeconds(song.DurationSeconds.Value).ToString(@"mm\:ss") : "-")</td>
                                <td class="cell-id">@(string.IsNullOrEmpty(song.YoutubeVideoId) ? "LOCAL" : song.YoutubeVideoId)</td>
                                <td class="col-status">
                                    @if (isMaster)
                                    {
                                        <span class="badge badge-complete">SIMPAN (MASTER)</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-incomplete">AKAN DIHAPUS</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</div>
