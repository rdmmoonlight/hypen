@page "/library"
@page "/"

<PageTitle>Library</PageTitle>

<div style="padding: 24px; background: #0a0b0e; color: #8a8f98; min-height: 100vh; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">

    @if (!string.IsNullOrEmpty(statusMsg))
    {
        <div style="background: @(isError ? "rgba(247, 37, 133, 0.05)" : "rgba(76, 201, 240, 0.05)"); 
                    border-left: 2px solid @(isError ? "#ff4d6d" : "#4cc9f0"); 
                    padding: 8px 14px; margin-bottom: 20px; border-radius: 2px;">
            <p style="color: @(isError ? "#ff4d6d" : "#4cc9f0"); font-weight: 400; font-size: 0.75rem; margin: 0; letter-spacing: 0.3px;">
                @statusMsg
            </p>
        </div>
    }

    <!-- INTROVERT AUDIOPHILE HEADER (NO LARGE ARTWORK) -->
    <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 28px; padding-bottom: 16px; border-bottom: 1px solid rgba(255,255,255,0.06);">
        <div>
            <div style="font-size: 0.65rem; text-transform: uppercase; letter-spacing: 2px; color: #525866; margin-bottom: 4px; font-weight: 600;">Personal Vault</div>
            <h1 style="font-size: 1.25rem; color: #e6e8ec; margin: 0; font-weight: 500; letter-spacing: -0.2px;">Library</h1>
        </div>
        <div style="font-size: 0.75rem; color: #525866; font-family: monospace;">
            @songs.Count TRACKS
        </div>
    </div>

    <!-- BATCH QUEUE PROGRESS BAR -->
    @if (isLoading && totalQueueCount > 0)
    {
        <div style="background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255,255,255,0.05); border-radius: 4px; padding: 10px 14px; margin-bottom: 20px;">
            <div style="background: rgba(0, 0, 0, 0.4); border-radius: 2px; overflow: hidden; height: 3px; position: relative;">
                <div style="width: @(progressPercentage)%; background: #45a29e; height: 100%; transition: width 0.3s ease;"></div>
            </div>
            <div style="display: flex; justify-content: space-between; font-size: 0.7rem; color: #666c7a; margin-top: 8px; font-family: monospace;">
                <span>DOWNLOADING: @currentProcessedCount / @totalQueueCount</span>
                <span>@progressPercentage%</span>
            </div>
        </div>
    }

    <!-- TOOLBAR -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 12px;">
        
        <!-- Playback Actions -->
        <div style="display: flex; gap: 10px; align-items: center;">
            <button style="background: rgba(255,255,255,0.08); color: #e6e8ec; border: 1px solid rgba(255,255,255,0.1); border-radius: 4px; padding: 6px 14px; font-size: 0.75rem; cursor: pointer; display: flex; align-items: center; gap: 6px; transition: all 0.2s;" @onclick="PlayAll" title="Putar Semua">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg> Putar Semua
            </button>
            <button style="padding: 6px 12px; font-size: 0.75rem; background: transparent; border: 1px solid rgba(255,255,255,0.08); color: #8a8f98; border-radius: 4px; cursor: pointer;" @onclick="AddSelectedToQueue" disabled="@isLoading">
                + Antrean
            </button>
        </div>

        <!-- Management & Search -->
        <div style="display: flex; gap: 8px; align-items: center;">
            <input type="text"
                   @bind="searchQuery"
                   @bind:event="oninput"
                   placeholder="Cari lagu / artis..."
                   style="padding: 6px 12px; width: 200px; background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.08); color: #e6e8ec; border-radius: 4px; font-size: 0.75rem; outline: none;" />

            <button style="padding: 6px 12px; font-size: 0.75rem; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); color: #a0a5aa; border-radius: 4px; cursor: pointer;" @onclick="DownloadSelected" disabled="@isLoading">
                Unduh
            </button>
            <button style="padding: 6px 12px; font-size: 0.75rem; border-radius: 4px; background: transparent; border: 1px solid rgba(247, 37, 133, 0.2); color: #ff4d6d; cursor: pointer;" @onclick="DeleteSelected" disabled="@isLoading">
                Hapus
            </button>
        </div>
    </div>

    <!-- CLEAN & MINIMAL TABLE -->
    <div style="overflow-x: auto;">
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.8rem;">
            <thead>
                <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.05); color: #525866; font-size: 0.68rem; text-transform: uppercase; letter-spacing: 1px;">
                    <th style="padding: 10px 8px; width: 32px; text-align: center;">
                        <input type="checkbox" checked="@isSelectAllChecked" @onchange="ToggleSelectAll" style="cursor: pointer; opacity: 0.6;" />
                    </th>
                    <th style="padding: 10px 8px; width: 40px; text-align: center; font-family: monospace;">#</th>
                    <th style="padding: 10px 8px;">Judul</th>
                    <th style="padding: 10px 8px;">Artis</th>
                    <th style="padding: 10px 8px; text-align: right; padding-right: 12px;">Aksi</th>
                </tr>
            </thead>
            <tbody>
                @if (songs.Count == 0 && isLoading)
                {
                    <tr>
                        <td colspan="5" style="padding: 40px 16px; text-align: center; color: #525866; font-size: 0.8rem; font-family: monospace;">
                            MEMUAT DATA...
                        </td>
                    </tr>
                }
                else if (!FilteredSongs.Any())
                {
                    <tr>
                        <td colspan="5" style="padding: 40px 16px; text-align: center; color: #525866; font-size: 0.8rem;">
                            Tidak ada trek ditemukan.
                        </td>
                    </tr>
                }
                else
                {
                    int index = 1;
                    @foreach (var song in FilteredSongs)
                    {
                        var currentIndex = index++;
                        <tr @key="song.Id" style="border-bottom: 1px solid rgba(255, 255, 255, 0.02); transition: background 0.15s ease;" onmouseover="this.style.background='rgba(255,255,255,0.02)'" onmouseout="this.style.background='transparent'">
                            <td style="padding: 10px 8px; text-align: center;">
                                <input type="checkbox" checked="@song.IsSelected" @onchange="(e) => OnSongSelectChanged(song, e)" style="cursor: pointer; opacity: 0.6;" />
                            </td>
                            <td style="padding: 10px 8px; text-align: center; color: #525866; font-family: monospace; font-size: 0.75rem;">
                                @currentIndex.ToString("D2")
                            </td>
                            <td style="padding: 10px 8px; font-weight: 400; color: #d0d3d8; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 320px;">
                                @song.Title
                            </td>
                            <td style="padding: 10px 8px; color: #666c7a; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 220px;">
                                @song.Artist
                            </td>
                            <td style="padding: 10px 8px; text-align: right; white-space: nowrap;">
                                <button style="background: transparent; border: none; color: #8a8f98; cursor: pointer; padding: 4px 6px; margin-right: 4px; font-size: 0.75rem;" @onclick="() => PlaySong(song)" title="Putar">
                                    ▶
                                </button>
                                <button style="background: transparent; border: none; color: #666c7a; cursor: pointer; padding: 4px 6px; margin-right: 8px; font-size: 0.85rem;" @onclick="() => AddToQueue(song)" title="Tambah ke Antrean">
                                    +
                                </button>
                                <button style="background: transparent; border: none; color: #666c7a; padding: 4px 6px; font-size: 0.7rem; cursor: pointer; margin-right: 4px;" @onclick="() => DownloadSingle(song)" disabled="@isLoading" title="Unduh File">
                                    ↓
                                </button>
                                <button style="background: transparent; border: none; color: rgba(247, 37, 133, 0.5); padding: 4px 6px; font-size: 0.7rem; cursor: pointer;" @onclick="() => DeleteSingle(song.Id)" disabled="@isLoading" title="Hapus File">
                                    ✕
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</div>
