@page "/library"
@page "/"

<PageTitle>Library Vault - Hypen Music</PageTitle>

<div class="library-container">

    <!-- ALERT STATUS -->
    @if (!string.IsNullOrEmpty(statusMsg))
    {
        <div class="alert-box @(isError ? "error" : "success")">
            <p class="alert-text">@statusMsg</p>
        </div>
    }

    <!-- HEADER -->
    <div class="header-section">
        <div>
            <div class="subtitle">Personal Vault</div>
            <h1 class="main-title">Master Library</h1>
        </div>
        <div class="track-counter">
            @songs.Count TRACKS
        </div>
    </div>

    <!-- BATCH QUEUE PROGRESS BAR -->
    @if (isLoading && totalQueueCount > 0)
    {
        <div class="progress-wrapper">
            <div class="progress-bar-container">
                <div class="progress-bar-fill" style="width: @(progressPercentage)%;"></div>
            </div>
            <div class="progress-info">
                <span>PROCESSING QUEUE: @currentProcessedCount / @totalQueueCount</span>
                <span>@progressPercentage%</span>
            </div>
        </div>
    }

    <!-- TOOLBAR -->
    <div class="toolbar">
        <div class="action-group">
            <button class="btn-delete" 
                    @onclick="DeleteSelected" 
                    disabled="@(isLoading || !songs.Any(s => s.IsSelected))">
                ✕ HAPUS TERPILIH
            </button>
        </div>

        <div class="search-group">
            <!-- DROPDOWN SORTING -->
            <select value="@sortBy" @onchange="OnSortChanged" class="sort-select" disabled="@isLoading">
                <option value="title_asc">Judul (A ➔ Z)</option>
                <option value="title_desc">Judul (Z ➔ A)</option>
                <option value="artist_asc">Artis (A ➔ Z)</option>
                <option value="artist_desc">Artis (Z ➔ A)</option>
                <option value="date_asc">Terlama (Catatan Pertama)</option>
                <option value="date_desc">Terbaru (Catatan Terakhir)</option>
            </select>

            <input type="text"
                   value="@searchQuery"
                   @oninput="OnSearchInput"
                   placeholder="Cari judul / artis / album..."
                   class="search-input" />
            
            <button class="btn-refresh" 
                    @onclick="LoadLibrary" 
                    disabled="@isLoading">
                Refresh
            </button>
        </div>
    </div>

    <!-- TABEL DATA MASTER LIBRARY -->
    <div class="table-responsive">
        <table class="vault-table">
            <thead>
                <tr>
                    <th class="col-checkbox">
                        <input type="checkbox" checked="@isSelectAllChecked" @onchange="ToggleSelectAll" class="checkbox-input" />
                    </th>
                    <th class="col-cover">Cover</th>
                    <th class="col-status">Status</th>
                    <th>Judul</th>
                    <th>Artis</th>
                    <th>Album</th>
                    <th>Tahun</th>
                    <th>Negara</th>
                    <th>Durasi</th>
                    <th>YT ID</th>
                    <th>MBID</th>
                    <th>Audio Stream</th>
                    <th class="col-action">Aksi</th>
                </tr>
            </thead>
            <tbody>
                @if (songs.Count == 0 && isLoading)
                {
                    <tr>
                        <td colspan="13" class="table-empty">
                            MEMUAT DATA VAULT...
                        </td>
                    </tr>
                }
                else if (!PagedSongs.Any())
                {
                    <tr>
                        <td colspan="13" class="table-empty">
                            Tidak ada trek ditemukan.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var song in PagedSongs)
                    {
                        <tr @key="song.Id" class="data-row">
                            <td class="col-checkbox">
                                <input type="checkbox" checked="@song.IsSelected" @onchange="(e) => OnSongSelectChanged(song, e)" class="checkbox-input" />
                            </td>

                            <td class="col-cover">
                                @if (!string.IsNullOrWhiteSpace(song.AlbumCoverUrl))
                                {
                                    <img src="@song.AlbumCoverUrl" alt="Cover" class="cover-img" />
                                }
                                else
                                {
                                    <div class="cover-placeholder">N/A</div>
                                }
                            </td>

                            <td class="col-status">
                                @if (song.IsComplete)
                                {
                                    <span class="badge badge-complete">COMPLETE</span>
                                }
                                else
                                {
                                    <span class="badge badge-incomplete">INCOMPLETE</span>
                                }
                            </td>

                            <td class="cell-title">@song.Title</td>
                            <td class="cell-artist">@song.Artist</td>
                            <td class="cell-album">@(string.IsNullOrWhiteSpace(song.Album) ? "-" : song.Album)</td>
                            <td class="cell-mono">@(song.ReleaseYear.HasValue ? song.ReleaseYear.Value : "-")</td>
                            <td class="cell-country">@(string.IsNullOrWhiteSpace(song.Country) ? "-" : song.Country)</td>
                            <td class="cell-mono">@(song.DurationSeconds.HasValue ? TimeSpan.FromSeconds(song.DurationSeconds.Value).ToString(@"mm\:ss") : "-")</td>
                            <td class="cell-id">@(string.IsNullOrWhiteSpace(song.YoutubeVideoId) ? "-" : song.YoutubeVideoId)</td>
                            <td class="cell-id">@(string.IsNullOrWhiteSpace(song.MusicBrainzId) ? "-" : song.MusicBrainzId)</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(song.AudioUrl) || !string.IsNullOrWhiteSpace(song.YoutubeVideoId))
                                {
                                    <span class="stream-ready">READY</span>
                                }
                                else
                                {
                                    <span class="stream-empty">EMPTY</span>
                                }
                            </td>

                            <td class="col-action">
                                <button class="btn-icon-delete" @onclick="() => DeleteSingle(song.Id)" disabled="@isLoading" title="Hapus Lagu">
                                    ✕
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- PAGINATION CONTROL -->
    @if (TotalPages > 1)
    {
        <div class="pagination-wrapper">
            <button class="btn-page" @onclick="() => GoToPage(1)" disabled="@(currentPage == 1)" title="Awal List">«</button>
            <button class="btn-page" @onclick="() => GoToPage(currentPage - 1)" disabled="@(currentPage == 1)" title="Sebelumnya">‹</button>

            @for (int i = 1; i <= TotalPages; i++)
            {
                var pageNumber = i;
                <button class="btn-page @(currentPage == pageNumber ? "active" : "")" @onclick="() => GoToPage(pageNumber)">
                    @pageNumber
                </button>
            }

            <button class="btn-page" @onclick="() => GoToPage(currentPage + 1)" disabled="@(currentPage == TotalPages)" title="Selanjutnya">›</button>
            <button class="btn-page" @onclick="() => GoToPage(TotalPages)" disabled="@(currentPage == TotalPages)" title="Akhir List">»</button>
        </div>
    }

</div>
