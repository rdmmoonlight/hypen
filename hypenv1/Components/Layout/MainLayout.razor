@inherits LayoutComponentBase
@using Hypen.Web.Components

<div class="page-layout">
    <!-- Sidebar Utama dengan Event Listener -->
    <Sidebar OnToggle="HandleSidebarToggle" />

    <!-- Area Konten Utama Halaman (/library atau /downloader) -->
    <main class="main-content @(isSidebarExpanded ? "expanded" : "collapsed")">
        @Body
    </main>
</div>

@code {
    private bool isSidebarExpanded = true;

    private void HandleSidebarToggle(bool isExpanded)
    {
        isSidebarExpanded = isExpanded;
    }
}

<style>
    .page-layout {
        display: flex;
        min-height: 100vh;
        background: #0b0c10;
        color: #c5c6c7;
    }

    .main-content {
        flex-grow: 1;
        padding: 16px;
        overflow-x: auto;
        
        /* TRANSISI PERGERAKAN MARGIN HALUS */
        transition: margin-left 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* LEBAR MARGIN KONTEN MENYESUAIKAN STATE SIDEBAR */
    .main-content.expanded {
        margin-left: 240px; /* Ikut lebar sidebar saat terbuka */
    }

    .main-content.collapsed {
        margin-left: 76px;  /* Ikut lebar sidebar saat diciutkan */
    }
</style>
