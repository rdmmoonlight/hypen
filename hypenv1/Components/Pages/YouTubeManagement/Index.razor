@page "/youtubemanagement"
@namespace Hypen.Web.Components.Pages.YouTubeManagement

<PageTitle>YouTube Auto-Detect Sync - Hypen</PageTitle>

<div class="yt-sync-container">
    <div class="yt-sync-header">
        <h2 class="yt-sync-title">YouTube Auto-Detect Sync</h2>
        <p class="yt-sync-subtitle">Pilih playlist sumber dari akun Anda, inspeksi isi video, dan centang lagu yang dimasukkan ke Staging.</p>
    </div>

    @if (!string.IsNullOrEmpty(StatusMessage))
    {
        <div class="yt-status-alert @(IsError ? "yt-status-error" : "yt-status-success")">
            <i class="yt-status-icon ti @(IsError ? "ti-alert-triangle" : "ti-info-circle")"></i>
            <span class="yt-status-text">@StatusMessage</span>
        </div>
    }

    <!-- STEP 1: PLAYLIST SELECTION & METRICS -->
    <div class="yt-sync-grid">
        <!-- Playlist Picker Card -->
        <div class="yt-card">
            <div class="yt-card-header d-flex justify-content-between align-items-center">
                <h3>1. Pilih Playlist Sumber</h3>
                <button class="yt-btn yt-btn-matte btn-sm" @onclick="LoadUserPlaylistsAsync" disabled="@IsLoadingPlaylists" title="Refresh Daftar Playlist">
                    <i class="ti ti-refresh"></i>
                </button>
            </div>
            <div class="yt-card-body">
                @if (IsLoadingPlaylists)
                {
                    <div class="d-flex align-items-center gap-2 py-3">
                        <span class="yt-spinner"></span>
                        <span>Memuat daftar playlist akun...</span>
                    </div>
                }
                else
                {
                    <div class="yt-playlist-list">
                        @foreach (var pl in UserPlaylists)
                        {
                            bool isSelected = SelectedPlaylist?.Id == pl.Id;
                            <div class="yt-playlist-item @(isSelected ? "active" : "")" @onclick="() => SelectPlaylist(pl)">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="ti ti-playlist text-primary fs-5"></i>
                                    <div>
                                        <strong>@pl.Title</strong>
                                        <div class="text-muted small" style="font-size: 0.68rem;">ID: @pl.Id</div>
                                    </div>
                                </div>
                                <i class="ti @(isSelected ? "ti-circle-check-filled text-primary" : "ti-circle") fs-5"></i>
                            </div>
                        }
                    </div>

                    <div class="mt-3">
                        <button class="yt-btn yt-btn-primary" 
                                @onclick="InspectSelectedPlaylistAsync" 
                                disabled="@(SelectedPlaylist == null || IsInspectingVideo)">
                            @if (IsInspectingVideo)
                            {
                                <span class="yt-spinner"></span>
                                <span>Menginspeksi Video...</span>
                            }
                            else
                            {
                                <i class="ti ti-search"></i>
                                <span>Inspeksi Playlist Terpilih</span>
                            }
                        </button>
                    </div>
                }
            </div>
        </div>

        <!-- System Status & Metrics -->
        <div class="yt-card">
            <div class="yt-card-header">
                <h3>Informasi Sinkronisasi</h3>
            </div>
            <div class="yt-card-body">
                <div class="yt-metrics-container">
                    <div class="yt-metric-box">
                        <span class="yt-metric-value">@PendingRawCount</span>
                        <span class="yt-metric-label">Pending Staging</span>
                    </div>
                    <div class="yt-metric-box">
                        <span class="yt-metric-value">@CompletedSongsCount</span>
                        <span class="yt-metric-label">Completed Library</span>
                    </div>
                </div>

                <div class="yt-info-row mt-3 pt-2 border-top">
                    <span class="yt-info-label"><i class="ti ti-playlist"></i> Target Playlist:</span>
                    <strong class="yt-info-value">@(SelectedPlaylist?.Title ?? "Belum dipilih")</strong>
                </div>

                <div class="yt-info-row">
                    <span class="yt-info-label"><i class="ti ti-clock"></i> Sync Terakhir:</span>
                    <strong class="yt-info-value">
                        @(SelectedPlaylistLastSync.HasValue 
                            ? SelectedPlaylistLastSync.Value.ToString("dd MMM yyyy HH:mm:ss") 
                            : "Belum Pernah Sync (Tarik Semua)")
                    </strong>
                </div>
            </div>
        </div>
    </div>

    <!-- STEP 2: VIDEO INSPECTION & BATCH SELECTION TABLE -->
    @if (FetchedVideos.Count > 0)
    {
        <div class="yt-card yt-preview-table-card mt-4">
            <div class="yt-card-header yt-table-header-flex">
                <div>
                    <h3>2. Hasil Inspeksi (@FetchedVideos.Count Video Ditemukan)</h3>
                    <small class="text-muted">Centang video lagu yang valid sebelum dimasukkan ke database Staging</small>
                </div>
                <button class="yt-btn yt-btn-success" @onclick="SaveSelectedToStagingAsync" disabled="@(SelectedVideoIds.Count == 0 || IsSaving)">
                    @if (IsSaving)
                    {
                        <span class="yt-spinner"></span>
                        <span>Menyimpan...</span>
                    }
                    else
                    {
                        <i class="ti ti-download"></i>
                        <span>Simpan (@SelectedVideoIds.Count) ke Staging</span>
                    }
                </button>
            </div>
            <div class="yt-card-body p-0">
                <table class="yt-table">
                    <thead>
                        <tr>
                            <th style="width: 40px; text-align: center;">
                                <input type="checkbox" checked="@IsAllPageSelected" @onchange="ToggleSelectAllPage" />
                            </th>
                            <th style="width: 120px;">Thumbnail</th>
                            <th>Judul Video</th>
                            <th>Channel</th>
                            <th style="width: 100px; text-align: center;">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in PagedVideos)
                        {
                            bool isSelected = SelectedVideoIds.Contains(item.VideoId);
                            <tr class="@(isSelected ? "yt-row-selected" : "")">
                                <td style="text-align: center;">
                                    <input type="checkbox" checked="@isSelected" @onchange="@((e) => ToggleSelect(item.VideoId, e))" />
                                </td>
                                <td>
                                    <img src="https://img.youtube.com/vi/@item.VideoId/default.jpg" alt="thumbnail" class="yt-thumb" />
                                </td>
                                <td>
                                    <strong class="yt-video-title">@item.Title</strong>
                                </td>
                                <td>
                                    <span class="yt-channel-name">@item.ChannelTitle</span>
                                </td>
                                <td style="text-align: center;">
                                    <a href="https://www.youtube.com/watch?v=@item.VideoId" target="_blank" class="yt-link-btn" title="Tonton di YouTube">
                                        <i class="ti ti-player-play"></i> Play
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination Bar -->
            @if (TotalPages > 1)
            {
                <div class="yt-pagination">
                    <button class="yt-page-btn" disabled="@(CurrentPage == 1)" @onclick="() => GoToPage(CurrentPage - 1)">
                        <i class="ti ti-chevron-left"></i> Prev
                    </button>
                    <span class="yt-page-info">Halaman @CurrentPage dari @TotalPages (Per halaman: @PageSize)</span>
                    <button class="yt-page-btn" disabled="@(CurrentPage == TotalPages)" @onclick="() => GoToPage(CurrentPage + 1)">
                        Next <i class="ti ti-chevron-right"></i>
                    </button>
                </div>
            }
        </div>
    }
</div>
